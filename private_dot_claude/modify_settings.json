{{- /* chezmoi:modify-template */ -}}
{{- $stdin := index .chezmoi "stdin" | default "" | trim -}}
{{- $merged := dict -}}
{{- if $stdin -}}
{{-   $merged = fromJson $stdin -}}
{{- end -}}
{{- $d := includeTemplate "agent-derived.json.tmpl" . | fromJson -}}

{{- $livePlugins := dict -}}
{{- if eq (kindOf $merged) "map" -}}
{{-   $liveEnabledPlugins := index $merged "enabledPlugins" -}}
{{-   if eq (kindOf $liveEnabledPlugins) "map" -}}
{{-     $livePlugins = $liveEnabledPlugins -}}
{{-   end -}}
{{- end -}}

{{- $merged = setValueAtPath "cleanupPeriodDays" 365 $merged -}}
{{- $merged = setValueAtPath "autoUpdatesChannel" "stable" $merged -}}
{{- $merged = setValueAtPath "remoteControlAtStartup" true $merged -}}
{{- $merged = setValueAtPath "syncClaudeAiSkills" true $merged -}}
{{- $merged = setValueAtPath "spinnerTipsEnabled" false $merged -}}
{{- $merged = setValueAtPath "effortLevel" "xhigh" $merged -}}
{{- $merged = setValueAtPath "env.CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS" "1" $merged -}}
{{- $merged = setValueAtPath "env.CLAUDE_CODE_DISABLE_FEEDBACK_SURVEY" "1" $merged -}}
{{- $merged = setValueAtPath "env.DISABLE_ERROR_REPORTING" "1" $merged -}}
{{- $merged = setValueAtPath "env.DISABLE_NON_ESSENTIAL_MODEL_CALLS" "1" $merged -}}
{{- $_ := unset (index $merged "env") "DISABLE_TELEMETRY" -}}
{{- $merged = setValueAtPath "env.CLAUDE_CODE_AUTO_COMPACT_WINDOW" "600000" $merged -}}
{{- $merged = setValueAtPath "attribution.commit" "" $merged -}}
{{- $merged = setValueAtPath "attribution.pr" "" $merged -}}

{{- $permissions := dict
    "allow" (list
      "Read"
      "Grep"
      "Glob"
      "WebFetch"
      "WebSearch"
      "Bash(find *)"
      "Bash(cat *)"
      "Bash(ls *)"
      "Bash(head *)"
      "Bash(tail *)"
      "Bash(wc *)"
      "Bash(grep *)"
      "Bash(tree *)")
    "deny" (list
      "Read(.env)"
      "Read(.env.*)"
      "Read(secrets/**)"
      "Read(credentials.json)"
      "Read(~/.config/retell/credentials.json)"
      "Read(~/.config/agents/broccoli-tech-support/.mcp.json)"
      "Read(~/.config/agents/broccoli-engineering/.mcp.json)"
      "Read(~/.broccoli-skills.env)"
      "Read(~/.aws/credentials)"
      "Read(~/.ssh/id_*)"
      "Read(~/.ssh/*_rsa)"
      "Read(~/.ssh/*_ed25519)"
      "Read(~/.claude/.credentials.json)"
      "Read(~/.codex/auth.json)"
      "Read(~/.config/osquery/webhook-secret)"
      "Read(~/.hermes/.env)"
      "Read(~/**/*.kdbx)"
      "Read(~/.config/chezmoi/key.txt)"
      "Read(~/.hermes/config.yaml)"
      "Read(~/.hermes/profiles/*/config.yaml)"
      "Read(~/.config/pns/config.toml)"
      "Read(~/.config/posture/config.toml)"
      "Read(~/.config/uu/config.toml)"
      "Read(~/.config/lights/config.toml)"
      "Read(~/.config/atuin/config.toml)"
      "Read(~/.config/himalaya/config.toml)"
      "Read(~/.config/openhue/config.yaml)"
      "Read(~/.config/gogcli/credentials.json)"
      "Read(~/Library/Application Support/Claude/claude_desktop_config.json)"
      "Read(~/Library/Application Support/espanso/match/identity.yml)")
    "ask" (list)
    "defaultMode" "bypassPermissions" -}}
{{- $workAsked := list -}}
{{- range $key := list "tech_support" "engineering" -}}
{{-   $plugin := printf "broccoli-%s" (replace "_" "-" $key) -}}
{{-   range $server, $settings := (index $.broccoli $key).mcp_servers -}}
{{-     range get $settings "ask" | default list -}}
{{-       $workAsked = concat $workAsked (list (printf "mcp__%s__%s" $server .) (printf "mcp__plugin_%s_%s__%s" $plugin $server .)) -}}
{{-     end -}}
{{-   end -}}
{{- end -}}
{{- $permissions = set $permissions "ask" (concat (get $permissions "ask") $workAsked) -}}
{{- $merged = setValueAtPath "permissions" $permissions $merged -}}

{{- $home := .chezmoi.homeDir -}}
{{- $pns := joinPath $home ".cargo/bin" "pns" -}}
{{- $hooks := dict
    "UserPromptSubmit" (list (dict
      "hooks" (list (dict
        "type" "command"
        "command" (printf "%s hook prompt" $pns)))))
    "Stop" (list (dict
      "hooks" (list (dict
        "type" "command"
        "async" true
        "command" (printf "%s hook stop" $pns)))))
    "PostModelSwitch" (list (dict
      "hooks" (list (dict
        "type" "command"
        "async" true
        "command" (printf "%s hook model-switch >/dev/null" $pns)))))
    "StopFailure" (list (dict
      "hooks" (list (dict
        "type" "command"
        "async" true
        "command" (printf "%s hook stop-failure" $pns)))))
    "Notification" (list
      (dict
        "matcher" "quota_auto_resume_fired|quota_auto_resume_stale|quota_auto_resume_disabled"
        "hooks" (list (dict
          "type" "command"
          "async" true
          "command" (printf "%s hook quota" $pns))))
      (dict
        "matcher" "permission_prompt"
        "hooks" (list (dict
          "type" "command"
          "async" true
          "command" (printf "%s hook waiting" $pns)))))
    "PermissionRequest" (list (dict
      "hooks" (list (dict
        "type" "command"
        "command" (printf "%s hook blocked --remind" $pns)))))
    "PermissionDenied" (list (dict
      "hooks" (list (dict
        "type" "command"
        "async" true
        "command" (printf "%s hook denied" $pns)))))
    "Elicitation" (list (dict
      "hooks" (list (dict
        "type" "command"
        "async" true
        "command" (printf "%s hook asked" $pns)))))
    "PostToolBatch" (list (dict
      "hooks" (list (dict
        "type" "command"
        "async" true
        "command" (printf "%s hook resolved" $pns)))))
    "PostToolUse" (list
      (dict
        "matcher" "AskUserQuestion"
        "hooks" (list (dict
          "type" "command"
          "async" true
          "command" (printf "%s hook resolved" $pns))))
      (dict
        "matcher" "ExitPlanMode"
        "hooks" (list (dict
          "type" "command"
          "async" true
          "command" (printf "%s hook resolved" $pns)))))
    "ElicitationResult" (list (dict
      "hooks" (list (dict
        "type" "command"
        "async" true
        "command" (printf "%s hook resolved" $pns)))))
    "SubagentStop" (list (dict
      "hooks" (list (dict
        "type" "command"
        "async" true
        "command" (printf "%s hook resolved" $pns)))))
    "SessionEnd" (list (dict
      "hooks" (list (dict
        "type" "command"
        "command" (printf "%s hook session-end" $pns)))))
    "SessionStart" (list (dict
      "hooks" (list (dict
        "type" "command"
        "command" "/bin/sh -c 'rex __internal session-start --agent claude --feature-session-naming=false 2>/dev/null || true'"
        "timeout" 5)))) -}}
{{- $merged = setValueAtPath "hooks" $hooks $merged -}}

{{- $statusLine := dict
    "type" "command"
    "command" (printf "bash %s/.claude/statusline-command.sh" $home) -}}
{{- $merged = setValueAtPath "statusLine" $statusLine $merged -}}

{{- $enabledPlugins := dict -}}
{{- range $pluginId := $d.claude.plugins -}}
{{-   $pluginEnabled := true -}}
{{-   $liveValue := index $livePlugins $pluginId -}}
{{-   $liveValueKind := kindOf $liveValue -}}
{{-   if or (eq $liveValueKind "bool") (eq $liveValueKind "slice") -}}
{{-     $pluginEnabled = $liveValue -}}
{{-   end -}}
{{-   $enabledPlugins = set $enabledPlugins $pluginId $pluginEnabled -}}
{{- end -}}
{{- $merged = setValueAtPath "enabledPlugins" $enabledPlugins $merged -}}

{{- range $marketplace := $d.claude.marketplaces -}}
{{-   if $marketplace.in_settings -}}
{{-     $entry := dict "source" (dict "source" "github" "repo" $marketplace.repo) "autoUpdate" true -}}
{{-     $merged = setValueAtPath (list "extraKnownMarketplaces" $marketplace.name) $entry $merged -}}
{{-   end -}}
{{- end -}}

{{- range $skill := $d.on_demand_claude -}}
{{-   $merged = setValueAtPath (list "skillOverrides" $skill) "user-invocable-only" $merged -}}
{{- end -}}
{{- range $skill := $d.media_names -}}
{{-   $merged = deleteValueAtPath (printf "skillOverrides.%s" $skill) $merged -}}
{{- end -}}

{{ $merged | toPrettyJson }}
