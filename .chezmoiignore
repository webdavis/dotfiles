# Ignore GitHub/repo metadata:
README.md
LICENSE
CLAUDE.md
AGENTS.md
.gitignore
.gitattributes
assets/
docs/
private/

# Repo scripts & helpers:
justfile
.envrc
scripts/
test/

# Neovim config: repo metadata and test code never reach $HOME.
.config/nvim/README.md
.config/nvim/docs/
.config/nvim/tests/

# Ignore formatter/linter configs:
.shellcheckrc
.editorconfig # shfmt uses EditorConfig as its rc file (so to speak).
.mdformat.toml

# Git hooks (dev-only):
.githooks/

# Knowledge-graph output (the committed map + regenerated artifacts) is repo
# metadata, never target state.
graphify-out/

# Lint orchestrator config (dev/CI only, must never deploy to $HOME):
treefmt.toml

# Failsafe so that stray tmp files in the source tree don't get applied to HOME.
tmp.*
*.rayconfig
*extension-diagnostics*

# macOS Finder turds (e.g. Library/Application Support/.DS_Store).
**/.DS_Store

# Skill repos bring their own .git/ and node_modules/;
# don't track those in this dotfiles repo.
.agents/skills/*/.git
.agents/skills/*/.git/**
.agents/skills/*/node_modules
.agents/skills/*/node_modules/**

# Rust build artifacts for vendored herdr projects (rebuilt in-place at apply; never deploy).
.local/share/herdr/**/target

# Same, for the pns crate.
.local/share/pns/target

# The pns specifications, decision records and test baseline: development
# artifacts for people working ON pns, never runtime inputs the binary reads.
# They live in the crate so they travel when pns is extracted to its own
# repository, which is about the git repo and not about what reaches $HOME.
.local/share/pns/docs

# Same, for the uu crate.
.local/share/uu/target

# neotest-bashunit's own headless specs and their runner: development artifacts
# for people working ON the adapter, the same rule .config/nvim/tests/ follows.
# `just test-neotest-bashunit` runs them from the source tree.
.local/share/neotest-bashunit/tests

# The committed input to `just pns-config-render`, never a deploy target:
# the shipped template it generates is what chezmoi applies.
.config/pns/config-values.toml

{{- if eq .chezmoi.os "linux" }}
Library
.local/libexec/macos-defaults/macos-defaults-drift.sh
.local/libexec/macos-defaults/macos-defaults-apply.sh
.local/libexec/macos-defaults/macos-defaults-capture.sh
.local/libexec/macos-defaults/helpers/defaults-records.sh
# Rotation is driven by a launchd agent and reads sizes with BSD `stat -f`.
.local/libexec/compress-and-truncate-local-logs.sh
.local/libexec/brew-shellenv-cache-refresh.sh
# The pns notification stack is macOS-only: the builder is darwin-gated, the
# banner needs macOS, and shipping binary callers with no binary would leave
# a Linux machine permanently engine-less.
.local/libexec/pns
.local/share/pns
.config/pns
# And so is the /pns: plugin, which is nothing but commands for that engine.
.claude/pns-marketplace
# The /strategy: plugin is macOS-only for a different reason: it is a second
# DIRECTORY marketplace, and a marketplace whose path is absent fails its
# refresh at every startup, so the declaration in modify_settings.json is
# darwin-gated and this has to agree with it.
.claude/strategy-marketplace
# uu rides on the pns engine for alerts and on its hermes client for records,
# so it is macOS-only for the same reasons and its builder is darwin-gated too.
.local/libexec/uu
.local/share/uu
.config/uu
{{- end }}
