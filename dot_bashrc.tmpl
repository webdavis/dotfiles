# shellcheck shell=bash
# vi:filetype=sh shiftwidth=2 softtabstop=2 tabstop=8:

# Prints a timestamped trace of startup to stderr when BASHRC_PROFILE is set.
[[ -n ${BASHRC_PROFILE:-} ]] && {
  PS4='+ $EPOCHREALTIME '
  set -x
}

function path_prepend() {
  local dir="$1"

  if [[ -d $dir ]]; then
    PATH="$dir:$PATH"
  else
    echo "Directory $dir does not exist." >&2
    return 1
  fi
}

# Everything from here to the interactive guard also runs for `bash -lc` and `ssh host cmd`, so keep it cheap.
EDITOR="$(which nvim)" && export EDITOR
export BASH_SILENCE_DEPRECATION_WARNING=1
export MANPAGER="nvim +Man!"
export COLORTERM=truecolor
export XDG_DATA_HOME="$HOME/.local/share"
export XDG_CONFIG_HOME="$HOME/.config"
export LC_ALL=en_US.UTF-8
export LANG=en_US.UTF-8
export USER="${USER:-$(whoami)}"

# Turns off OpenSpec telemetry even before its own config file exists.
export OPENSPEC_TELEMETRY=0

# gnhf has no config-file opt-out.
export GNHF_TELEMETRY=0

# Selects the temporal.toml profile so `temporal` needs no --profile.
export TEMPORAL_PROFILE=broccoli

# Forces `retell` to read ~/.config/retell/credentials.json instead of pulling credentials from the Keychain.
export RETELL_DISABLE_KEYRING=1
{{ if eq .chezmoi.os "darwin" -}}
# Sets the host name the Markdown preview advertises. Non-interactive nvim launches need it too.
export NVIM_MKDP_HOST=home.webdavis.io
{{- end }}

HOMEBREW_PREFIX='/opt/homebrew'

# A cached `brew shellenv` is much faster than the live eval, which covers a missing cache.
# Only interactive shells rebuild the cache, so a headless host runs `just brew-cache-refresh` once.
__brew_shellenv="${XDG_CACHE_HOME:-$HOME/.cache}/brew-shellenv.sh"
# A directory or unreadable file would make `.` print an error on every start.
if [[ -f $__brew_shellenv && -r $__brew_shellenv && -s $__brew_shellenv ]]; then
  . "$__brew_shellenv"
else
  eval "$("${HOMEBREW_PREFIX}/bin/brew" shellenv 2>/dev/null)"
fi
unset __brew_shellenv

export SHELL="${HOMEBREW_PREFIX}/bin/bash"

export MANPATH="${HOMEBREW_PREFIX}/share/man:${MANPATH}"

path_prepend "${HOMEBREW_PREFIX}/opt/curl/bin"

path_prepend "${HOMEBREW_PREFIX}/opt/trash-cli/bin/"

path_prepend "${HOMEBREW_PREFIX}/opt/gnu-getopt/bin/"

# Faster than sourcing ~/.cargo/env.
[[ -d "$HOME/.cargo/bin" ]] && path_prepend "$HOME/.cargo/bin"

# aliases/default follows `fnm default`, so node tools resolve in every shell, ahead of Homebrew.
path_prepend "$HOME/.local/share/fnm/aliases/default/bin"

nix_daemon='/nix/var/nix/profiles/default/etc/profile.d/nix-daemon.sh'
[[ -e $nix_daemon ]] && . "$nix_daemon"

# Outside the interactive guard so `bash -lc` can call these functions.
[[ -s "$HOME/.bash_functions" ]] && . "$HOME/.bash_functions"

# Local tools take precedence over everything else.
path_prepend "$HOME/.local/bin"

# Must follow every path_prepend above.
export PATH

# Interactive-only setup, the costly part of startup. bash-preexec loads before atuin,
# and the PROMPT_COMMAND writers load in the order direnv, starship, zoxide, atuin.
if [[ $- == *i* ]]; then
  # himalaya's Homebrew completion file is broken and errors in every new shell.
  # bash-completion reads this variable as it loads, so it is set first.
  export BASH_COMPLETION_COMPAT_IGNORE='himalaya'
  bash_completion="${HOMEBREW_PREFIX}/opt/bash-completion@2/etc/profile.d/bash_completion.sh"
  [[ -r $bash_completion ]] && . "$bash_completion"

  # atuin and the command notifier need bash-preexec's hook arrays.
  bash_preexec="${HOMEBREW_PREFIX}/etc/profile.d/bash-preexec.sh"
  [[ -r $bash_preexec ]] && . "$bash_preexec"

  # Writes PROMPT_COMMAND, so it loads before starship.
  eval "$(direnv hook bash)"

  command -v fnm &>/dev/null && eval "$(fnm env --use-on-cd --shell bash)"

  # Carapace ignores readline's completion-ignore-case, so this turns on its own case-insensitive matching.
  export CARAPACE_MATCH=1
  command -v carapace &>/dev/null && source <(carapace _carapace bash) 2>/dev/null

  # Remote sessions get the plain ASCII prompt.
  if [[ -n ${MOSH_KEY:-} || -n ${SSH_CONNECTION:-} ]]; then
    export STARSHIP_CONFIG="$HOME/.config/starship-mosh.toml"
  fi
  eval "$(starship init bash)"

  alias j='just'
  # carapace has a spec for `just`, not `j`, so the completion line is rewritten to `just` first.
  if declare -F _carapace_completer &>/dev/null; then
    _j_carapace_complete() {
      COMP_WORDS[0]=just
      COMP_LINE="just${COMP_LINE#j}"
      ((COMP_POINT += 3))
      _carapace_completer
    }
    complete -F _j_carapace_complete j
  fi

  # The `wt` function lets `wt switch` change this shell's directory.
  eval "$(wt config shell init bash)"

  [[ -s "$HOME/.bash_aliases" ]] && . "$HOME/.bash_aliases"

  # Frees Ctrl-S and Ctrl-Q from terminal flow control.
  stty -ixon

  # The functions and helper macros load before the generated bindings that call them.
  [[ -s "$HOME/.bash_bindings_functions" ]] && . "$HOME/.bash_bindings_functions"
  [[ -s "$HOME/.bash_bindings" ]] && . "$HOME/.bash_bindings"
  [[ -s "$HOME/.fzf_bindings" ]] && . "$HOME/.fzf_bindings"

  # Loads after the other PROMPT_COMMAND writers except atuin.
  eval "$(zoxide init bash)"

  # Loads last of the PROMPT_COMMAND writers.
  eval "$(atuin init bash --disable-up-arrow)"

  {{ if eq .chezmoi.os "darwin" -}}
  # Rebuilds the brew shellenv cache in the background when it is unusable, stale, or its
  # etc/paths file is unreadable. A rebuild cannot always restore etc/paths, so attempts run
  # at most once an hour.
  __brew_shellenv_cache="${XDG_CACHE_HOME:-$HOME/.cache}/brew-shellenv.sh"
  __brew_shellenv_generator="${HOMEBREW_REPOSITORY:-/opt/homebrew/Homebrew}/Library/Homebrew/cmd/shellenv.sh"
  __brew_shellenv_paths_file="${HOMEBREW_PREFIX:-/opt/homebrew}/etc/paths"
  __brew_shellenv_writer="$HOME/.local/libexec/brew-shellenv-cache-refresh.sh"
  __brew_shellenv_log="${XDG_STATE_HOME:-$HOME/.local/state}/brew-shellenv/selfheal.log"
  __brew_shellenv_attempt_stamp="${XDG_STATE_HOME:-$HOME/.local/state}/brew-shellenv/selfheal.attempt"
  __brew_shellenv_retry_interval_seconds=3600

  # Stat tests only, since this runs in every interactive shell.
  __brew_shellenv_cache_needs_repair() {
    [[ -f $__brew_shellenv_cache && -r $__brew_shellenv_cache && -s $__brew_shellenv_cache ]] ||
      return 0
    [[ $__brew_shellenv_generator -nt $__brew_shellenv_cache ]] && return 0
    [[ ! -r $__brew_shellenv_paths_file ]]
  }

  __brew_shellenv_repair_is_due() {
    local last_attempt_epoch
    # Bash 3.2 has no EPOCHSECONDS, so the repair waits for `just brew-cache-refresh`.
    [[ -n ${EPOCHSECONDS:-} ]] || return 1
    [[ -f $__brew_shellenv_attempt_stamp && -r $__brew_shellenv_attempt_stamp ]] || return 0
    read -r last_attempt_epoch 2>/dev/null <"$__brew_shellenv_attempt_stamp" || return 0
    # A leading zero parses as octal and a long digit run overflows.
    [[ $last_attempt_epoch =~ ^(0|[1-9][0-9]{0,9})$ ]] || return 0
    # A stamp dated in the future, after a clock jump, re-arms the repair.
    ((last_attempt_epoch > EPOCHSECONDS)) && return 0
    ((EPOCHSECONDS - last_attempt_epoch >= __brew_shellenv_retry_interval_seconds))
  }

  # Launch only when the log folder and the stamp write succeed, so a failure stays silent
  # and the rate limit holds.
  if __brew_shellenv_cache_needs_repair &&
    [[ -f $__brew_shellenv_generator && -x $__brew_shellenv_writer ]] &&
    __brew_shellenv_repair_is_due &&
    mkdir -p "${__brew_shellenv_log%/*}" 2>/dev/null &&
    printf '%s\n' "$EPOCHSECONDS" 2>/dev/null >"$__brew_shellenv_attempt_stamp"; then
    ("$__brew_shellenv_writer" >>"$__brew_shellenv_log" 2>&1 &)
  fi
  unset __brew_shellenv_cache __brew_shellenv_generator __brew_shellenv_paths_file
  unset __brew_shellenv_writer __brew_shellenv_log __brew_shellenv_attempt_stamp
  unset __brew_shellenv_retry_interval_seconds
  unset -f __brew_shellenv_cache_needs_repair __brew_shellenv_repair_is_due
  {{- end }}

  {{- if eq .chezmoi.os "darwin" }}
  # bash-preexec keeps atuin's hooks intact, where a bare DEBUG trap would replace them.
  # PS0 starts the timer because bash-preexec skips preexec for a session's first command.
  # The subscript assigns the start time and prints nothing.
  __cmd_notify_start=""
  __cmd_notify_name=""
  # Single quotes make bash expand this at each prompt rather than here.
  # shellcheck disable=SC2016,SC2034
  PS0='${__cmd_notify_ps0[__cmd_notify_start=SECONDS]}'
  # pns owns the skip list, tiers and per-shell marker.
  __cmd_notify_preexec() {
    __cmd_notify_name="$1"
    "$HOME/.cargo/bin/pns" shell begin --pid "$$" --command "$1" >/dev/null 2>&1
    # A failing preexec cancels the typed command under extdebug.
    return 0
  }

  # Exit cleans up this shell only; pns sweeps shells killed by SIGKILL.
  trap '"$HOME/.cargo/bin/pns" shell end --pid "$$" --command "" --exit-code 0 --elapsed 0s >/dev/null 2>&1' EXIT

  __cmd_notify_precmd() {
    local exit_code=$?
    [[ -z $__cmd_notify_start ]] && return
    local elapsed=$((SECONDS - __cmd_notify_start))
    __cmd_notify_start=""
    # bash-preexec skips the first command, so its name comes from history.
    [[ -z $__cmd_notify_name ]] && __cmd_notify_name="$(fc -ln -0 2>/dev/null | sed 's/^[[:space:]]*//')"
    "$HOME/.cargo/bin/pns" shell end --pid "$$" --command "$__cmd_notify_name" \
      --exit-code "$exit_code" --elapsed "${elapsed}s" >/dev/null 2>&1
    return 0
  }

  # shellcheck disable=SC2034  # bash-preexec reads these arrays.
  preexec_functions+=(__cmd_notify_preexec)
  # shellcheck disable=SC2034
  precmd_functions+=(__cmd_notify_precmd)
  {{- end }}
fi

case $- in
  *i*) ;;
  *) return ;;
esac

command -v herdr &>/dev/null || return
[[ -n ${HERDR_ENV:-} ]] && return

[[ -n ${SSH_ORIGINAL_COMMAND:-} ]] && return

# Set by VS Code Remote SSH.
[[ -n ${VSCODE_INJECTION:-} ]] && return

[[ ${TERM_PROGRAM:-} == "vscode" ]] && return

# Attaches to the persistent herdr session, starting the server when needed.
herdr
