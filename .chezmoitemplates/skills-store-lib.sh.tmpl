# shellcheck shell=bash

readonly skills_store="$HOME/.agents/skills"
readonly skills_folder_lock="$HOME/.agents/.skills-folder.lock"
readonly lock_is_busy_status=75
readonly codex_original_marker='# uu-original-openai: '

skills_folder_lock_is_held() {
  [[ ${AGENT_SKILLS_FOLDER_LOCK_HELD:-} == yes ]]
}

run_holding_skills_folder_lock() {
  local status=0
  mkdir -p "$(dirname "$skills_folder_lock")"
  AGENT_SKILLS_FOLDER_LOCK_HELD=yes lockf -k -s -t 0 "$skills_folder_lock" "$BASH" "$0" "$@" || status=$?
  if ((status == lock_is_busy_status)); then
    printf 'error[busy]: another script holds %s; try later.\n' "$skills_folder_lock" >&2
  fi
  exit "$status"
}

skill_is_installed() {
  local skill=$1
  [[ -d $skills_store/$skill ]]
}

codex_file_of() {
  local skill=$1
  printf '%s/%s/agents/openai.yaml' "$skills_store" "$skill"
}

codex_file_is_marked_on_demand() {
  local codex_file=$1
  [[ -f $codex_file && $(tail -n 1 "$codex_file") == "$codex_original_marker"* ]]
}

original_codex_file_as_json() {
  local codex_file=$1
  if [[ -f $codex_file ]]; then
    jq -Rs . <"$codex_file"
  else
    printf 'null'
  fi
}

codex_file_with_implicit_invocation_off() {
  local codex_file=$1
  if [[ -f $codex_file ]]; then
    yq '.policy.allow_implicit_invocation = false' "$codex_file"
  else
    yq -n '.policy.allow_implicit_invocation = false'
  fi
}

mark_codex_file_on_demand() {
  local skill=$1
  local codex_file original merged
  codex_file="$(codex_file_of "$skill")"
  if ! skill_is_installed "$skill" || codex_file_is_marked_on_demand "$codex_file"; then
    return 0
  fi
  original="$(original_codex_file_as_json "$codex_file")" || return 1
  merged="$(codex_file_with_implicit_invocation_off "$codex_file")" || return 1
  mkdir -p "$(dirname "$codex_file")" || return 1
  printf '%s\n%s%s\n' "$merged" "$codex_original_marker" "$original" >"$codex_file"
}
