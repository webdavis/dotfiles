# A no-op apply prints nothing, so call report_section only when there is something to say.
# Color stays on through a pipe because applies are read live; REPORT_LIB_PLAIN=1 turns it off.
#
# shellcheck shell=bash

report_section() {
  local tool="$1" context="${2:-}"
  printf '\n'
  if [[ ${REPORT_LIB_PLAIN:-} == 1 || -n ${NO_COLOR:-} ]]; then
    if [[ -n $context ]]; then
      printf '%s ── %s\n' "$tool" "$context"
    else
      printf '%s\n' "$tool"
    fi
    return 0
  fi
  if [[ -n $context ]]; then
    printf '\033[1;38;5;212m%s\033[0m\033[2m ── %s\033[0m\n' "$tool" "$context"
  else
    printf '\033[1;38;5;212m%s\033[0m\n' "$tool"
  fi
}

report_line() {
  printf '%s\n' "$*"
}
