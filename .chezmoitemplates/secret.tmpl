{{- $name := index . 0 -}}
{{- $field := index . 1 -}}
{{- $secrets := (include ".chezmoidata/secrets.yaml" | fromYaml).secrets -}}
{{- if not (hasKey $secrets $name) -}}
{{-   fail (printf "secrets.yaml lists no entry named %q" $name) -}}
{{- end -}}
{{- $entry := index $secrets $name -}}
{{- if kindIs "string" $entry -}}
{{-   $entry = dict "title" $entry -}}
{{- end -}}
{{- $title := get $entry "title" -}}
{{- if not $title -}}
{{-   fail (printf "secrets.yaml entry %q has no title" $name) -}}
{{- end -}}
{{- $attributes := get $entry "attributes" | default dict -}}
{{- $attachments := get $entry "attachments" | default dict -}}
{{- if eq $field "Password" -}}
{{-   (keepassxc $title).Password -}}
{{- else if eq $field "UserName" -}}
{{-   (keepassxc $title).UserName -}}
{{- else if eq $field "URL" -}}
{{-   (keepassxc $title).URL -}}
{{- else if hasKey $attributes $field -}}
{{-   keepassxcAttribute $title (index $attributes $field) -}}
{{- else if hasKey $attachments $field -}}
{{-   keepassxcAttachment $title (index $attachments $field) -}}
{{- else -}}
{{-   fail (printf "secrets.yaml entry %q has no field %q" $name $field) -}}
{{- end -}}
