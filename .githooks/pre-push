#!/usr/bin/env bash
set -euo pipefail
# Pre-push gate. Lint drift only: the standalone treefmt binary over the whole
# tree, about 16 seconds uncached (no nix involved since 2026-08-05).
#
# No suite runs here. CI is the authority on the suite: it gates the merge, and
# it tests the pushed COMMIT while this hook can only test the working tree, and
# only the part of it git tracks, so a local pass never meant what it looked
# like (PR #116 passed here and failed on CI, on an edit that was never staged).
# The timings and the rest of the history are in CLAUDE.md under Git Hooks.
#
# KNOW THE GAP THIS LEAVES: CI runs on pull requests and on pushes to `main`, so
# pushing a topic branch that has no open pull request runs the suite NOWHERE.
# `lint` is a required status check on `main`, so a red pull request is blocked
# there; `enforce_admins` is off on that branch, so a repository administrator
# can still merge it red. Either way, do not read a clean push as a tested
# branch. Run `just ship` when you want the suite, before a PR you care about.
#
# Invoked by the user-wide pre-push dispatcher
# (dot_config/git/hooks/executable_pre-push) with git's ref list on stdin;
# these checks are ref-independent, so stdin is intentionally unused.
printf "%s\n" "Running pre-push checks..."

# Format/lint drift gate. Standalone treefmt has no dry-run mode, so a red
# gate has ALSO already written the fixes into the working tree: stage them,
# amend or commit, and push again.
if ! just lint-check; then
  printf "\n%s\n" "❌ Lint drift! treefmt already fixed the files; stage the changes, commit, and push again."
  exit 1
fi

printf "%s\n" "✅ Pre-push checks passed (lint only). CI runs the suite; 'just ship' runs it here."
