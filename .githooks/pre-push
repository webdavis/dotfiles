#!/usr/bin/env bash
set -euo pipefail
# Pre-push gate. Lint drift only, 21 seconds.
#
# No suite runs here. CI is the authority on the suite: it blocks the merge, and
# it tests the pushed COMMIT while this hook can only test the working tree, so
# a local pass never meant what it looked like (PR #116 passed here and failed
# on CI, on an edit that was never staged). The timings and the rest of the
# history are in CLAUDE.md under Git Hooks.
#
# KNOW THE GAP THIS LEAVES: CI runs on pull requests and on pushes to `main`, so
# pushing a topic branch that has no open pull request runs the suite NOWHERE.
# Nothing unverified can reach `main` (the `lint` check is required there), but
# do not read a clean push as a tested branch. Run `just ship` when you want the
# suite, before a PR you care about.
#
# Invoked by the user-wide pre-push dispatcher
# (dot_config/git/hooks/executable_pre-push) with git's ref list on stdin;
# these checks are ref-independent, so stdin is intentionally unused.
printf "%s\n" "Running pre-push checks..."

# Check-only format/lint drift gate: builds the flake's treefmt check
# derivation (sandboxed copy; never mutates the working tree or index).
if ! just lint-check; then
  printf "\n%s\n" "❌ Lint drift! Run 'just l' to auto-fix, commit the result, and push again."
  exit 1
fi

printf "%s\n" "✅ Pre-push checks passed (lint only). CI runs the suite; 'just ship' runs it here."
