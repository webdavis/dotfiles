set nocompatible
filetype plugin indent on
syntax on

set encoding=utf-8
set backspace=indent,eol,start
set number relativenumber
set ruler
set showmatch
set nowrap

set expandtab
set shiftwidth=2
set tabstop=2
set autoindent
" Filetype plugins (Python, Markdown, Rust, Swift, ...) switch to 4-space
" indents; this runs after them and puts every file back to 2.
autocmd FileType * setlocal shiftwidth=2 tabstop=2 softtabstop=0
" A project's .editorconfig wins over the 2-space default above: Vim's bundled
" EditorConfig plugin loads after this file, so its settings land last.
packadd! editorconfig

set incsearch
set hlsearch
set ignorecase
set smartcase

let mapleader = " "
nnoremap <silent> <leader>uh :set hlsearch!<CR>
nnoremap <silent> <leader>uw :set wrap!<CR>

let g:is_bash = 1
autocmd BufRead,BufNewFile *.sh.tmpl set filetype=sh
