// pi has no permission prompt, so a UI prompt is what marks the agent as waiting for an answer.
import { spawn } from "node:child_process"

{{ includeTemplate "pns-reminder-extension.ts.tmpl" (dict "producer" "pi" "binary" (joinPath .chezmoi.homeDir ".cargo/bin" "pns")) }}

export default function pnsReminders(pi) {
  pi.on("ui_prompt_start", (event, ctx) => {
    waiting("PermissionRequest", event, ctx, {
      message: firstString(event?.title, event?.kind, "waiting on you"),
    })
  })

  pi.on("ui_prompt_end", (event, ctx) => {
    answered("PermissionResolved", event, ctx, {})
  })
}
