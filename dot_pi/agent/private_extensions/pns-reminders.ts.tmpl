// pns reminders for pi. This is OUR extension; the moshi-hooks.ts beside it is
// generated by moshi-hook and belongs to moshi.
//
// pi has no permission prompt of its own, so the question the operator has to
// answer is a UI prompt: `ui_prompt_start` opens one and `ui_prompt_end`
// closes it (pi-mono packages/coding-agent/docs/extensions.md).
import { spawn } from "node:child_process"

{{ includeTemplate "pns-reminder-extension.ts.tmpl" (dict "producer" "pi" "binary" (joinPath .chezmoi.homeDir .rust_tools.install_dir "pns")) }}

export default function pnsReminders(pi) {
  pi.on("ui_prompt_start", (event, ctx) => {
    waiting("PermissionRequest", event, ctx, {
      message: firstString(event?.title, event?.kind, "waiting on you"),
    })
  })

  pi.on("ui_prompt_end", (event, ctx) => {
    answered("PermissionResolved", event, ctx, {})
  })
}
