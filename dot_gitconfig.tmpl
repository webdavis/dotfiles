{{- /* Homebrew prefix, derived from platform data rather than from a `brew --prefix` at apply time, which would need brew already installed to render this file. Every absolute Homebrew path below comes from it. */ -}}
{{- $platform := printf "%s/%s" .chezmoi.os .chezmoi.arch -}}
{{- $homebrewPrefix := index (dict "darwin/arm64" "/opt/homebrew" "darwin/amd64" "/usr/local") $platform | default "/home/linuxbrew/.linuxbrew" -}}
[user]
  name = Stephen A. Davis
  email = 23553256+webdavis@users.noreply.github.com
  signingkey = {{ keepassxcAttribute "GPG :: Signing Key (github-webdavis)" "Public Signing Subkey ID" }}

[github]
  username = webdavis

[init]
  defaultBranch = main

[gpg]
  program = {{ $homebrewPrefix }}/bin/gpg

[core]
  editor = nvim
  autocrlf = input
  pager = delta
  hooksPath = ~/.config/git/hooks
  fsmonitor = true
  untrackedCache = true

  # Trailing spaces and spaces before tabs are errors; space indentation is fine.
  whitespace = space-before-tab,-indent-with-non-tab,trailing-space

[apply]
  whitespace = fix

[status]
  submodulesummary = true

# diff.tool and merge.tool take a tool name; a command goes in <tool>.<name>.cmd.
# Merges use git's built-in nvimdiff, which opens all four buffers and finds nvim on PATH.
[difftool "nvimdiff"]
  cmd = {{ $homebrewPrefix }}/bin/nvim -d -u ~/.config/nvim/init.lua \"$LOCAL\" \"$REMOTE\"

[diff]
  submodule = log
  tool = nvimdiff
  colorMoved = default
  algorithm = histogram

[merge]
  conflictstyle = zdiff3
  tool = nvimdiff

[log]
  showSignature = false

[rebase]
  autosquash = true
  autoStash = true
  updateRefs = true

[rerere]
  enabled = true

[fetch]
  prune = true
  pruneTags = true
  writeCommitGraph = true

[commit]
  gpgSign = true
  verbose = true

[branch]
  sort = -committerdate

[tag]
  gpgSign = true
  sort = version:refname

[column]
  ui = auto

[transfer]
  fsckObjects = true

[pull]
  rebase = true

[help]
  autocorrect = prompt

[credential "https://github.com"]
  helper =
  helper = !{{ $homebrewPrefix }}/bin/gh auth git-credential

[credential "https://gist.github.com"]
  helper =
  helper = !{{ $homebrewPrefix }}/bin/gh auth git-credential

# Every rewrite lands on SSH, since GitHub no longer serves git://.
[url "git@github.com:"]
  insteadOf = https://github.com/
  insteadOf = "github:"
  insteadOf = "git://github.com/"

[url "git@gist.github.com:"]
  insteadOf = "gist:"
  insteadOf = "gst:"
  insteadOf = "git://gist.github.com/"

[include]
  path = ~/.config/delta/themes.gitconfig

# Repositories in temp folders skip fsmonitor so a stopped process leaves no daemon behind.
[includeIf "gitdir/i:/private/var/folders/"]
  path = ~/.config/git/no-fsmonitor.gitconfig

[includeIf "gitdir/i:/private/tmp/"]
  path = ~/.config/git/no-fsmonitor.gitconfig

# lazy.nvim touches about a hundred repositories at once, and fsmonitor's IPC then fails
# in a way lazy reads as a dirty worktree.
[includeIf "gitdir/i:~/.local/share/nvim/lazy/"]
  path = ~/.config/git/no-fsmonitor.gitconfig

[interactive]
  diffFilter = delta --color-only

[delta]
  features = custom

[color "branch"]
  current = "#8787d7"
  upstream = "#ff8700"

[color "status"]
  added = "#00c96d"
  changed = "#33a3f4"
  untracked = "#ff657a"
  remote = "#ff8700"

[color "diff"]
  meta = "#87d7d7"
  new = "#87af87"
  old = "#af5f5f"
  frag = "#8787af"
  context = "#bcbcbc"
  func = "#bcbcbc bold"
  commit = "#e2b76f"

[color]
  ui = auto

[push]
  autoSetupRemote = true
