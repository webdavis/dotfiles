// pns reminders for omp. This is OUR extension; the moshi-hooks.ts beside it is
// generated by moshi-hook and belongs to moshi.
//
// omp carries no `ui_prompt_start`/`ui_prompt_end` pair, but it does gate tools
// behind an approval and reports both ends of that wait:
// `tool_approval_requested` opens the question and `tool_approval_resolved`
// closes it (oh-my-pi docs/extensions.md), so omp ships reminders on that pair.
import { spawn } from "node:child_process"

{{ includeTemplate "pns-reminder-extension.ts.tmpl" (dict "producer" "omp" "binary" (joinPath .chezmoi.homeDir .rust_tools.install_dir "pns")) }}

export default function pnsReminders(omp) {
  omp.on("tool_approval_requested", (event, ctx) => {
    waiting("PermissionRequest", event, ctx, {
      tool_name: firstString(event?.toolName),
      message: firstString(event?.reason, event?.toolName, "waiting on you"),
    })
  })

  omp.on("tool_approval_resolved", (event, ctx) => {
    answered("PermissionResolved", event, ctx, {
      tool_name: firstString(event?.toolName),
    })
  })
}
