{{- $entry := "temporal_cloud_broccoli" -}}
[profile.broccoli]
address = "{{ includeTemplate "secret.tmpl" (list $entry "URL") }}"
api_key = "{{ includeTemplate "secret.tmpl" (list $entry "Password") }}"
namespace = "{{ includeTemplate "secret.tmpl" (list $entry "namespace") }}"

[profile.broccoli.codec]
endpoint = "{{ includeTemplate "secret.tmpl" (list $entry "codec_url") }}"
