{{- $machines := list "dresden" "raith" -}}
{{- $question := "Which machine is this?" -}}
{{- $hostname := lower .chezmoi.hostname -}}
{{- $machine := "" -}}
{{- if has $hostname $machines -}}
{{-   $machine = promptChoiceOnce . "machine" $question $machines $hostname -}}
{{- else -}}
{{-   $machine = promptChoiceOnce . "machine" $question $machines -}}
{{- end -}}
# chezmoi reads encryption only as a bare key above the first [section].
encryption = "age"
sourceDir = "/Users/stephen/workspaces/Ivy/webdavis/dotfiles"
workingTree = "/Users/stephen/workspaces/Ivy/webdavis/dotfiles"

[add]
  # Stops `chezmoi add` of a file that looks like it holds a secret unless --encrypt is given.
  secrets = "error"

[age]
  identity = "/Users/stephen/.config/chezmoi/key.txt"
  recipient = "age17p5xkaeynccd2nep0tfzjr4lndfxum28uwdermhdudtdd3dwhslsskjq50"

[keepassxc]
  database = '/Users/stephen/Library/Mobile Documents/iCloud~com~strongbox/Documents/keepass.kdbx'

[hooks.read-source-state.pre]
  command = "{{ .chezmoi.sourceDir }}/.install-password-manager.sh"

[data]
  # `chezmoi init` asks for this once.
  # --promptChoice "Which machine is this?=raith" answers it up front.
  machine = {{ $machine | quote }}
