{{- /* chezmoi:modify-template */ -}}
{{- /*
  Selective field control for ~/.claude.json (the MCP servers this repo
  declares; every other field passes through).

  Why: `claude mcp add` writes secrets in plaintext to ~/.claude.json.
  Vaulting via KeePassXC keeps secrets out of git and lets them rotate
  upstream (composio dashboard, Google Cloud Console) without re-editing
  the source tree.

  How: chezmoi modify-template. Reads current ~/.claude.json from
  .chezmoi.stdin, overlays the managed mcpServers entries with vaulted
  values, writes the merged result back. All other fields (project
  state, telemetry IDs, additional MCP servers, etc.) pass through.
*/ -}}
{{- $stdin := index .chezmoi "stdin" | default "" -}}
{{- $merged := dict -}}
{{- if $stdin -}}
{{-   $merged = fromJson $stdin -}}
{{- end -}}

{{- /* --- stable: composio MCP entry --- */ -}}
{{- $composio := dict
    "type" "http"
    "url" "https://connect.composio.dev/mcp"
    "headers" (dict
      "x-consumer-api-key" ((keepassxc "Composio :: API Key :: MCP").Password)) -}}
{{- $merged = setValueAtPath "mcpServers.composio" $composio $merged -}}

{{- /* --- stable: workspace-mcp entry (Google Workspace via OAuth) --- */ -}}
{{- $workspaceMcp := dict
    "type" "stdio"
    "command" "uvx"
    "args" (list "workspace-mcp" "--tool-tier" "complete")
    "env" (dict
      "GOOGLE_OAUTH_CLIENT_ID" ((keepassxc "Google Cloud (webdavis.io) :: OAuth :: google-workspace-mcp").UserName)
      "GOOGLE_OAUTH_CLIENT_SECRET" ((keepassxc "Google Cloud (webdavis.io) :: OAuth :: google-workspace-mcp").Password)
      "OAUTHLIB_INSECURE_TRANSPORT" "1") -}}
{{- $merged = setValueAtPath "mcpServers.workspace-mcp" $workspaceMcp $merged -}}

{{- /* --- stable: the Neovim MCP server (spec 7.3, PR 10a) ---

     The command is the RESOLVER, never nvim-mcp itself. nvim-mcp picks an
     instance by current directory or git root, which cannot tell two Neovim
     panes in one herdr workspace apart; the resolver answers by herdr pane and
     verifies the instance's identity over RPC before handing it over
     (docs/research/2026-09-nvim-mcp-evaluation.md). It carries no secret, so
     unlike its two neighbours this entry needs no vault entry. --- */ -}}
{{- $nvimMcp := dict
    "type" "stdio"
    "command" (printf "%s/.local/libexec/nvim-mcp/nvim-mcp-connect.sh" .chezmoi.homeDir) -}}
{{- $merged = setValueAtPath "mcpServers.nvim" $nvimMcp $merged -}}

{{- /* --- stable: the Scalebar MCP server, weight and gym data. Path from
     `.chezmoidata/scalebar.yaml`; no secret, so no vault lookup. --- */ -}}
{{- $scalebarMcp := dict
    "type" "stdio"
    "command" (joinPath .chezmoi.homeDir .scalebar.install_dir "ScalebarMCP")
    "args" (list)
    "env" (dict) -}}
{{- $merged = setValueAtPath "mcpServers.scalebar" $scalebarMcp $merged -}}

{{- /* --- stable: the local YNAB MCP server, WRITES ON.

     Full and complete access to the YNAB account is the operator's ruling of
     2026-09-14, so `YNAB_ALLOW_WRITES` is "1" and the server registers its
     write tools alongside the read ones (measured on 5.2.0: 62 tools rather
     than the 38 read tools alone). The value is still DECLARED here rather
     than left to a fallback, because the variable decides the tool surface and
     this repository is where that decision is recorded.

     Nine of those tools additionally require a `confirmed: true` field in
     their own input: the two deletes, the two bulk-filter writes
     (`approve_transactions`, `reassign_payee_transactions`), the three
     category and split operations, `undo_operation`, and the generic
     `ynab_write_tool_execute`. Upstream means it as a human confirmation gate
     (every one of those fields is described as "Pass true only after the user
     explicitly confirms"), but nothing except the schema enforces it and
     upstream offers no switch to turn it off, so a caller can satisfy it
     unaided. The 2026-09-14 ruling is that agents do exactly that: supply the
     field as part of the call rather than stopping to ask the operator per
     call.

     The client-side rate limiter keeps its upstream defaults,
     `YNAB_RATE_LIMIT_PER_HOUR` 190 and `YNAB_RATE_LIMIT_BURST` 10, and is
     deliberately left unset here. It protects nothing across clients: the
     token bucket and its trailing-hour counter both live inside one server
     PROCESS, while YNAB's hard 200-per-hour lockout is per TOKEN, and one
     token now serves three declared clients that each start a process per
     session. The reachable budget is therefore 190 times the number of live
     processes, so the lockout stays reachable whenever two of them run at
     once, and it takes the whole account off the API until the rolling window
     moves. That exposure is accepted rather than mitigated: no per-process
     share fixes the arithmetic, and a counter shared across processes would
     mean changing a third-party server.

     `YNAB_BUDGET_ID` is unset too, so every tool falls back to YNAB's most
     recently accessed budget. Under reads that only misroutes an answer; with
     writes on, a create, update or delete lands there. Run `list_budgets` in
     the first session after the apply and pin the id in all three declarations
     if the account holds more than one budget.

     `YNAB_DISABLE_AGENT_CONFIG_FALLBACK` stays "1". Without it the server
     resolves its runtime keys out of `~/.claude/settings.json` `env` and two
     sections of `~/.codex/config.toml`, all free-drift locations this repo does
     not declare, which would leave the token and the tool surface answerable to
     whatever last wrote those files. Writing the whole map rather than a
     per-key overlay is what keeps every key asserted on every apply. --- */ -}}
{{- $ynabMcp := dict
    "type" "stdio"
    "command" (printf "%s/.local/share/fnm/aliases/default/bin/mcp-server-for-ynab" .chezmoi.homeDir)
    "env" (dict
      "YNAB_ALLOW_WRITES" "1"
      "YNAB_DISABLE_AGENT_CONFIG_FALLBACK" "1"
      "YNAB_API_TOKEN" ((keepassxc "YNAB :: Personal Access Token").Password)) -}}
{{- $merged = setValueAtPath "mcpServers.ynab" $ynabMcp $merged -}}

{{ $merged | toPrettyJson }}
