# shellcheck shell=bash
# Bash aliases sourced by ~/.bashrc inside the interactive block.
#
# Aliases live here when they: take no positional args (or just append
# them), don't need conditional logic, and call a single command. Anything
# more complex goes in ~/.bash_functions.

# ┏━━━━━━━━━━━━━━━━━━━━━━━━┓
# ┃  Git wrappers          ┃
# ┗━━━━━━━━━━━━━━━━━━━━━━━━┛
# Migrated from [alias] in ~/.gitconfig on 2026-04-28. Bash forms
# preferred to avoid the ~/.gitconfig alias namespace entirely.

alias ga='git add'
alias gcm='git checkout main'
alias gca='git commit -a --amend -C HEAD --'
alias gcan='git commit --amend --no-edit'
alias gamend='git commit --amend --reuse-message=HEAD'
alias glg='git log --pretty=oneline -n 20 --graph --abbrev-commit'
alias gmm='git merge origin/main'
alias gs='git status -s'
alias gsf='git status'
alias gts='git tag --list --sort=v:refname'
alias gundo='git reset --soft HEAD~1'
alias gunstage='git restore --staged'
alias grecent='git for-each-ref --sort=-committerdate --count=10 --format="%(refname:short)" refs/heads'
alias gwhoami='git config --get user.name'

# ┏━━━━━━━━━━━━━━━━━━━━━━━━┓
# ┃  Navigation            ┃
# ┗━━━━━━━━━━━━━━━━━━━━━━━━┛
# zoxide's `z` stands in for cd. Its init runs later in ~/.bashrc than this
# file is sourced, which an alias does not mind: it expands when it is used.
alias cd='z'
alias ..='cd ..'
alias ...='cd ../..'
alias ....='cd ../../..'

# ┏━━━━━━━━━━━━━━━━━━━━━━━━┓
# ┃  Listing               ┃
# ┗━━━━━━━━━━━━━━━━━━━━━━━━┛
# --icons takes an optional WHEN value and eza's parser eats the NEXT argv
# word for it, so `ll dir/` fails with "invalid value 'dir/' for '--icons'"
# unless the value is attached with =.
alias ls='eza --icons=auto'
alias ll='eza -la --git --icons=auto'
alias la='eza -a --icons=auto'
alias lt='eza --tree --level=2 --icons=auto --git-ignore'
alias tree='tree -C'

# ┏━━━━━━━━━━━━━━━━━━━━━━━━┓
# ┃  Modern replacements   ┃
# ┗━━━━━━━━━━━━━━━━━━━━━━━━┛
alias bat='bat --color=always'
alias du='dust'
alias ps='procs'
alias grep='grep --color=auto'
alias p='python3'

# ┏━━━━━━━━━━━━━━━━━━━━━━━━┓
# ┃  Confirm before clobber┃
# ┗━━━━━━━━━━━━━━━━━━━━━━━━┛
alias cp='cp -i'
alias mv='mv -i'

# ┏━━━━━━━━━━━━━━━━━━━━━━━━┓
# ┃  Shortcuts             ┃
# ┗━━━━━━━━━━━━━━━━━━━━━━━━┛
# The same action the prefix+ctrl+h chord fires, so the label and the working
# directory stay in the plugin manifest rather than being repeated here.
alias h='herdr plugin action invoke herdr-workspace-jump.jump_homelab'
alias fman='compgen -c | fzf | xargs man'
alias path='echo $PATH | tr ":" "\n"'
alias pubip='dig +short myip.opendns.com @resolver1.opendns.com'
alias timer='echo "Timer started. Stop with Ctrl-D." && time cat'
alias git-weekly='git diff --name-status "@{7 days ago}" | sort -u | grep -v "Templates" > weekly-review-files.md'
