{{ if eq .chezmoi.os "darwin" -}}
{{- $systemPackagesAreSkipped := eq (env "SKIP_SYSTEM_PACKAGES") "1" -}}
{{- $trustedTaps := .packages.macos.homebrew.trusted_taps -}}
{{- $graphifyIsDeclared := has "graphifyy" .packages.macos.uv -}}
#!/usr/bin/env bash

set -euo pipefail

{{ includeTemplate "cli-print-style-lib.sh.tmpl" }}

readonly homebrew_prefix="${HOMEBREW_PREFIX:-/opt/homebrew}"
readonly brew_bin="$homebrew_prefix/bin/brew"
readonly homebrew_trust_store="${XDG_CONFIG_HOME:-$HOME/.config}/homebrew/trust.json"
readonly homebrew_trust_store_trace="${TRUST_TRACE:-$HOME/.local/state/homebrew-trust-trace.log}"
readonly trace_stage_column_width=26
readonly published_app_store_brewfile="$HOME/.local/state/homebrew/mas.Brewfile"
{{- if $graphifyIsDeclared }}
readonly graphify_claude_config_directory="$HOME/.local/share/graphify/claude"
readonly graphify_skill_bundle_directory="$graphify_claude_config_directory/skills/graphify"
readonly graphify_executable="$HOME/.local/bin/graphify"
readonly graphify_install_time_limit_seconds=60
{{- end }}
{{- if .packages.macos.fnm }}
readonly fnm_default_node_bin_directory="$HOME/.local/share/fnm/aliases/default/bin"
readonly npm_install_time_limit_seconds=180
{{- end }}

declared_trusted_taps=(
{{- range $trustedTaps }}
  {{ . | quote }}
{{- end }}
)

never_wait_on_homebrew_install_confirmations() {
  export HOMEBREW_NO_ASK=1
}

homebrew_trust_store_exists() {
  [[ -f $homebrew_trust_store ]]
}

homebrew_trust_store_size_in_bytes() {
  wc -c <"$homebrew_trust_store" 2>/dev/null | tr -d ' '
}

current_utc_time() {
  date -u +%Y-%m-%dT%H:%M:%SZ
}

append_line_to_trust_store_trace() {
  local stage=$1 state=$2
  mkdir -p "$(dirname "$homebrew_trust_store_trace")" 2>/dev/null || true
  printf '%s\t%-*s\t%s\n' "$(current_utc_time)" "$trace_stage_column_width" "$stage" "$state" >>"$homebrew_trust_store_trace" 2>/dev/null || true
}

record_homebrew_trust_store_state() {
  local stage=$1
  local state
  if homebrew_trust_store_exists; then
    state="present bytes=$(homebrew_trust_store_size_in_bytes)"
  else
    state="ABSENT"
  fi
  append_line_to_trust_store_trace "$stage" "$state"
}

no_trusted_taps_are_declared() {
  ((${#declared_trusted_taps[@]} == 0))
}

add_tap() {
  local tap=$1
  "$brew_bin" tap "$tap" >/dev/null 2>&1 || true
}

trust_tap() {
  local tap=$1
  "$brew_bin" trust --tap "$tap" >/dev/null 2>&1 || true
}

request_trust_for_each_declared_tap() {
  local tap
  for tap in "${declared_trusted_taps[@]}"; do
    add_tap "$tap"
    trust_tap "$tap"
  done
}

tap_is_trusted() {
  local tap=$1
  "$brew_bin" tap-info "$tap" 2>/dev/null | grep -qx 'Trusted'
}

find_untrusted_taps() {
  local tap
  untrusted_taps=()
  for tap in "${declared_trusted_taps[@]}"; do
    if ! tap_is_trusted "$tap"; then
      untrusted_taps+=("$tap")
    fi
  done
}

every_declared_tap_is_trusted() {
  ((${#untrusted_taps[@]} == 0))
}

report_untrusted_taps() {
  local tap
  report_line "error[untrusted-taps]: brew tap trust did not persist for ${#untrusted_taps[@]} of ${#declared_trusted_taps[@]} declared tap(s): ${untrusted_taps[*]}"
  report_line 'Homebrew refuses to load casks from an untrusted tap, so the cleanup stage below would fail with an error that names the cask rather than the trust. Trust them by hand, then re-apply:'
  for tap in "${untrusted_taps[@]}"; do
    report_line "  brew trust --tap $tap"
  done
}

trust_declared_taps() {
  if no_trusted_taps_are_declared; then
    return 0
  fi
  request_trust_for_each_declared_tap
  find_untrusted_taps
  if every_declared_tap_is_trusted; then
    return 0
  fi
  report_untrusted_taps >&2
  return 1
}

homebrew_has_installed() {
  local package=$1
  "$brew_bin" list "$package" &>/dev/null
}

legacy_multiplexer_is_installed() {
  local multiplexer
  for multiplexer in tmux sesh; do
    if homebrew_has_installed "$multiplexer"; then
      return 0
    fi
  done
  return 1
}

report_cleanup_withheld_until_herdr_is_verified() {
  report_line 'Legacy multiplexer (tmux/sesh) still installed: running brew bundle WITHOUT cleanup so it is not removed before herdr is verified.'
  report_line 'run_after_58 owns the teardown and completes the migration once herdr is healthy: open an interactive terminal (bashrc auto-attaches and starts the herdr server), then run chezmoi apply again so after_58 verifies herdr and removes tmux/sesh.'
}

create_temporary_brewfiles() {
  declared_brewfile="$(mktemp)"
  brewfile_without_app_store_apps="$(mktemp)"
  app_store_apps_brewfile="$(mktemp)"
  trap remove_temporary_brewfiles EXIT
}

remove_temporary_brewfiles() {
  rm -f "$declared_brewfile" "$brewfile_without_app_store_apps" "$app_store_apps_brewfile"
}

write_declared_brewfile() {
  cat >"$declared_brewfile" <<EOF
{{ range .packages.macos.homebrew.taps -}}
tap {{ . | quote }}{{ if has . $trustedTaps }}, trusted: true{{ end }}
{{ end -}}
{{ range .packages.macos.homebrew.formulae -}}
brew {{ . | quote }}
{{ end -}}
{{ range .packages.macos.homebrew.casks -}}
cask {{ . | quote }}
{{ end -}}
{{ range .packages.macos.homebrew.mas -}}
mas {{ .name | quote }}, id: {{ .id }}
{{ end -}}
EOF
}

write_brewfile_without_app_store_apps() {
  grep -v '^mas ' "$declared_brewfile" >"$brewfile_without_app_store_apps"
}

write_app_store_apps_brewfile() {
  grep '^mas ' "$declared_brewfile" >"$app_store_apps_brewfile" || true
}

install_missing_homebrew_packages() {
  "$brew_bin" bundle --no-upgrade --verbose --file="$brewfile_without_app_store_apps" </dev/null
}

app_store_apps_are_declared() {
  [[ -s $app_store_apps_brewfile ]]
}

publish_app_store_brewfile() {
  mkdir -p "${published_app_store_brewfile%/*}"
  cp "$app_store_apps_brewfile" "$published_app_store_brewfile"
}

remove_published_app_store_brewfile() {
  rm -f "$published_app_store_brewfile"
}

hand_app_store_apps_to_the_weekly_job() {
  if app_store_apps_are_declared; then
    publish_app_store_brewfile
    report_line "App Store apps are declared but never synced at apply; the weekly homebrew job installs from ${published_app_store_brewfile}, bounded."
  else
    remove_published_app_store_brewfile
  fi
}

install_declared_homebrew_packages() {
  create_temporary_brewfiles
  write_declared_brewfile
  write_brewfile_without_app_store_apps
  write_app_store_apps_brewfile
  report_section 'homebrew' 'bundle sync'
  install_missing_homebrew_packages
  hand_app_store_apps_to_the_weekly_job
  record_homebrew_trust_store_state '20-after-brew-bundle'
}

{{ includeTemplate "brew-bundle-cleanup-guard.sh.tmpl" }}

cleanup_printed_something() {
  local cleanup_output=$1
  [[ -n $cleanup_output ]]
}

report_cleanup_output() {
  local cleanup_output=$1
  if cleanup_printed_something "$cleanup_output"; then
    report_section 'homebrew' 'bundle cleanup'
    report_line "$cleanup_output"
  fi
}

cleanup_failed() {
  local exit_status=$1
  ((exit_status != 0))
}

redo_trailing_brew_cleanup() {
  "$brew_bin" cleanup
}

retry_cleanup_after_restoring_trust() {
  local exit_status=$1
  report_line "brew bundle cleanup exited $exit_status. Restoring the trust store it destroys and retrying the cleanup once; a second failure aborts." >&2
  trust_declared_taps
  record_homebrew_trust_store_state '50-after-trust-restore'
  redo_trailing_brew_cleanup
  record_homebrew_trust_store_state '60-after-retry-cleanup'
}

remove_undeclared_homebrew_packages() {
  local cleanup_output cleanup_exit_status=0
  trust_declared_taps
  record_homebrew_trust_store_state '30-after-reassert'
  cleanup_output="$(brew_bundle_cleanup_guarded "$declared_brewfile")" || cleanup_exit_status=$?
  record_homebrew_trust_store_state '40-after-cleanup'
  report_cleanup_output "$cleanup_output"
  if cleanup_failed "$cleanup_exit_status"; then
    retry_cleanup_after_restoring_trust "$cleanup_exit_status"
  fi
}

put_homebrew_tools_first_on_path() {
  export PATH="$homebrew_prefix/bin:$PATH"
}
{{- if .packages.macos.uv }}

uv_is_installed() {
  command -v uv >/dev/null 2>&1
}

install_uv_tool() {
  local package=$1
  uv tool install "$package"
}

install_uv_tool_on_python() {
  local python_version=$1 package=$2
  uv tool install --python "$python_version" "$package"
}
{{- if $graphifyIsDeclared }}

something_other_than_a_directory_is_at() {
  local path=$1
  [[ -L $path || (-e $path && ! -d $path) ]]
}

graphify_claude_config_directory_is_missing() {
  [[ ! -e $graphify_claude_config_directory ]]
}

a_non_empty_regular_file_is_at() {
  local path=$1
  [[ -f $path && -s $path && ! -L $path ]]
}

graphify_skill_bundle_is_complete() {
  a_non_empty_regular_file_is_at "$graphify_skill_bundle_directory/SKILL.md" &&
    a_non_empty_regular_file_is_at "$graphify_skill_bundle_directory/.graphify_version" &&
    [[ -d $graphify_skill_bundle_directory/references ]]
}

install_graphify_skill_bundle() {
  gtimeout "$graphify_install_time_limit_seconds" /usr/bin/env "CLAUDE_CONFIG_DIR=$graphify_claude_config_directory" \
    "$graphify_executable" install --platform claude
}

seed_graphify_skill_bundle() {
  local directory
  for directory in "$HOME/.local" "$HOME/.local/share" "$HOME/.local/share/graphify" \
    "$graphify_claude_config_directory" "$graphify_claude_config_directory/skills" \
    "$graphify_skill_bundle_directory" "$graphify_skill_bundle_directory/references"; do
    if something_other_than_a_directory_is_at "$directory"; then
      report_line "error[unsafe-path]: graphify seed: refusing symlink or non-directory at $directory; existing data is preserved." >&2
      return 1
    fi
  done

  if graphify_claude_config_directory_is_missing; then
    install_graphify_skill_bundle
  elif ! graphify_skill_bundle_is_complete; then
    report_line "error[incomplete-bundle]: graphify seed: incomplete or linked bundle at $graphify_claude_config_directory; preserving it for operator repair." >&2
    return 1
  fi
}
{{- end }}

install_declared_uv_tools() {
  report_section 'uv' 'tool installs' >&2
{{- range .packages.macos.uv }}
{{- if hasPrefix "whisply" . }}
  install_uv_tool_on_python 3.12 {{ . | quote }}
{{- else }}
  install_uv_tool {{ . | quote }}
{{- end }}
{{- if eq . "graphifyy" }}
  seed_graphify_skill_bundle
{{- end }}
{{- end }}
}
{{- end }}
{{- if .packages.macos.fnm }}

fnm_is_installed() {
  command -v fnm >/dev/null 2>&1
}

use_fnm_default_node_for_npm() {
  PATH="$fnm_default_node_bin_directory:$PATH"
}

install_node_version() {
  local node_version=$1
  fnm install "$node_version"
}

make_node_version_the_default() {
  local node_version=$1
  fnm default "$node_version"
}

npm_package_is_installed() {
  local package=$1
  npm ls -g "$package" >/dev/null 2>&1
}

install_npm_package() {
  local package=$1
  gtimeout "$npm_install_time_limit_seconds" npm install -g "$package"
}

install_missing_npm_package() {
  local package=$1
  if ! install_npm_package "$package"; then
    npm_packages_that_failed_to_install+=("$package")
  fi
}

update_npm_package() {
  local package=$1
  if ! install_npm_package "$package"; then
    npm_updates_stopped=true
    report_line 'WARNING: npm update timed out or failed; skipping the remaining npm updates this apply. Installed versions stay as they are.' >&2
  fi
}

npm_updates_still_run() {
  [[ $npm_updates_stopped == false ]]
}

install_declared_npm_package() {
  local package=$1
  if ! npm_package_is_installed "$package"; then
    install_missing_npm_package "$package"
  elif npm_updates_still_run; then
    update_npm_package "$package"
  fi
}

some_npm_package_failed_to_install() {
  ((${#npm_packages_that_failed_to_install[@]} > 0))
}

install_declared_npm_tools() {
  use_fnm_default_node_for_npm
  npm_updates_stopped=false
  npm_packages_that_failed_to_install=()
  report_section 'fnm' 'node + npm CLI tools'
{{- range .packages.macos.fnm }}
  install_node_version {{ .node | quote }}
  make_node_version_the_default {{ .node | quote }}
{{- range .packages }}
  install_declared_npm_package {{ . | quote }}
{{- end }}
{{- end }}
  if some_npm_package_failed_to_install; then
    report_line "error[failed-install]: these declared npm packages were missing and did not install: ${npm_packages_that_failed_to_install[*]}" >&2
    return 1
  fi
}
{{- end }}

main() {
{{- if $systemPackagesAreSkipped }}
  report_section 'system packages' 'Homebrew, uv and npm installs'
  report_line 'SKIP_SYSTEM_PACKAGES=1 is set, skipping.'
{{- else }}
  never_wait_on_homebrew_install_confirmations
  record_homebrew_trust_store_state '00-script-start'
  trust_declared_taps
  record_homebrew_trust_store_state '10-after-trust-pass'

  if legacy_multiplexer_is_installed; then
    report_cleanup_withheld_until_herdr_is_verified >&2
    install_declared_homebrew_packages
  else
    install_declared_homebrew_packages
    remove_undeclared_homebrew_packages
  fi

  put_homebrew_tools_first_on_path
{{- if .packages.macos.uv }}

  if uv_is_installed; then
    install_declared_uv_tools
  fi
{{- end }}
{{- if .packages.macos.fnm }}

  if fnm_is_installed; then
    install_declared_npm_tools
  fi
{{- end }}
{{- end }}
}

main "$@"
{{ end -}}
