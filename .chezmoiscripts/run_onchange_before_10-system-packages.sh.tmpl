{{ if eq .chezmoi.os "darwin" -}}
#!/bin/bash

set -euo pipefail

{{ if eq (env "SKIP_SYSTEM_PACKAGES") "1" -}}
# SKIP_SYSTEM_PACKAGES=1 set: skipping the brew bundle sync entirely, so a
# `chezmoi apply` from a secondary worktree (whose declared package set differs)
# cannot uninstall packages this worktree does not list. Only the literal "1"
# skips -- 0/false/anything-else still run the sync. A later normal apply re-runs
# this and re-syncs.
exit 0
{{ end -}}
# G2 section headers for the loud stages below (operator ruling 2026-08-05); the
# library is inlined at render time, so no runtime sourcing.
{{ includeTemplate "cli-print-style-lib.sh.tmpl" }}
# Resolve the Homebrew prefix once (honoring HOMEBREW_PREFIX) so every
# brew/uv/fnm call goes through one place.
brew_prefix="${HOMEBREW_PREFIX:-/opt/homebrew}"
brew_bin="$brew_prefix/bin/brew"

# DIAGNOSTIC INSTRUMENTATION for task #118: the Homebrew trust store empties
# during an apply, and no command reproduces it in isolation (brew cleanup, a
# non-forced brew bundle cleanup, brew update, an untap, and sixteen rapid
# trust writes were each ruled out by direct experiment on 2026-08-05). Rather
# than keep guessing at candidates, every stage boundary below records the
# store's state, so the NEXT failing apply names the stage that loses it.
#
# Deliberately jq-free (this is a before_ script that can run before jq exists)
# and append-only. Remove this block, and its five call sites, when #118 closes.
TRUST_TRACE="${TRUST_TRACE:-$HOME/.local/state/homebrew-trust-trace.log}"
trust_checkpoint() {
  local store="${XDG_CONFIG_HOME:-$HOME/.config}/homebrew/trust.json" state
  if [[ -f $store ]]; then
    state="present bytes=$(wc -c <"$store" 2>/dev/null | tr -d ' ')"
  else
    state="ABSENT"
  fi
  mkdir -p "$(dirname "$TRUST_TRACE")" 2>/dev/null || true
  printf '%s\t%-26s\t%s\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ)" "$1" "$state" >>"$TRUST_TRACE" 2>/dev/null || true
}
trust_checkpoint '00-script-start'

# The declared taps Homebrew must be willing to load formulae, casks and
# commands from. Held in an array so the trust pass can both apply and VERIFY.
trusted_taps=(
{{ range .packages.macos.homebrew.trusted_taps -}}
  {{ . | quote }}
{{ end -}}
)

# Tap, trust, then PROVE the trust persisted, and refuse to continue if it did
# not. `brew tap-info` is the authority: it prints a bare `Trusted` or
# `Untrusted` line reflecting the same store brew consults when it loads a cask,
# so this cannot pass while the store is empty. It is also jq-free, which
# matters because this is a before_ script that can run before jq is installed.
#
# WHY THIS VERIFIES rather than fires and forgets. Measured on dresden
# 2026-08-05: the old form (`brew trust --tap X 2>/dev/null || true`, per tap)
# printed success for all sixteen taps while `brew trust --json v1` reported
# every list empty. The apply then died two hundred lines later inside
# `brew cleanup` with "Refusing to load cask mediosz/tap/swipeaerospace from
# untrusted tap mediosz/tap", which reads as a cleanup bug rather than as the
# trust failure it actually was. Suppressing stderr and forcing exit 0 is what
# turned a precise failure into a misleading one.
#
# The comment this replaces was also wrong about WHEN trust is enforced. It said
# trust was needed "when HOMEBREW_REQUIRE_TAP_TRUST is set"; that variable is
# unset on this host, in brew.env and in this repo, and Homebrew enforced tap
# trust anyway.
assert_taps_trusted() {
  local tap missing=()
  # An empty declaration means there is deliberately nothing to trust.
  [[ ${#trusted_taps[@]} -gt 0 ]] || return 0
  for tap in "${trusted_taps[@]}"; do
    # `brew tap` first (no-op when already tapped) so `brew trust` has a target.
    "$brew_bin" tap "$tap" >/dev/null 2>&1 || true
    "$brew_bin" trust --tap "$tap" >/dev/null 2>&1 || true
  done
  for tap in "${trusted_taps[@]}"; do
    "$brew_bin" tap-info "$tap" 2>/dev/null | grep -qx 'Trusted' || missing+=("$tap")
  done
  [[ ${#missing[@]} -eq 0 ]] && return 0
  printf 'brew tap trust did not persist for %d of %d declared tap(s): %s\n' \
    "${#missing[@]}" "${#trusted_taps[@]}" "${missing[*]}" >&2
  report_line 'Homebrew refuses to load casks from an untrusted tap, so the cleanup stage below would fail with an error that names the cask rather than the trust. Trust them by hand, then re-apply:' >&2
  printf '  brew trust --tap %s\n' "${missing[@]}" >&2
  return 1
}
assert_taps_trusted
trust_checkpoint '10-after-trust-pass'

# --- live-migration ordering safety (herdr replaces tmux/sesh) ---
# `brew bundle --cleanup` uninstalls any formula/cask absent from the desired
# set below, including tmux/sesh once they leave the manifest. Removing the old
# multiplexer HERE is unsafe: chezmoi runs ALL before_ scripts, THEN updates
# target files, THEN runs after_ scripts, so a --cleanup in this before_ script
# would validate and tear down against the PREVIOUS revision's installed herdr,
# and a broken NEW revision would be discovered only after the fallback was
# already gone. So this script NEVER removes the legacy multiplexer: while tmux
# or sesh is installed it withholds --cleanup entirely. run_after_58 owns the
# teardown (it runs post-target-update): it verifies the just-installed herdr
# LIVE and, only on success, performs the same cleanup this script withholds.
# bundle_args always carries --file, so it is never an empty array (safe under
# set -u).
#
# True migration sequence (plugin registration and the session server need a
# RUNNING herdr server, which ONLY an interactive bashrc starts; a chezmoiscript
# must never start it): apply once (installs herdr, cleanup deferred here) ->
# open an interactive terminal so the herdr server starts -> apply again
# (after_58 verifies herdr and runs the cleanup). On a headless / serverless
# host the deferral simply persists until an interactive terminal is opened.
#
# ROLLBACK: while herdr is unverified, tmux/sesh stay installed and usable; no
# teardown happens. Keep using tmux until after_58 completes the migration.
multiplexer_present=false
for multiplexer in tmux sesh; do
  if "$brew_bin" list "$multiplexer" &>/dev/null; then
    multiplexer_present=true
    break
  fi
done
if [[ $multiplexer_present == true ]]; then
  report_line 'Legacy multiplexer (tmux/sesh) still installed: running brew bundle WITHOUT cleanup so it is not removed before herdr is verified.' >&2
  report_line 'run_after_58 owns the teardown and completes the migration once herdr is healthy: open an interactive terminal (bashrc auto-attaches and starts the herdr server), then run chezmoi apply again so after_58 verifies herdr and removes tmux/sesh.' >&2
fi

# Install all taps, formulae, casks, and macOS App Store apps, then uninstall
# anything not declared. Homebrew 6.x removed the old `brew bundle --cleanup`
# behavior: the flag now only PRINTS what it would remove and exits 1 whenever
# that list is non-empty, which aborts the whole apply under set -e. Removal is
# now its own command, `brew bundle cleanup --force`. So write the Brewfile to a
# temp file once, install from it, then (unless the legacy multiplexer is still
# installed, per the withhold rationale above) run the cleanup command.
# THE APPLY INSTALLS WHAT IS MISSING AND UPGRADES NOTHING (operator ruling
# 2026-08-31, after three months of weekly apply stalls). `--no-upgrade` keeps
# an interactive apply off the upgrade-the-world path entirely: upgrades belong
# to the weekly unattended job, which has nobody waiting at a prompt. The full
# Brewfile still declares everything, because the cleanup below judges against
# it.
#
# AND THE APPLY NEVER TALKS TO THE APP STORE AT ALL. `mas` hangs indefinitely
# when the store session wedges (measured twice on 2026-08-31, once for ten
# silent minutes), so the mas lines are PUBLISHED for the weekly job, which
# runs them under a bound. A newly declared App Store app therefore lands
# within a week rather than wedging the apply an operator is watching.
brewfile=$(mktemp)
brewfile_main=$(mktemp)
brewfile_mas=$(mktemp)
trap 'rm -f "$brewfile" "$brewfile_main" "$brewfile_mas"' EXIT
cat >"$brewfile" <<EOF
{{ $trusted := .packages.macos.homebrew.trusted_taps -}}
{{ range .packages.macos.homebrew.taps -}}
tap {{ . | quote }}{{ if has . $trusted }}, trusted: true{{ end }}
{{ end -}}
{{ range .packages.macos.homebrew.formulae -}}
brew {{ . | quote }}
{{ end -}}
{{ range .packages.macos.homebrew.casks -}}
cask {{ . | quote }}
{{ end -}}
{{ range .packages.macos.homebrew.mas -}}
mas {{ .name | quote }}, id: {{ .id }}
{{ end -}}
EOF
grep -v '^mas ' "$brewfile" >"$brewfile_main"
grep '^mas ' "$brewfile" >"$brewfile_mas" || true
report_section "homebrew" "bundle sync"
"$brew_bin" bundle --no-upgrade --file="$brewfile_main"
mas_manifest="$HOME/.local/state/homebrew/mas.Brewfile"
if [[ -s $brewfile_mas ]]; then
  mkdir -p "${mas_manifest%/*}"
  cp "$brewfile_mas" "$mas_manifest"
  report_line "App Store apps are declared but never synced at apply; the weekly homebrew job installs from ${mas_manifest}, bounded."
else
  rm -f "$mas_manifest"
fi
trust_checkpoint '20-after-brew-bundle'
{{ includeTemplate "brew-bundle-cleanup-guard.sh.tmpl" }}
if [[ $multiplexer_present == false ]]; then
  # Re-assert trust HERE rather than relying on the pass at the top of this
  # script. On dresden 2026-08-05 trust was present when this script started
  # (every tap reported "Already trusted tap") and absent by the time the
  # cleanup loaded its first cask, inside a single run. The cleanup stage untaps
  # whatever the Brewfile does not declare, and that is the only thing running
  # in between, so trust established two hundred lines earlier is not trust the
  # cleanup can be assumed to see. Cheap to repeat: every call is a no-op once
  # the store holds the tap.
  assert_taps_trusted
  trust_checkpoint '30-after-reassert'
  # Guarded: refuses a bulk cleanup against a partial/empty Brewfile (returns 0
  # on refuse or clean, non-zero only on a real cleanup failure).
  #
  # `brew bundle cleanup --force` DESTROYS the Homebrew trust store and then
  # fails on its own trailing `brew cleanup`, which can no longer load casks or
  # formulae from the taps it just untrusted. Proven on dresden 2026-08-05 by the
  # checkpoints above: the store read `present bytes=385` at 00, 10, 20 and 30,
  # and was ABSENT immediately after this call, on an apply that reported
  # `/opt/homebrew/bin/brew cleanup exited with 1`. Four applies died here.
  #
  # So a failure from this call is tolerated ONCE, and only by repairing its
  # precondition and redoing the step it botched. This is deliberately not a
  # blanket `|| true`: the retry runs the same command against a restored trust
  # store, and a second failure is a real one that aborts the apply under set -e.
  #
  # Stdout is CAPTURED because `brew bundle cleanup --force` prints nothing at
  # all when it has nothing to remove, and a header must not stand over no body.
  cleanup_rc=0
  cleanup_output="$(brew_bundle_cleanup_guarded "$brewfile")" || cleanup_rc=$?
  trust_checkpoint '40-after-cleanup'
  if [[ -n $cleanup_output ]]; then
    report_section "homebrew" "bundle cleanup"
    report_line "$cleanup_output"
  fi
  if [[ $cleanup_rc -ne 0 ]]; then
    printf 'brew bundle cleanup exited %d. Restoring the trust store it destroys and retrying the cleanup once; a second failure aborts.\n' \
      "$cleanup_rc" >&2
    assert_taps_trusted
    trust_checkpoint '50-after-trust-restore'
    "$brew_bin" cleanup
    trust_checkpoint '60-after-retry-cleanup'
  fi
fi

# The ecosystem tools (uv, fnm) were just installed by the bundle at
# $brew_prefix/bin, which the apply shell's PATH may not yet include (a fresh
# machine, or `bash -lc` reaching an unsourced shell). Prepend it once so the
# `command -v` guards and the invocations below see the SAME binaries -- without
# this a guard could skip a tool the bundle just installed at an absolute path,
# and run_onchange would not retry until the data file changes.
export PATH="$brew_prefix/bin:$PATH"

# Install uv tools (runs after Homebrew so uv is available). Guarded on uv being
# on PATH so a fresh machine (whose PATH now includes the brew prefix above)
# skips cleanly instead of aborting under set -e when uv is genuinely absent.
{{ if .packages.macos.uv -}}
if command -v uv >/dev/null 2>&1; then
  # uv narrates an already-installed tool on STDERR, so the header rides that
  # stream rather than landing above a block it does not label.
  report_section "uv" "tool installs" >&2
{{- range .packages.macos.uv }}
  uv tool install {{ . | quote }}
{{- end }}
fi
{{ end -}}

# Install the fnm-managed node and the npm CLI tools that run on it. fnm owns
# the runtime: `fnm default` retargets the version-free aliases/default
# symlink, and each node ships its own npm, which is what installs the
# packages. fnm's bin dir is prepended for these calls because npm resolves
# node through PATH (env-node shebang): without the prepend it runs on
# whatever node PATH finds first and installs into THAT node's prefix.
#
# `npm install -g` is deliberately unconditional for INSTALLED packages too: it
# is also the updater. The two cases fail differently, by ruling:
#   missing package: MUST install. A failure fails this script, which aborts
#     the apply: a declared tool that cannot land is not a passing apply.
#   update pass: best effort. Each attempt gets a deadline so a wedged npm
#     cannot hang the apply; the first timeout skips the remaining updates
#     with a warning, and installed versions simply stay put.
{{ if .packages.macos.fnm -}}
if command -v fnm >/dev/null 2>&1; then
  PATH="$HOME/.local/share/fnm/aliases/default/bin:$PATH"
  npm_updates_broken=""
  npm_missing_failed=()
  report_section "fnm" "node + npm CLI tools"
{{- range .packages.macos.fnm }}
  fnm install {{ .node | quote }}
  fnm default {{ .node | quote }}
{{- range .packages }}
  if ! npm ls -g {{ . | quote }} >/dev/null 2>&1; then
    gtimeout 180 npm install -g {{ . | quote }} || npm_missing_failed+=({{ . | quote }})
  elif [[ -z $npm_updates_broken ]]; then
    if ! gtimeout 180 npm install -g {{ . | quote }}; then
      npm_updates_broken=1
      report_line 'WARNING: npm update timed out or failed; skipping the remaining npm updates this apply. Installed versions stay as they are.' >&2
    fi
  fi
{{- end }}
{{- end }}
  if [[ ${#npm_missing_failed[@]} -gt 0 ]]; then
    printf 'FAILED TO INSTALL (declared but absent): %s\n' "${npm_missing_failed[*]}" >&2
    exit 1
  fi
fi
{{ end -}}

{{ end -}}
