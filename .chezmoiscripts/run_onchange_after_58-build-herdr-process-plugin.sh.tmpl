{{ if eq .chezmoi.os "darwin" -}}
#!/bin/bash

set -euo pipefail

# Builds and links the herdr-process plugin (herdr-owned windows for long-lived
# processes). `herdr plugin link` does NOT run the manifest's [[build]] step, so
# the binary is compiled here. Re-runs whenever the plugin source changes.
#
# Unlike the other two plugins, this one ships NO herdr-plugin.toml: its actions
# are one set per declared process profile, so the manifest is rendered from the
# operator's own configuration by `herdr-process generate` (the partial's
# manifest phase, which the manifestCommand argument below turns on). Those two
# config files are therefore build inputs and are hashed here, so editing a
# profile or a chord re-fires this script and the manifest is re-rendered.
#   .config/herdr/processes.toml {{ include (joinPath .chezmoi.sourceDir "dot_config/herdr/processes.toml") | sha256sum }}
#   .config/herdr/config.toml {{ include (joinPath .chezmoi.sourceDir ".chezmoitemplates/herdr-config-declared.toml.tmpl") | sha256sum }}
#
# G2 section headers; the build partial calls report_section, so the library has
# to be inlined ahead of it or the call is command-not-found under set -e.
{{ includeTemplate "cli-print-style-lib.sh.tmpl" }}
{{ includeTemplate "herdr-plugin-build.sh.tmpl" (dict "sourceDir" .chezmoi.sourceDir "id" "herdr-process" "manifestCommand" "./target/release/herdr-process generate --output .") }}
{{ end -}}
