{{ if eq .chezmoi.os "darwin" -}}
#!/usr/bin/env bash

set -euo pipefail

{{ includeTemplate "cli-print-style-lib.sh.tmpl" }}

{{ includeTemplate "keep-old-logs.sh.tmpl" }}

readonly old_log_directory="$HOME/.local/log"
readonly state_directory="${XDG_STATE_HOME:-$HOME/.local/state}"
readonly old_brew_shellenv_log="$old_log_directory/brew-shellenv-selfheal.log"
readonly old_brew_shellenv_attempt_stamp="$old_log_directory/brew-shellenv-selfheal.attempt"
readonly kept_old_brew_shellenv_log="$state_directory/brew-shellenv/selfheal.old.log"
readonly old_graphify_log_directory="$old_log_directory/graphify"
readonly old_graphify_log="$old_graphify_log_directory/dotfiles-post-commit.log"
readonly kept_old_graphify_log="$state_directory/graphify/dotfiles-post-commit.old.log"

brew_shellenv_left_old_files() {
  old_log_is_waiting_to_move "$old_brew_shellenv_log" "$kept_old_brew_shellenv_log" ||
    [[ -e $old_brew_shellenv_attempt_stamp ]]
}

graphify_left_an_old_log() {
  old_log_is_waiting_to_move "$old_graphify_log" "$kept_old_graphify_log" ||
    folder_is_empty "$old_graphify_log_directory"
}

keep_the_old_brew_shellenv_log() {
  if brew_shellenv_left_old_files; then
    report_section 'brew-shellenv' 'self-heal log moved under ~/.local/state'
    keep_old_log "$old_brew_shellenv_log" "$kept_old_brew_shellenv_log"
    trash_old_file "$old_brew_shellenv_attempt_stamp"
  fi
}

keep_the_old_graphify_log() {
  if graphify_left_an_old_log; then
    report_section 'graphify' 'post-commit log moved under ~/.local/state'
    keep_old_log "$old_graphify_log" "$kept_old_graphify_log"
    trash_old_log_folder_once_empty "$old_graphify_log_directory"
  fi
}

main() {
  keep_the_old_brew_shellenv_log
  keep_the_old_graphify_log
}

main "$@"
{{ end -}}
