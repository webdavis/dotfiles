{{ if eq .chezmoi.os "darwin" -}}
#!/usr/bin/env bash

set -euo pipefail

{{ includeTemplate "cli-print-style-lib.sh.tmpl" }}

readonly moshi_hook="${MOSHI_HOOK_BIN:-/opt/homebrew/bin/moshi-hook}"
readonly moshi_hook_launchagent_label="homebrew.mxcl.moshi-hook"
readonly daemon_command_line="moshi-hook serve"
readonly approval_forwarding_subcommands=(claude-hook codex-hook)
readonly probe_payload_that_notifies_nobody='{}'
readonly gone_subcommand_reply="path does not exist"

moshi_hook_is_installed() {
  [[ -x $moshi_hook ]]
}

probe_subcommand() {
  local subcommand=$1
  # shellcheck disable=SC2069
  printf '%s' "$probe_payload_that_notifies_nobody" | "$moshi_hook" "$subcommand" 2>&1 >/dev/null || true
}

probe_reply_says_subcommand_is_gone() {
  local probe_reply=$1
  [[ $probe_reply == *"$gone_subcommand_reply"* ]]
}

report_gone_approval_forwarding_subcommands() {
  local subcommand harness probe_reply
  for subcommand in "${approval_forwarding_subcommands[@]}"; do
    harness="${subcommand%-hook}"
    probe_reply="$(probe_subcommand "$subcommand")"
    if probe_reply_says_subcommand_is_gone "$probe_reply"; then
      report_line "error[subcommand-gone]: the $subcommand subcommand is gone ($probe_reply). pns forwards every $harness approval to it, so approve and deny from the phone are DEAD for that harness until the name is corrected." >&2
    fi
  done
}

find_daemon_process_id() {
  pgrep -f "$daemon_command_line" 2>/dev/null | head -1 || true
}

daemon_is_running() {
  local daemon_process_id=$1
  [[ -n $daemon_process_id ]]
}

read_running_image_inode() {
  local process_id=$1
  lsof -p "$process_id" 2>/dev/null | awk '$4 == "txt" { print $(NF-1); exit }'
}

inode_was_read() {
  local inode=$1
  [[ -n $inode ]]
}

resolve_installed_moshi_hook() {
  readlink -f "$moshi_hook" 2>/dev/null || true
}

file_exists() {
  local file=$1
  [[ -e $file ]]
}

read_file_inode() {
  local file=$1
  stat -f '%i' "$file" 2>/dev/null || true
}

inode_is_a_number() {
  local inode=$1
  [[ -n $inode && $inode != *[!0-9]* ]]
}

daemon_runs_installed_binary() {
  local running_image_inode=$1 installed_binary_inode=$2
  [[ $running_image_inode == "$installed_binary_inode" ]]
}

restart_daemon_launchagent() {
  launchctl kickstart -k "gui/$(id -u)/$moshi_hook_launchagent_label"
}

main() {
  report_section 'moshi-hook' 'daemon restart after an upgrade'

  if ! moshi_hook_is_installed; then
    report_line "moshi-hook is not installed, skipping."
    return
  fi

  report_gone_approval_forwarding_subcommands

  local daemon_process_id
  daemon_process_id="$(find_daemon_process_id)"
  if ! daemon_is_running "$daemon_process_id"; then
    report_line "the daemon is not running, skipping."
    return
  fi

  local running_image_inode
  if ! running_image_inode="$(read_running_image_inode "$daemon_process_id")" || ! inode_was_read "$running_image_inode"; then
    report_line "error[unknown-image]: could not read the running image of process $daemon_process_id; not restarting a daemon whose state is unknown." >&2
    return
  fi

  local installed_binary
  installed_binary="$(resolve_installed_moshi_hook)"
  if ! file_exists "$installed_binary"; then
    report_line "could not resolve $moshi_hook to a file, skipping."
    return
  fi

  local installed_binary_inode
  installed_binary_inode="$(read_file_inode "$installed_binary")"
  if ! inode_was_read "$installed_binary_inode"; then
    report_line "could not read the inode of $installed_binary, skipping."
    return
  fi

  if ! inode_is_a_number "$running_image_inode" || ! inode_is_a_number "$installed_binary_inode"; then
    report_line "an inode is not a plain number (image $running_image_inode, on disk $installed_binary_inode), skipping."
    return
  fi
  if daemon_runs_installed_binary "$running_image_inode" "$installed_binary_inode"; then
    report_line "the daemon runs the installed binary, skipping."
    return
  fi

  report_line "the daemon runs a replaced binary (image $running_image_inode, on disk $installed_binary_inode); restarting it..."
  restart_daemon_launchagent
  report_line "restarted $moshi_hook_launchagent_label."
}

main "$@"
{{ end -}}
