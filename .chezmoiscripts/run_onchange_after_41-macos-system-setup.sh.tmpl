{{- define "shellSingleQuoted" }}{{ printf "'%s'" (replace "'" "'\\''" (toString .)) }}{{ end -}}

{{- define "validateTailscaleMagicdnsFallbackHosts" -}}
{{- $hostNameOwners := dict -}}
{{- range $hostIndex, $host := . -}}
{{- range $field := list "fqdn" "ip" "short" -}}
{{- if or (not (hasKey $host $field)) (kindIs "invalid" (index $host $field)) (eq (toString (index $host $field)) "") -}}
{{- fail (printf "macos_system_setup.yaml: a tailscale_magicdns_fallback_hosts entry is missing %s (or has it empty); every entry declares fqdn, ip and short" $field) -}}
{{- end -}}
{{- if not (kindIs "string" (index $host $field)) -}}
{{- fail (printf "macos_system_setup.yaml: tailscale_magicdns_fallback_hosts field %s is a %s, not a string; every field is one hosts column, so quote it in YAML" $field (kindOf (index $host $field))) -}}
{{- end -}}
{{- if regexMatch "[\\s#]" (toString (index $host $field)) -}}
{{- fail (printf "macos_system_setup.yaml: tailscale_magicdns_fallback_hosts field %s %q is not a single hosts column (whitespace splits the record, # truncates it)" $field (toString (index $host $field))) -}}
{{- end -}}
{{- end -}}
{{- range $nameField := list "fqdn" "short" -}}
{{- $hostName := toString (index $host $nameField) -}}
{{- if and (hasKey $hostNameOwners $hostName) (ne (index $hostNameOwners $hostName) $hostIndex) -}}
{{- fail (printf "macos_system_setup.yaml: tailscale_magicdns_fallback_hosts name %s %q is claimed by two entries; an entry OWNS both of its names, so the second would delete the first's record on every apply and one declared entry would never exist" $nameField $hostName) -}}
{{- end -}}
{{- $_ := set $hostNameOwners $hostName $hostIndex -}}
{{- end -}}
{{- end -}}
{{- end -}}

{{- define "validateSystemSetupRecord" -}}
{{- if or (not (hasKey . "description")) (kindIs "invalid" (index . "description")) (eq (toString (index . "description")) "") -}}
{{- fail "macos_system_setup.yaml: a record has no description; every record needs one, it is the identity in every error and trace line" -}}
{{- end -}}
{{- if not (hasKey . "tier") -}}
{{- fail (printf "macos_system_setup.yaml: record %q has no tier; declare tier: enforce, verify, or manual" .description) -}}
{{- end -}}
{{- if kindIs "invalid" (index . "tier") -}}
{{- fail (printf "macos_system_setup.yaml: record %q has a blank tier; declare tier: enforce, verify, or manual" .description) -}}
{{- end -}}
{{- $tier := toString (index . "tier") -}}
{{- if not (has $tier (list "enforce" "verify" "manual")) -}}
{{- fail (printf "macos_system_setup.yaml: unrecognized tier %q on record %q (expected enforce, verify, or manual)" $tier .description) -}}
{{- end -}}
{{- if eq $tier "enforce" -}}
{{- if or (not (hasKey . "command")) (kindIs "invalid" (index . "command")) (eq (toString (index . "command")) "") -}}
{{- fail (printf "macos_system_setup.yaml: enforce record %q has no command; an enforce control is a command, so declare one or change the tier" .description) -}}
{{- end -}}
{{- if hasKey . "runbook" -}}
{{- fail (printf "macos_system_setup.yaml: enforce record %q carries runbook; either drop the field or declare the tier that consumes it" .description) -}}
{{- end -}}
{{- else -}}
{{- if hasKey . "command" -}}
{{- fail (printf "macos_system_setup.yaml: %s record %q carries command, a mutating payload; the runner never runs a command for a %s control, so the declared tier is wrong" $tier .description $tier) -}}
{{- end -}}
{{- if hasKey . "sudo" -}}
{{- fail (printf "macos_system_setup.yaml: %s record %q carries sudo; sudo qualifies a command and a %s control has none" $tier .description $tier) -}}
{{- end -}}
{{- if eq $tier "manual" -}}
{{- if not (hasKey . "runbook") -}}
{{- fail (printf "macos_system_setup.yaml: manual record %q has no runbook; a manual control must name its runbook section" .description) -}}
{{- end -}}
{{- if kindIs "invalid" (index . "runbook") -}}
{{- fail (printf "macos_system_setup.yaml: manual record %q has a blank runbook; name the runbook section" .description) -}}
{{- end -}}
{{- if eq (toString (index . "runbook")) "" -}}
{{- fail (printf "macos_system_setup.yaml: manual record %q has an empty runbook; name the runbook section" .description) -}}
{{- end -}}
{{- end -}}
{{- end -}}
{{- end -}}

{{- if eq .chezmoi.os "darwin" -}}
{{- $records := .macos.system_setup -}}
{{- $fallbackHosts := index .macos "tailscale_magicdns_fallback_hosts" -}}
{{- template "validateTailscaleMagicdnsFallbackHosts" $fallbackHosts -}}
{{- range $records }}{{ template "validateSystemSetupRecord" . }}{{ end -}}
{{- $enforceRecordCount := 0 -}}
{{- range $records }}{{ if eq (toString (index . "tier")) "enforce" }}{{ $enforceRecordCount = add $enforceRecordCount 1 }}{{ end }}{{ end -}}
#!/usr/bin/env bash

set -euo pipefail
{{- if and (eq (len $records) 0) (not $fallbackHosts) }}

exit 0
{{- else }}

{{ includeTemplate "cli-print-style-lib.sh.tmpl" }}

refresh_sudo_credentials() {
  sudo -v
}

apply_system_setup_records() {
{{- range $records }}
{{- $tier := toString (index . "tier") }}
{{- if eq $tier "enforce" }}
  report_line {{ template "shellSingleQuoted" (printf "→ %s" .description) }}
  {{ if index . "sudo" }}sudo {{ end }}{{ .command }}
{{- else if eq $tier "manual" }}
  report_line {{ template "shellSingleQuoted" (printf "→ MANUAL %s: see the runbook section %s" .description (toString (index . "runbook"))) }}
{{- end }}
{{- end }}
  :
}
{{- if $fallbackHosts }}

tailnet_pin={{ joinPath .chezmoi.homeDir .rust_tools.install_dir "tailnet-pin" | quote }}
tailnet_pin_build_record="$HOME/.cache/tailnet-pin-build/installed.fingerprint"
current_tailnet_pin_source_fingerprint={{ includeTemplate "tailnet-pin-source-fingerprint.tmpl" . | sha256sum | quote }}

tailnet_pin_is_installed() {
  [[ -x $tailnet_pin ]]
}

tailnet_pin_build_record_exists() {
  [[ -r $tailnet_pin_build_record ]]
}

read_tailnet_pin_built_fingerprint() {
  cat "$tailnet_pin_build_record"
}

apply_tailscale_magicdns_fallback_hosts() {
  if ! tailnet_pin_is_installed; then
    report_line "error[missing-tool]: $tailnet_pin is missing or not executable; Tailscale MagicDNS fallback hosts were not applied. Run chezmoi apply so run_after_40 builds it." >&2
    exit 1
  fi

  if ! tailnet_pin_build_record_exists; then
    report_line "error[missing-file]: $tailnet_pin_build_record is missing, so nothing vouches for which source $tailnet_pin was built from; Tailscale MagicDNS fallback hosts were not applied." >&2
    exit 1
  fi

  local built_fingerprint
  built_fingerprint="$(read_tailnet_pin_built_fingerprint)"
  if [[ $built_fingerprint != "$current_tailnet_pin_source_fingerprint" ]]; then
    report_line "error[stale-build]: $tailnet_pin was built from source $built_fingerprint, not $current_tailnet_pin_source_fingerprint; Tailscale MagicDNS fallback hosts were not applied. Re-run chezmoi apply so the builder catches up." >&2
    exit 1
  fi
{{- range $fallbackHosts }}

  report_line {{ template "shellSingleQuoted" (printf "→ Tailscale MagicDNS fallback host: %s" (toString .fqdn)) }}
  sudo "$tailnet_pin" {{ template "shellSingleQuoted" .fqdn }} {{ template "shellSingleQuoted" .ip }} {{ template "shellSingleQuoted" .short }}
{{- end }}
}
{{- end }}

main() {
  report_section 'system setup' 'macOS settings that need admin rights'
{{- if or (gt $enforceRecordCount 0) $fallbackHosts }}
  refresh_sudo_credentials
{{- end }}
  apply_system_setup_records
{{- if $fallbackHosts }}
  apply_tailscale_magicdns_fallback_hosts
{{- end }}
}

main "$@"
{{- end }}
{{ end -}}
