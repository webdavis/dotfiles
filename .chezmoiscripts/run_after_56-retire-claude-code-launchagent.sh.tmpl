{{ if eq .chezmoi.os "darwin" -}}
#!/usr/bin/env bash

set -euo pipefail

{{ includeTemplate "cli-print-style-lib.sh.tmpl" }}

readonly launchagent_label="com.claude.code"
readonly launchagent_plist="$HOME/Library/LaunchAgents/$launchagent_label.plist"
readonly state_directory="$HOME/.local/state/claude-code-launchagent"
readonly retired_marker="$state_directory/retired"
readonly launchctl_print_status_not_found=113

retirement_is_complete() {
  [[ -f $retired_marker ]]
}

current_user_id() {
  id -u 2>/dev/null
}

user_id_is_numeric() {
  local user_id=$1
  [[ $user_id =~ ^[0-9]+$ ]]
}

print_launchd_service() {
  local service_target=$1
  launchctl print "$service_target" >/dev/null 2>&1
}

launchd_state_of() {
  local service_target=$1
  local status=0
  print_launchd_service "$service_target" || status=$?
  case "$status" in
    0) printf 'loaded' ;;
    "$launchctl_print_status_not_found") printf 'absent' ;;
    *) printf 'unknown' ;;
  esac
}

state_is_loaded() {
  local state=$1
  [[ $state == loaded ]]
}

state_is_absent() {
  local state=$1
  [[ $state == absent ]]
}

boot_out_service() {
  local service_target=$1
  launchctl bootout "$service_target" 2>/dev/null
}

report_launchd_state() {
  local state=$1 service_target=$2
  case "$state" in
    loaded)
      report_line "error[still-loaded]: $launchagent_label is STILL loaded after bootout; leaving the plist in place. Retire it by hand:  launchctl bootout $service_target" >&2
      ;;
    unknown)
      report_line "error[state-unknown]: could not confirm whether $launchagent_label is loaded (launchctl print returned an unexpected status, neither loaded=0 nor not-found=$launchctl_print_status_not_found); leaving the plist untouched. Check by hand:  launchctl print $service_target" >&2
      ;;
    absent)
      report_line "confirmed $launchagent_label is not loaded"
      ;;
  esac
}

plist_exists() {
  [[ -e $launchagent_plist ]]
}

delete_plist() {
  rm -f "$launchagent_plist" 2>/dev/null
}

remove_leftover_plist() {
  if ! plist_exists; then
    return
  fi
  if delete_plist; then
    report_line "removed leftover plist $launchagent_plist"
  else
    report_line "error[remove-failed]: could not remove the leftover plist $launchagent_plist; remove it by hand:  rm -f $launchagent_plist" >&2
  fi
}

write_retired_marker() {
  mkdir -p "$state_directory" 2>/dev/null && : >"$retired_marker" 2>/dev/null
}

record_retirement() {
  if write_retired_marker; then
    report_line "retirement complete; wrote quiescence marker $retired_marker"
  else
    report_line "error[marker-unwritable]: com.claude.code retirement converged but the quiescence marker $retired_marker could not be written (state dir unwritable?); NOT claiming completion. The next chezmoi apply will retry." >&2
  fi
}

main() {
  report_section 'claude-code' 'retire the old com.claude.code LaunchAgent'

  if retirement_is_complete; then
    report_line "already retired, skipping."
    return
  fi

  local user_id
  if ! user_id="$(current_user_id)" || ! user_id_is_numeric "$user_id"; then
    report_line "error[no-user-id]: id -u failed; cannot address the gui launchd domain. Retirement deferred; the next apply retries." >&2
    report_line "If the old agent is still loaded, retire it by hand:  launchctl bootout gui/<your-uid>/$launchagent_label" >&2
    return
  fi

  local service_target="gui/$user_id/$launchagent_label"
  local state
  state="$(launchd_state_of "$service_target")"
  if state_is_loaded "$state"; then
    if boot_out_service "$service_target"; then
      state="$(launchd_state_of "$service_target")"
    else
      report_line "error[bootout-failed]: bootout of $service_target failed; leaving the plist and NOT marking done (the next apply retries)." >&2
    fi
  fi
  report_launchd_state "$state" "$service_target"

  if state_is_absent "$state"; then
    remove_leftover_plist
  fi

  if state_is_absent "$state" && ! plist_exists; then
    record_retirement
  else
    report_line "error[retirement-incomplete]: com.claude.code retirement incomplete; NOT writing the marker. The next chezmoi apply will retry." >&2
  fi
}

main "$@"
{{ end -}}
