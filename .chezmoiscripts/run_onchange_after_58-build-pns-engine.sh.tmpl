{{ if eq .chezmoi.os "darwin" -}}
{{ $pns := joinPath .chezmoi.sourceDir "pns" -}}
#!/usr/bin/env bash

set -euo pipefail

{{ range $pattern := list "crates/*/src/**/*" "crates/*/tests/**/*" "crates/*/fixtures/**/*" "crates/*/build.rs" -}}
{{ range (glob (joinPath $pns $pattern)) -}}
{{ if not (stat .).isDir -}}
# {{ . }} {{ include . | sha256sum }}
{{ end -}}
{{ end -}}
{{ end -}}
# Cargo.toml {{ include (joinPath $pns "Cargo.toml") | sha256sum }}
# Cargo.lock {{ include (joinPath $pns "Cargo.lock") | sha256sum }}
# rust-toolchain.toml {{ include (joinPath $pns "rust-toolchain.toml") | sha256sum }}
{{ range (glob (joinPath $pns "crates/*/Cargo.toml")) -}}
# {{ . }} {{ include . | sha256sum }}
{{ end -}}
{{ range (glob (printf "%s/.rustup/toolchains/*/bin/rustc" (env "HOME"))) -}}
# {{ . }} {{ (stat .).modTime }}
{{ end -}}
# retry-marker: {{ $retryMarker := printf "%s/.cache/pns-build/engine.retry" (env "HOME") }}{{ if stat $retryMarker }}{{ (stat $retryMarker).modTime }}{{ else }}settled{{ end }}

{{ includeTemplate "cli-print-style-lib.sh.tmpl" }}
{{ includeTemplate "rust-build-lib.sh.tmpl" }}
{{ includeTemplate "build-record-lib.sh.tmpl" }}

readonly pns_workspace_dir={{ $pns | quote }}
readonly built_pns="$pns_workspace_dir/target/release/pns"
readonly install_dir={{ joinPath .chezmoi.homeDir .rust_tools.install_dir | quote }}
readonly installed_pns="$install_dir/pns"
readonly pns_build_record="$HOME/.local/state/pns-build-record"
readonly pns_max_artifact_bytes={{ .rust_tools.max_artifact_bytes.pns }}
readonly pns_retry_marker="$HOME/.cache/pns-build/engine.retry"
readonly restart_pending_marker="$HOME/.cache/pns-build/restart-pending"
readonly daemon_label='com.webdavis.pns-daemon'
readonly receiver_label='com.webdavis.pns-github-receiver'
readonly launchctl_service_not_found_status=113
readonly installed_pns_absent='absent'
readonly installed_pns_identical='identical'
readonly installed_pns_different='different'

build_record_path_is_taken() {
  [[ -e $pns_build_record || -L $pns_build_record ]]
}

build_record_is_a_plain_file() {
  [[ -f $pns_build_record && ! -L $pns_build_record ]]
}

build_record_is_nonregular() {
  build_record_path_is_taken && ! build_record_is_a_plain_file
}

pns_is_installed() {
  [[ -f $installed_pns ]]
}

installed_pns_matches_build() {
  cmp -s "$built_pns" "$installed_pns"
}

compare_installed_pns_with_build() {
  if ! pns_is_installed; then
    printf '%s' "$installed_pns_absent"
  elif installed_pns_matches_build; then
    printf '%s' "$installed_pns_identical"
  else
    printf '%s' "$installed_pns_different"
  fi
}

build_changes_installed_pns() {
  local installed_pns_state=$1
  [[ $installed_pns_state != "$installed_pns_identical" ]]
}

this_is_the_first_install() {
  local installed_pns_state=$1
  [[ $installed_pns_state == "$installed_pns_absent" ]]
}

arm_restart_pending_marker() {
  mkdir -p "$(dirname "$restart_pending_marker")"
  touch "$restart_pending_marker"
}

restart_is_pending() {
  [[ -e $restart_pending_marker ]]
}

restart_is_owed() {
  local installed_pns_state=$1
  build_changes_installed_pns "$installed_pns_state" || restart_is_pending
}

clear_restart_pending_marker() {
  rm -f "$restart_pending_marker"
}

kickstart_job() {
  local label=$1
  launchctl kickstart -k "gui/$(id -u)/$label"
}

kickstart_succeeded() {
  local kickstart_status=$1
  ((kickstart_status == 0))
}

job_is_not_loaded_on_first_install() {
  local kickstart_status=$1 installed_pns_state=$2
  ((kickstart_status == launchctl_service_not_found_status)) && this_is_the_first_install "$installed_pns_state"
}

restart_job() {
  local label=$1 job_name=$2 installed_pns_state=$3
  local kickstart_output kickstart_status=0
  kickstart_output="$(kickstart_job "$label" 2>&1)" || kickstart_status=$?
  if kickstart_succeeded "$kickstart_status"; then
    report_line "restarted the $job_name on the new binary."
    return 0
  fi
  if job_is_not_loaded_on_first_install "$kickstart_status" "$installed_pns_state"; then
    return 0
  fi
  report_line "error[restart-failed]: the $job_name was not restarted on the new binary (launchctl kickstart exited $kickstart_status: $kickstart_output)." >&2
  return 1
}

restart_pns_jobs() {
  local installed_pns_state=$1
  local restart_status=0
  restart_job "$daemon_label" daemon "$installed_pns_state" || restart_status=1
  restart_job "$receiver_label" receiver "$installed_pns_state" || restart_status=1
  return "$restart_status"
}

main() {
  make_new_files_private
  report_section 'pns engine' 'notification daemon and GitHub receiver'

  if ! cargo_is_installed; then
    report_line "cargo not found at $cargo_bin; engine build deferred to the next apply." >&2
    increment_retry_attempts "$pns_retry_marker"
    exit 0
  fi

  report_line "building the release binary..."
  local build_status=0
  build_release_binary "$pns_workspace_dir" pns || build_status=$?
  if build_failed "$build_status"; then
    report_line "error[build-failed]: pns did not build; see cargo's output above." >&2
    exit "$build_status"
  fi
  report_line "built $built_pns."

  local artifact_bytes
  artifact_bytes="$(artifact_size_in_bytes "$built_pns")"
  if ! artifact_size_is_allowed "$artifact_bytes" "$pns_max_artifact_bytes"; then
    report_line "error[artifact-size]: refusing a pns artifact of $artifact_bytes bytes (allowed 1..$pns_max_artifact_bytes)." >&2
    exit 1
  fi

  local artifact_hash
  artifact_hash="$(artifact_sha256 "$built_pns")"
  if ! is_a_sha256_digest "$artifact_hash"; then
    report_line "error[invalid-digest]: shasum printed no sha256 digest for $built_pns." >&2
    exit 1
  fi

  local compiler
  compiler="$(compiler_version "$pns_workspace_dir")"

  if build_record_is_nonregular; then
    report_line "error[nonregular-record]: refusing $pns_build_record, which is not a regular file." >&2
    exit 1
  fi

  create_temporary_build_records "$pns_build_record"
  write_next_build_record "$artifact_hash" "$artifact_bytes" "$compiler"

  local installed_pns_state
  installed_pns_state="$(compare_installed_pns_with_build)"
  create_install_directory "$install_dir"
  if build_changes_installed_pns "$installed_pns_state"; then
    arm_restart_pending_marker
  fi

  if build_is_already_published "$built_pns" "$installed_pns" "$pns_build_record"; then
    keep_build_record_private "$pns_build_record"
  else
    report_line "refreshing the pipeline manifest..."
    save_previous_build_record "$pns_build_record"
    publish_next_build_record "$pns_build_record"
    if ! refresh_pipeline_manifest; then
      roll_back_build_record "$pns_build_record"
      report_line "error[manifest-refresh-failed]: the pipeline manifest was not refreshed; the installed pns is unchanged." >&2
      exit 1
    fi
    report_line "refreshed the pipeline manifest."
  fi

  report_line "installing the release binary..."
  install_release_binary "$built_pns" "$installed_pns"
  report_line "installed $installed_pns."

  if restart_is_owed "$installed_pns_state"; then
    if ! restart_pns_jobs "$installed_pns_state"; then
      exit 1
    fi
    clear_restart_pending_marker
  fi

  settle_retry_marker "$pns_retry_marker"
}

main "$@"
{{ end -}}
