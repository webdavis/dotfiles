{{ if eq .chezmoi.os "darwin" -}}
#!/usr/bin/env bash

set -euo pipefail

{{ includeTemplate "cli-print-style-lib.sh.tmpl" }}

readonly ytdlp_binary="$HOME/.local/bin/yt-dlp"
readonly ytdlp_download_url="https://github.com/yt-dlp/yt-dlp/releases/latest/download/yt-dlp_macos"
readonly bgutil_repository="$HOME/.local/share/yt-dlp/bgutil-ytdlp-pot-provider"
readonly bgutil_repository_url="https://github.com/Brainicism/bgutil-ytdlp-pot-provider.git"
readonly bgutil_latest_release_api_url="https://api.github.com/repos/Brainicism/bgutil-ytdlp-pot-provider/releases/latest"
readonly bgutil_server="$bgutil_repository/server"
readonly npm_packages_allowed_to_run_build_scripts="npm:canvas,npm:@swc/core"
readonly bgutil_plugin_url="https://github.com/Brainicism/bgutil-ytdlp-pot-provider/releases/latest/download/bgutil-ytdlp-pot-provider.zip"
readonly bgutil_plugin_zip="$HOME/.config/yt-dlp/plugins/bgutil-ytdlp-pot-provider.zip"
readonly provider_launchagent_label="com.webdavis.yt-dlp-pot-provider"
readonly provider_launchagent_plist="$HOME/Library/LaunchAgents/$provider_launchagent_label.plist"
readonly provider_log_directory="$HOME/.local/log/yt-dlp"

deno_is_installed() {
  command -v deno &>/dev/null
}

jq_is_installed() {
  command -v jq &>/dev/null
}

fetch_url_into_file() {
  local url=$1 file=$2
  curl --proto '=https' --tlsv1.2 -L --fail --retry 3 -s -o "$file" "$url"
}

download_file() {
  local url=$1 destination=$2
  local temp_file
  temp_file="$(mktemp)"
  if ! fetch_url_into_file "$url" "$temp_file"; then
    rm -f "$temp_file"
    return 1
  fi
  mkdir -p "$(dirname "$destination")"
  mv "$temp_file" "$destination"
}

ytdlp_is_installed() {
  [[ -x $ytdlp_binary ]]
}

make_ytdlp_executable() {
  chmod a+rx "$ytdlp_binary"
}

switch_ytdlp_to_nightly_channel() {
  "$ytdlp_binary" --update-to nightly
}

install_nightly_ytdlp() {
  if ytdlp_is_installed; then
    return
  fi

  report_line "installing yt-dlp..."
  if ! download_file "$ytdlp_download_url" "$ytdlp_binary"; then
    report_line "error[download-failed]: could not download yt-dlp." >&2
    return
  fi
  make_ytdlp_executable || true
  report_line "installed $ytdlp_binary."

  report_line "switching yt-dlp to the nightly channel..."
  if ! switch_ytdlp_to_nightly_channel; then
    report_line "error[nightly-switch-failed]: yt-dlp could not switch to the nightly channel." >&2
    return
  fi
  report_line "switched yt-dlp to the nightly channel."
}

bgutil_server_is_built() {
  [[ -d $bgutil_server/node_modules ]]
}

fetch_latest_bgutil_release_tag() {
  curl -sf "$bgutil_latest_release_api_url" | jq -r .tag_name 2>/dev/null
}

release_tag_is_known() {
  local release_tag=$1
  [[ -n $release_tag ]]
}

bgutil_repository_is_cloned() {
  [[ -d $bgutil_repository ]]
}

clone_bgutil_repository() {
  local release_tag=$1
  mkdir -p "$(dirname "$bgutil_repository")"
  git clone --single-branch --branch "$release_tag" "$bgutil_repository_url" "$bgutil_repository" 2>/dev/null
}

build_bgutil_server() {
  (cd "$bgutil_server" && deno install --allow-scripts="$npm_packages_allowed_to_run_build_scripts" --frozen)
}

install_bgutil_server() {
  if bgutil_server_is_built; then
    return
  fi

  local release_tag
  release_tag="$(fetch_latest_bgutil_release_tag)" || true
  if ! release_tag_is_known "$release_tag"; then
    report_line "error[release-lookup-failed]: could not fetch the latest bgutil release tag." >&2
    return
  fi

  if ! bgutil_repository_is_cloned; then
    report_line "cloning bgutil-ytdlp-pot-provider $release_tag..."
    if ! clone_bgutil_repository "$release_tag"; then
      report_line "error[clone-failed]: could not clone the bgutil repository." >&2
      return
    fi
    report_line "cloned $bgutil_repository."
  fi

  report_line "building the PO token server..."
  if ! build_bgutil_server; then
    report_line "error[build-failed]: the PO token server did not build." >&2
    return
  fi
  report_line "built the PO token server."
}

bgutil_plugin_is_downloaded() {
  [[ -f $bgutil_plugin_zip ]]
}

download_bgutil_plugin() {
  if bgutil_plugin_is_downloaded; then
    return
  fi

  report_line "downloading the bgutil plugin..."
  if ! download_file "$bgutil_plugin_url" "$bgutil_plugin_zip"; then
    report_line "error[download-failed]: could not download the bgutil plugin." >&2
    return
  fi
  report_line "downloaded $bgutil_plugin_zip."
}

provider_launchagent_plist_is_deployed() {
  [[ -f $provider_launchagent_plist ]]
}

create_provider_log_directory() {
  mkdir -p "$provider_log_directory"
}

provider_launchagent_is_loaded() {
  launchctl list "$provider_launchagent_label" &>/dev/null
}

user_gui_domain() {
  printf 'gui/%s' "$(id -u)"
}

bootstrap_provider_launchagent() {
  launchctl bootstrap "$(user_gui_domain)" "$provider_launchagent_plist" 2>/dev/null
}

load_provider_launchagent() {
  report_line "loading the PO token provider LaunchAgent..."
  if bootstrap_provider_launchagent; then
    report_line "loaded the PO token provider LaunchAgent."
  fi
}

everything_is_installed() {
  ytdlp_is_installed && bgutil_server_is_built && bgutil_plugin_is_downloaded
}

main() {
  report_section 'yt-dlp' 'yt-dlp and its YouTube PO token provider'

  if ! deno_is_installed || ! jq_is_installed; then
    report_line "deno or jq is not installed yet, skipping."
    return
  fi

  if everything_is_installed && provider_launchagent_plist_is_deployed; then
    create_provider_log_directory || true
    if provider_launchagent_is_loaded; then
      report_line "everything up to date, skipping."
    else
      load_provider_launchagent
    fi
    return
  fi

  install_nightly_ytdlp
  install_bgutil_server
  download_bgutil_plugin

  if ! provider_launchagent_plist_is_deployed; then
    report_line "error[missing-plist]: $provider_launchagent_plist is not deployed; the PO token provider LaunchAgent was not loaded." >&2
    exit 1
  fi
  create_provider_log_directory || true
  if ! provider_launchagent_is_loaded; then
    load_provider_launchagent
  fi
}

main "$@"
{{ end -}}
