#!/usr/bin/env bash

set -euo pipefail

{{ includeTemplate "cli-print-style-lib.sh.tmpl" }}

readonly codegraph_installer_url="https://raw.githubusercontent.com/colbymchenry/codegraph/main/install.sh"

download_codegraph_installer() {
  curl -fsSL "$codegraph_installer_url"
}

run_codegraph_installer() {
  local installer=$1
  sh <<<"$installer"
}

main() {
  report_section 'codegraph' 'code index for coding agents'

  report_line "installing from the release bundle..."
  local installer
  if ! installer="$(download_codegraph_installer)"; then
    report_line "error[download-failed]: could not download $codegraph_installer_url; CodeGraph was not installed." >&2
    return
  fi
  run_codegraph_installer "$installer"
  report_line "installed CodeGraph."
}

main "$@"
