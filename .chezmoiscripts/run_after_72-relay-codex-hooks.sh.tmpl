{{ if eq .chezmoi.os "darwin" -}}
#!/bin/bash
# Wire pns's Codex notifications into ~/.codex/hooks.json on every apply
# (idempotent; re-heals after herdr re-installs its integration). The merge
# lives in the engine itself, as `pns codex install-hooks`. Runs after the
# 60-series moshi-hook setup (which strips Codex from moshi-hook) so pns owns
# Codex's pushes.
set -euo pipefail
engine={{ joinPath .chezmoi.homeDir .rust_tools.install_dir "pns" | quote }}
if [[ -x $engine ]]; then
  # A refusal is a printed warning rather than a failed apply: the engine
  # leaves an unreadable hooks file untouched and says so.
  "$engine" codex install-hooks || true
fi
{{ end -}}
