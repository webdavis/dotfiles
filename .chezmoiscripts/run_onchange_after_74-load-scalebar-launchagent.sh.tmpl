{{ if eq .chezmoi.os "darwin" -}}
#!/usr/bin/env bash
# plist hash: {{ include "Library/LaunchAgents/com.webdavis.scalebar.plist.tmpl" | sha256sum }}
# build-retry-marker: {{ $retryMarker := printf "%s/.cache/scalebar-build/scalebar.retry" (env "HOME") }}{{ if stat $retryMarker }}{{ (stat $retryMarker).modTime }}{{ else }}settled{{ end }}
# binary: {{ $scalebarBinary := printf "%s/%s/Scalebar" (env "HOME") .scalebar.install_dir }}{{ if stat $scalebarBinary }}{{ (stat $scalebarBinary).modTime }}{{ else }}absent{{ end }}

set -euo pipefail

{{ includeTemplate "cli-print-style-lib.sh.tmpl" }}

{{ includeTemplate "load-launchagent.sh.tmpl" }}

readonly scalebar_binary={{ joinPath .chezmoi.homeDir .scalebar.install_dir "Scalebar" | quote }}
readonly launchagent_label="com.webdavis.scalebar"
readonly launchagent_plist="$HOME/Library/LaunchAgents/$launchagent_label.plist"
readonly launchagent_log_directory="$HOME/.local/log/scalebar"

scalebar_is_installed() {
  [[ -x $scalebar_binary ]]
}

main() {
  report_section 'scalebar' 'menu-bar app LaunchAgent'

  if ! scalebar_is_installed; then
    report_line "$scalebar_binary is missing or not executable, so the LaunchAgent was left exactly as it is; the build is deferred to the next apply." >&2
    exit 0
  fi

  create_launchagent_log_directory "$launchagent_log_directory"
  report_line "reloading..."
  reload_launchagent "$launchagent_label" "$launchagent_plist"
  report_line "loaded."
}

main "$@"
{{ end -}}
