{{ if eq .chezmoi.os "darwin" -}}
#!/usr/bin/env bash

set -euo pipefail

{{ includeTemplate "cli-print-style-lib.sh.tmpl" }}

readonly pns_bin={{ joinPath .chezmoi.homeDir ".cargo/bin" "pns" | quote }}
readonly codex_hooks_file="$HOME/.codex/hooks.json"
readonly -a omp_agent_folders=("$HOME/.omp/agent" "$HOME/.omp/profiles/broccoli/agent")
readonly reminder_extension_pns_replaces="extensions/pns-reminders.ts"

pns_is_installed() {
  [[ -x $pns_bin ]]
}

merge_pns_hooks_into_codex() {
  "$pns_bin" install-hooks codex
}

install_pns_extension_into_omp() {
  local omp_agent_folder=$1
  PI_CODING_AGENT_DIR="$omp_agent_folder" "$pns_bin" install-hooks omp
}

trash_reminder_extension_pns_replaces() {
  local reminder_extension="$1/$reminder_extension_pns_replaces"
  if [[ -e $reminder_extension ]]; then
    trash "$reminder_extension"
  fi
}

install_codex_hooks() {
  report_line "merging pns's hooks into $codex_hooks_file..."
  if ! merge_pns_hooks_into_codex; then
    report_line "error[hooks-not-merged]: pns did not merge its hooks into $codex_hooks_file; see its message above." >&2
    return
  fi
  report_line "merged pns's hooks into $codex_hooks_file."
}

install_omp_extension() {
  local omp_agent_folder=$1
  report_line "installing pns's extension into $omp_agent_folder..."
  if ! install_pns_extension_into_omp "$omp_agent_folder"; then
    report_line "error[extension-not-installed]: pns did not install its extension into $omp_agent_folder, so the reminder extension it replaces was left in place; see its message above." >&2
    return
  fi
  trash_reminder_extension_pns_replaces "$omp_agent_folder"
  report_line "installed pns's extension into $omp_agent_folder."
}

main() {
  report_section 'pns' 'Codex hooks and omp extensions'

  if ! pns_is_installed; then
    report_line "pns is not installed, skipping."
    return
  fi

  install_codex_hooks

  local omp_agent_folder
  for omp_agent_folder in "${omp_agent_folders[@]}"; do
    install_omp_extension "$omp_agent_folder"
  done
}

main "$@"
{{ end -}}
