{{ if eq .chezmoi.os "darwin" -}}
#!/usr/bin/env bash
# .chezmoidata/system_packages_autoinstall.yaml {{ include ".chezmoidata/system_packages_autoinstall.yaml" | sha256sum }}
# retry-marker: {{ $retry := joinPath (env "HOME") ".cache/cargo-git-tools/retry" }}{{ if stat $retry }}{{ (stat $retry).modTime }}{{ else }}settled{{ end }}

set -euo pipefail

{{ includeTemplate "cli-print-style-lib.sh.tmpl" }}

readonly uu_binary={{ joinPath .chezmoi.homeDir ".cargo/bin" "uu" | quote }}

uu_is_installed() {
  [[ -x $uu_binary ]]
}

install_uu_daemon() {
  "$uu_binary" daemon install
}

main() {
  report_section 'uu' 'daemon'

  if ! uu_is_installed; then
    report_line "$uu_binary is missing or not executable, so the daemon was left as it is; the install is deferred to the next apply." >&2
    exit 0
  fi

  if ! install_uu_daemon; then
    report_line "error[install-failed]: uu daemon install failed; the next apply retries." >&2
    exit 1
  fi
}

main "$@"
{{ end -}}
