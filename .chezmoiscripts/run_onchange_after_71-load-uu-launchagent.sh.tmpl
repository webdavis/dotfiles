#!/bin/bash
# run_onchange_after_71-load-uu-launchagent.sh
# plist hash: {{ include "Library/LaunchAgents/com.webdavis.uu.plist.tmpl" | sha256sum }}
#
# THE BUILDER'S RETRY MARKER IS PART OF THIS SCRIPT'S CONTENT, so a loader that
# refused for want of a binary re-fires once the build state changes. chezmoi
# records a run_onchange script as done on ANY exit 0, and the refusal below
# exits 0 on purpose, so without this line the first apply on a machine with no
# toolchain would record the loader as done and the job would never be
# bootstrapped. The marker's MODIFICATION TIME is the trigger, never its
# contents, for the reason the builder states: reading a file at render time
# means an unreadable node aborts the apply.
#   build-retry-marker: {{ $rm := printf "%s/.cache/uu-build/uu.retry" (env "HOME") }}{{ if stat $rm }}{{ (stat $rm).modTime }}{{ else }}settled{{ end }}

{{- if eq .chezmoi.os "darwin" }}
set -euo pipefail

UU="$HOME/.local/libexec/uu/uu"

# THE BINARY IS THE PRECONDITION, and it is not guaranteed: the builder beside
# this one defers on a machine without cargo or without the crate source, and
# exits 0 so the apply carries on. Booting the current job out and bootstrapping
# a plist that points at nothing would leave the machine with NO updater until
# some later apply; refusing leaves the job that is already loaded running.
if [[ ! -x $UU ]]; then
  printf 'uu: %s is missing or not executable, so the LaunchAgent was left exactly as it is; the build is deferred to the next apply.\n' "$UU" >&2
  exit 0
fi

# launchd will not create the log dir itself.
mkdir -p "$HOME/.local/log/uu"

PLIST="$HOME/Library/LaunchAgents/com.webdavis.uu.plist"
TARGET="gui/$(id -u)/com.webdavis.uu"

# Re-bootstrap so a changed plist takes effect; launchd sometimes answers EIO
# right after a bootout, so retry silently before surfacing the real error.
launchctl bootout "$TARGET" 2>/dev/null || true

for _ in 1 2 3; do
  if launchctl bootstrap "gui/$(id -u)" "$PLIST" 2>/dev/null; then
    exit 0
  fi
  sleep 1
done

launchctl bootstrap "gui/$(id -u)" "$PLIST"
{{- end }}
