{{- define "shellSingleQuoted" }}{{ printf "'%s'" (replace "'" "'\\''" (toString .)) }}{{ end -}}

{{- define "validateMagicdnsFallbackHosts" -}}
{{- $hostNameOwners := dict -}}
{{- range $hostIndex, $host := . -}}
{{- range $field := list "fqdn" "ip" "short" -}}
{{- if or (not (hasKey $host $field)) (kindIs "invalid" (index $host $field)) (eq (toString (index $host $field)) "") -}}
{{- fail (printf "tailscale.yaml: a magicdns_fallback_hosts entry is missing %s (or has it empty); every entry declares fqdn, ip and short" $field) -}}
{{- end -}}
{{- if not (kindIs "string" (index $host $field)) -}}
{{- fail (printf "tailscale.yaml: magicdns_fallback_hosts field %s is a %s, not a string; every field is one hosts column, so quote it in YAML" $field (kindOf (index $host $field))) -}}
{{- end -}}
{{- if regexMatch "[\\s#]" (toString (index $host $field)) -}}
{{- fail (printf "tailscale.yaml: magicdns_fallback_hosts field %s %q is not a single hosts column (whitespace splits the record, # truncates it)" $field (toString (index $host $field))) -}}
{{- end -}}
{{- end -}}
{{- range $nameField := list "fqdn" "short" -}}
{{- $hostName := toString (index $host $nameField) -}}
{{- if and (hasKey $hostNameOwners $hostName) (ne (index $hostNameOwners $hostName) $hostIndex) -}}
{{- fail (printf "tailscale.yaml: magicdns_fallback_hosts name %s %q is claimed by two entries; an entry OWNS both of its names, so the second would delete the first's record on every apply and one declared entry would never exist" $nameField $hostName) -}}
{{- end -}}
{{- $_ := set $hostNameOwners $hostName $hostIndex -}}
{{- end -}}
{{- end -}}
{{- end -}}

{{- if eq .chezmoi.os "darwin" -}}
{{- $hosts := .tailscale.magicdns_fallback_hosts -}}
{{- template "validateMagicdnsFallbackHosts" $hosts -}}
{{- $tailnetPin := joinPath .chezmoi.homeDir .rust_tools.install_dir "tailnet-pin" -}}
#!/usr/bin/env bash

set -euo pipefail

# tailnet-pin: {{ if stat $tailnetPin }}installed{{ else }}missing{{ end }}

{{ includeTemplate "cli-print-style-lib.sh.tmpl" }}

{{ includeTemplate "sudo-session.sh.tmpl" }}

readonly tailnet_pin={{ $tailnetPin | quote }}

tailnet_pin_is_installed() {
  [[ -x $tailnet_pin ]]
}

pin_host() {
  local fqdn=$1 ip=$2 short=$3
  report_line "→ $fqdn"
  sudo "$tailnet_pin" "$fqdn" "$ip" "$short"
}

main() {
  report_section 'tailscale' 'MagicDNS fallback hosts in /etc/hosts'

  if ! tailnet_pin_is_installed; then
    report_line "$tailnet_pin is not installed, skipping."
    return
  fi

  authenticate_sudo_once
{{- range $hosts }}
  pin_host {{ template "shellSingleQuoted" .fqdn }} {{ template "shellSingleQuoted" .ip }} {{ template "shellSingleQuoted" .short }}
{{- end }}
  report_line "pinned."
}

main "$@"
{{- end }}
