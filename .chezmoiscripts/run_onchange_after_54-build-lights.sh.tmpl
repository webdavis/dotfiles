{{ if eq .chezmoi.os "darwin" -}}
#!/bin/bash
set -euo pipefail
{{ $lights := joinPath .chezmoi.sourceDir "lights" -}}
{{ range (glob (joinPath $lights "**/*.rs")) }}
# {{ . }} {{ include . | sha256sum }}
{{- end }}
# Cargo.toml {{ include (joinPath $lights "Cargo.toml") | sha256sum }}
# Cargo.lock {{ include (joinPath $lights "Cargo.lock") | sha256sum }}
{{- range (glob (joinPath $lights "crates/*/Cargo.toml")) }}
# {{ . }} {{ include . | sha256sum }}
{{- end }}
# A deferred zero-exit build must change the next rendered script to retry.
# retry-marker: {{ $retry := joinPath (env "HOME") ".cache/lights-build/lights.retry" }}{{ if stat $retry }}{{ (stat $retry).modTime }}{{ else }}settled{{ end }}

{{ includeTemplate "cli-print-style-lib.sh.tmpl" }}

# Repository SOURCE at the monorepo root, never a deploy target, so the build
# reads the chezmoi source directory rather than a copy under $HOME.
crate_dir={{ $lights | quote }}
install_dir={{ joinPath .chezmoi.homeDir .rust_tools.install_dir | quote }}
cargo_bin="$HOME/.cargo/bin/cargo"
retry_marker="$HOME/.cache/lights-build/lights.retry"

if [[ ! -x $cargo_bin ]]; then
  # NAMED IN THE LINE ITSELF, because a deferral prints no section above it and
  # goes to stderr, where it can land anywhere in the apply's output.
  report_line 'lights: cargo not found at ~/.cargo/bin/cargo; build deferred to the next apply.' >&2
  mkdir -p "$(dirname "$retry_marker")"
  touch "$retry_marker"
  exit 0
fi

report_section 'lights'
report_line 'building the release binary'
cd "$crate_dir" || exit
"$cargo_bin" build --release --locked --quiet --bin lights
mkdir -p "$install_dir"
/usr/bin/install -m 755 "$crate_dir/target/release/lights" "$install_dir/lights"
report_line "installed $install_dir/lights"
{{ end -}}
