{{ if eq .chezmoi.os "darwin" -}}
{{ $lights := joinPath .chezmoi.sourceDir "lights" -}}
#!/usr/bin/env bash

set -euo pipefail

{{ range $pattern := list "crates/*/src/**/*" "crates/*/tests/**/*" "crates/*/fixtures/**/*" "crates/*/build.rs" -}}
{{ range (glob (joinPath $lights $pattern)) -}}
{{ if not (stat .).isDir -}}
# {{ . }} {{ include . | sha256sum }}
{{ end -}}
{{ end -}}
{{ end -}}
# Cargo.toml {{ include (joinPath $lights "Cargo.toml") | sha256sum }}
# Cargo.lock {{ include (joinPath $lights "Cargo.lock") | sha256sum }}
{{ range (glob (joinPath $lights "crates/*/Cargo.toml")) -}}
# {{ . }} {{ include . | sha256sum }}
{{ end -}}
# retry-marker: {{ $retry := joinPath (env "HOME") ".cache/lights-build/lights.retry" }}{{ if stat $retry }}{{ (stat $retry).modTime }}{{ else }}settled{{ end }}

{{ includeTemplate "cli-print-style-lib.sh.tmpl" }}
{{ includeTemplate "rust-build-lib.sh.tmpl" }}

readonly lights_source_dir={{ $lights | quote }}
readonly built_lights="$lights_source_dir/target/release/lights"
readonly install_dir={{ joinPath .chezmoi.homeDir .rust_tools.install_dir | quote }}
readonly installed_lights="$install_dir/lights"
readonly lights_retry_marker="$HOME/.cache/lights-build/lights.retry"

main() {
  report_section 'lights' 'keyboard light control'

  if ! cargo_is_installed; then
    report_line "cargo not found at $cargo_bin; build deferred to the next apply." >&2
    defer_build_until_next_apply "$lights_retry_marker"
    exit 0
  fi

  report_line "building the release binary..."
  local build_status=0
  build_release_binary "$lights_source_dir" lights || build_status=$?
  if build_failed "$build_status"; then
    report_line "error[build-failed]: lights did not build; see cargo's output above." >&2
    exit "$build_status"
  fi
  report_line "built $built_lights."

  report_line "installing the release binary..."
  install_release_binary "$built_lights" "$installed_lights"
  report_line "installed $installed_lights."
}

main "$@"
{{ end -}}
