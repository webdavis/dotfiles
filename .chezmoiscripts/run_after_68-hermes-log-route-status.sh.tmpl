{{ if eq .chezmoi.os "darwin" -}}
#!/bin/bash
# Reminder, NOT an auto-restart: if ~/.hermes/config.yaml is missing a webhook route this machine
# depends on, carries one with no secret or no channel, still carries one this repository does not
# declare, or defines one the running gateway returns 404 for, say so. Mirrors run_onchange_after_66
# (tailscaled-status) -- a sudo-free, side-effect-free status nudge. We deliberately do NOT auto-restart:
# `hermes gateway restart` drains in-flight runs (up to 180s) and the routes change ~never, so you
# restart deliberately. (A secret rotation answers 401 rather than 404, and a restart does not fix that,
# so 401 is deliberately not reported here as a restart-me condition.)
#
# It runs in the AFTER phase, which is what makes the check meaningful: by then chezmoi has rendered
# private_dot_hermes/modify_private_config.yaml.tmpl over ~/.hermes/config.yaml and
# run_after_59-hermes-config-migrate has migrated it forward to the installed hermes version's schema,
# so the file this reads is the one the next gateway start will load. It is also the only thing that
# sees the VALUES: the routes are rendered from KeePassXC at apply time, so nothing in git can be
# checked instead.
#
# SIX routes are checked, because they fail differently and most of them fail quietly:
#   general               the catch-all channel. No producer in this repository posts to it today; it is
#                         declared so an ad-hoc POST has a signed route rather than borrowing another.
#   pns                   agent events. One that never arrives is usually noticed anyway, because
#                         whatever it was about is still open.
#   priority              machine health and security, plus the stale-block escalation.
#   posture               every page the osquery pipeline raises, plus its daily digest and heartbeat.
#   uu                    the weekly RECORD from the unattended jobs. A record that never arrives looks
#                         exactly like a healthy job with nothing to say, so nothing ever prompts anyone
#                         to look.
#   pns-recap             the return recap.
# For the quiet ones this check is the only thing standing between a mistyped or unapplied route and a
# channel that stays empty forever.
# Keep this list in step with the route names the producers spell: DEFAULT_RECORD_URL in
# uu/crates/uu-adapters/src/config/records.rs, severity_route in
# posture/crates/posture-domain/src/severity.rs, and RECAP_ROUTE in
# pns/crates/pns-application/src/post_return_recap.rs.
#
# THE PER-ROUTE KEY COMPARISON IS GONE. Every route used to be required to carry the ONE secret pns
# signs with, and this script compared the other four against the pns route's value. The routes now
# carry six DIFFERENT secrets, one KeePassXC entry each, so there is nothing left to compare a route
# against: agreement is between the vault entry a route renders from and the key its senders hold, and
# neither of those is in this file. What is checkable here is that a secret and a channel are PRESENT,
# which is what the two value checks below do, by shape and never by value.
set -euo pipefail
cfg="$HOME/.hermes/config.yaml"
command -v yq >/dev/null 2>&1 || exit 0
[[ -f $cfg ]] || exit 0
port="$(yq -r '.platforms.webhook.extra.port // 8644' "$cfg" 2>/dev/null || echo 8644)"
[[ $port =~ ^[0-9]+$ ]] || port=8644

expected_routes=(general pns pns-recap posture priority uu)
for route in "${expected_routes[@]}"; do
  # ABSENT FROM CONFIG. The old version gated the whole script on `has("relay")` and exited 0 otherwise,
  # so a config that had lost a route was indistinguishable from a machine with no hermes at all.
  if ! yq -e ".platforms.webhook.extra.routes // {} | has(\"$route\")" "$cfg" >/dev/null 2>&1; then
    printf '\n  ⚠ hermes: the %s route is NOT in %s, so every message to it will 404.\n    Run: chezmoi apply (the routes render from KeePassXC through private_dot_hermes/modify_private_config.yaml.tmpl)\n\n' \
      "$route" "$cfg"
    continue
  fi
  # NO SECRET. Checked for PRESENCE, never printed. A secret-less route inherits the gateway's global
  # `extra.secret`, which this machine does not set, and the gateway then refuses to start the whole
  # webhook platform rather than serving the route unauthenticated -- so this takes every route down,
  # not just one. The usual cause is an empty KeePassXC entry, which renders as an empty string.
  if [[ -z "$(yq -r ".platforms.webhook.extra.routes.\"${route}\".secret // \"\"" "$cfg" 2>/dev/null || echo '')" ]]; then
    printf '\n  ⚠ hermes: the %s route has NO secret, so the gateway refuses to start the webhook platform\n    and EVERY route stops answering. Check the KeePassXC entry "Hermes :: Webhook Secret (#%s)" is\n    populated, then: chezmoi apply\n\n' \
      "$route" "$route"
  fi
  # NO CHANNEL NAMED, or one that is not a snowflake. A deliver_only route whose deliver_extra.chat_id
  # is empty or absent falls back to the gateway's HOME channel, so every message lands in #general
  # instead of the channel the route was created for, and nothing about that looks broken from either
  # end. The shape test is what catches the other half: a Discord snowflake is 17 to 20 digits today, so
  # a truncated paste or a channel NAME in the vault entry fails here instead of 404-ing at Discord.
  chat_id="$(yq -r ".platforms.webhook.extra.routes.\"${route}\".deliver_extra.chat_id // \"\"" "$cfg" 2>/dev/null || echo '')"
  if [[ ! $chat_id =~ ^[0-9]{17,20}$ ]]; then
    printf '\n  ⚠ hermes: the %s route names no usable channel, so its messages go to the HOME channel\n    instead. A Discord channel id is 17 to 20 digits. Check the KeePassXC entry\n    "Discord (Uriel) :: Channel ID (#%s)", then: chezmoi apply\n\n' \
      "$route" "$route"
  fi
  # NOT DELIVER_ONLY. Without that field hermes hands the message to an AGENT instead of posting it
  # verbatim, and these bodies are built from third-party package and skill names. The template declares
  # the field, so this only fires when something rewrote the file after chezmoi wrote it, which
  # run_after_59's `hermes config migrate` is in a position to do.
  if [[ "$(yq -r ".platforms.webhook.extra.routes.\"${route}\".deliver_only // false" "$cfg" 2>/dev/null || echo false)" != "true" ]]; then
    printf '\n  ⚠ hermes: the %s route is NOT deliver_only, so hermes feeds its messages to an AGENT\n    instead of posting them verbatim, and those messages carry third-party package and skill names.\n    Run: chezmoi apply\n\n' \
      "$route"
  fi
  code="$(curl -s -o /dev/null -m 2 -w '%{http_code}' -X POST "http://127.0.0.1:${port}/webhooks/${route}" \
    -H 'Content-Type: application/json' -d '{}' 2>/dev/null || echo 000)"
  if [[ $code == "404" ]]; then
    printf '\n  ⚠ hermes: the %s route is in config.yaml but the gateway returns 404 (not loaded).\n    Run: hermes gateway restart\n\n' "$route"
  fi
done

# AN UNDECLARED ROUTE SURVIVED. The template writes the routes map WHOLE, so a route it does not name
# is removed by the apply that just ran; one still here means something put it back afterwards. It is
# reported rather than removed, because this script has no business editing the config and the next
# apply takes it out anyway. Read on fd 3 so the loop body cannot consume the route list.
while IFS= read -r -u3 route; do
  [[ -n $route ]] || continue
  case " ${expected_routes[*]} " in
    *" $route "*) ;;
    *)
      printf '\n  ⚠ hermes: the %s route is in %s but this repository does not declare it, so it will be\n    removed by the next apply. Anything still posting to it starts 404-ing then.\n\n' \
        "$route" "$cfg"
      ;;
  esac
done 3< <(yq -r '.platforms.webhook.extra.routes // {} | keys | .[]' "$cfg" 2>/dev/null || true)

# NO VOICE. tts.elevenlabs.voice_id is the other value this repository renders from KeePassXC, and an
# EMPTY one is worse than an absent one: tts_tool.py reads it as
# `el_config.get("voice_id", DEFAULT_ELEVENLABS_VOICE_ID)`, so a missing key falls back to the built-in
# voice while an empty string is sent to ElevenLabs as the voice id and the request fails. The usual
# cause is an empty vault entry, which renders as exactly that empty string.
if [[ -z "$(yq -r '.tts.elevenlabs.voice_id // ""' "$cfg" 2>/dev/null || echo '')" ]]; then
  printf '\n  ⚠ hermes: tts.elevenlabs.voice_id is empty, so every ElevenLabs request fails (an empty id is\n    sent as the voice, it is not a fallback). Check the KeePassXC entry "ElevenLabs :: Voice ID" is\n    populated, then: chezmoi apply\n\n'
fi
{{ end -}}
