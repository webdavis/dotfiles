{{ if eq .chezmoi.os "darwin" -}}
{{- $token := (keepassxc "moshi-hook :: Device Token").Password -}}
#!/usr/bin/env bash

set -euo pipefail

{{ includeTemplate "cli-print-style-lib.sh.tmpl" }}

readonly moshi_hook="/opt/homebrew/bin/moshi-hook"
readonly brew="/opt/homebrew/bin/brew"
readonly device_token={{ $token | quote }}
readonly paired_status_pattern='^status: *paired'
readonly moshi_tap="rjyo/moshi"
readonly broccoli_omp_agent_folder="$HOME/.omp/profiles/broccoli/agent"
readonly codex_hooks_file="$HOME/.codex/hooks.json"
readonly jq="/opt/homebrew/bin/jq"
readonly codex_hooks_without_pns='
  def is_pns_hook: (.command // "") | contains("pns hook");
  def without_pns_hooks: .hooks |= map(select(is_pns_hook | not));
  def has_hooks: .hooks | length > 0;
  .hooks |= (
    map_values(map(without_pns_hooks) | map(select(has_hooks)))
    | with_entries(select(.value | length > 0))
  )'

read_pairing_status() {
  "$moshi_hook" status 2>/dev/null || true
}

host_is_paired() {
  local pairing_status=$1
  printf '%s' "$pairing_status" | grep -q "$paired_status_pattern"
}

pair_host_with_phone() {
  "$moshi_hook" pair --token "$device_token"
}

install_moshi_hook_into_detected_harnesses() {
  "$moshi_hook" install
}

install_moshi_hook_into_broccoli_omp_profile() {
  if [[ -d $broccoli_omp_agent_folder ]]; then
    PI_CODING_AGENT_DIR="$broccoli_omp_agent_folder" "$moshi_hook" install --target omp
  fi
}

remove_pns_hooks_from_codex() {
  if [[ ! -f $codex_hooks_file ]]; then
    return
  fi
  local hooks_without_pns
  hooks_without_pns="$("$jq" "$codex_hooks_without_pns" "$codex_hooks_file")"
  printf '%s\n' "$hooks_without_pns" >"$codex_hooks_file"
}

trust_current_moshi_tap_revision() {
  "$brew" trust --tap "$moshi_tap" 2>/dev/null || true
}

start_moshi_hook_service() {
  "$brew" services start moshi-hook
}

main() {
  report_section 'moshi-hook' 'phone pairing, agent hooks and the background service'

  local pairing_status
  pairing_status="$(read_pairing_status)"
  if host_is_paired "$pairing_status"; then
    report_line "already paired, skipping the pairing."
  else
    report_line "pairing this host with the Moshi app..."
    pair_host_with_phone
    report_line "paired."
  fi

  report_line "installing hooks into every harness moshi-hook detects..."
  install_moshi_hook_into_detected_harnesses
  install_moshi_hook_into_broccoli_omp_profile
  remove_pns_hooks_from_codex
  report_line "installed hooks."

  report_line "starting the moshi-hook service..."
  trust_current_moshi_tap_revision
  start_moshi_hook_service
  report_line "started the moshi-hook service."
}

main "$@"
{{ end -}}
