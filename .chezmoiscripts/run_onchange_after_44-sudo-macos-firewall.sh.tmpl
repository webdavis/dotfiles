{{ if eq .chezmoi.os "darwin" -}}
#!/usr/bin/env bash

set -euo pipefail

{{ includeTemplate "cli-print-style-lib.sh.tmpl" }}

{{ includeTemplate "sudo-session.sh.tmpl" }}

readonly firewall_tool="/usr/libexec/ApplicationFirewall/socketfilterfw"

enable_application_firewall() {
  sudo "$firewall_tool" --setglobalstate on
}

enable_stealth_mode() {
  sudo "$firewall_tool" --setstealthmode on
}

allow_built_in_signed_software() {
  sudo "$firewall_tool" --setallowsigned on
}

allow_downloaded_signed_software() {
  sudo "$firewall_tool" --setallowsignedapp on
}

main() {
  report_section 'firewall' 'application firewall policy'
  authenticate_sudo_once

  report_line "enabling the firewall..."
  enable_application_firewall
  report_line "enabling stealth mode..."
  enable_stealth_mode
  report_line "allowing incoming connections for built-in signed software..."
  allow_built_in_signed_software
  report_line "allowing incoming connections for downloaded signed software..."
  allow_downloaded_signed_software
  report_line "applied."
}

main "$@"
{{ end -}}
