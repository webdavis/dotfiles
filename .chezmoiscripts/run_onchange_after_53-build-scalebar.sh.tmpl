{{ if eq .chezmoi.os "darwin" -}}
{{ $scalebar := joinPath .chezmoi.homeDir .scalebar.source_dir -}}
#!/usr/bin/env bash

set -euo pipefail

{{ range (glob (joinPath $scalebar "Sources/**/*.swift")) -}}
# {{ . }} {{ include . | sha256sum }}
{{ end -}}
{{ range (list "Package.swift" "Package.resolved") -}}
{{ $manifest := joinPath $scalebar . -}}
{{ if stat $manifest -}}
# {{ $manifest }} {{ include $manifest | sha256sum }}
{{ end -}}
{{ end -}}
# retry-marker: {{ $retry := joinPath (env "HOME") ".cache/scalebar-build/scalebar.retry" }}{{ if stat $retry }}{{ (stat $retry).modTime }}{{ else }}settled{{ end }}

{{ includeTemplate "cli-print-style-lib.sh.tmpl" }}
{{ includeTemplate "rust-build-lib.sh.tmpl" }}

readonly scalebar_source_dir={{ $scalebar | quote }}
readonly built_binaries_dir="$scalebar_source_dir/.build/release"
readonly install_dir={{ joinPath .chezmoi.homeDir .scalebar.install_dir | quote }}
readonly scalebar_retry_marker="$HOME/.cache/scalebar-build/scalebar.retry"

scalebar_clone_exists() {
  [[ -d $scalebar_source_dir ]]
}

swift_is_installed() {
  command -v swift >/dev/null 2>&1
}

build_release_binaries() {
  (cd "$scalebar_source_dir" && swift build -c release -q)
}

main() {
  report_section 'scalebar' 'menu-bar app and MCP server'

  if ! scalebar_clone_exists; then
    report_line "no clone at $scalebar_source_dir (git clone git@github.com:webdavis/scalebar.git); the build runs on the next apply." >&2
    defer_build_until_next_apply "$scalebar_retry_marker"
    exit 0
  fi

  if ! swift_is_installed; then
    report_line "swift not on PATH (install the Xcode command line tools); the build runs on the next apply." >&2
    defer_build_until_next_apply "$scalebar_retry_marker"
    exit 0
  fi

  report_line "building the release binaries..."
  local build_status=0
  build_release_binaries || build_status=$?
  if build_failed "$build_status"; then
    report_line "error[build-failed]: scalebar did not build; see swift's output above." >&2
    exit "$build_status"
  fi
  report_line "built Scalebar and ScalebarMCP in $built_binaries_dir."

  report_line "installing the release binaries..."
  install_release_binary "$built_binaries_dir/Scalebar" "$install_dir/Scalebar"
  install_release_binary "$built_binaries_dir/ScalebarMCP" "$install_dir/ScalebarMCP"
  settle_retry_marker "$scalebar_retry_marker"
  report_line "installed Scalebar and ScalebarMCP into $install_dir."
}

main "$@"
{{ end -}}
