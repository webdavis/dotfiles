{{ if eq .chezmoi.os "darwin" -}}
#!/bin/bash
# Reconcile the just-applied config.yaml to the installed hermes version's schema. Keeps auto-updates
# compatible with the tracked (possibly older-schema) source: chezmoi decrypts and writes the source,
# this migrates it forward. No-op once the tracked source is captured at the current schema. EOF-safe:
# migrate's prompts default to skip on EOF (verified in hermes source); API keys come from .env, not the
# prompts.
#
# NUMBERING. The only ordering this needs is "after chezmoi wrote the config, before run_after_68 reads
# it", and every run_after_ script satisfies the first half by definition. It sat at 67 in the tree it
# came from; here 67 is the rotate-logs LaunchAgent loader, so it takes the free 59 slot instead and 67
# keeps meaning one thing. test/integration/hermes-route-status.sh pins that, by refusing any mention of
# run_after_67 in the route check next door.
set -euo pipefail
command -v hermes >/dev/null 2>&1 || exit 0
# The migrate subcommand prints an informational block listing every OPTIONAL
# API key not configured, 180 lines on this machine, with no supported quiet
# switch (hermes_cli/config.py hardcodes migrate_config(quiet=False), read
# 2026-08-05). Filter that one ℹ️ block out of OUR relay of its output; the
# required-keys ⚠️ block and everything else pass through untouched. The run
# stays best-effort (|| true), exactly as it was before the filter.
# Blank lines are BUFFERED, not printed on sight: the ones that framed the
# filtered block (and any run of trailing blanks) would otherwise survive as
# stray whitespace. A blank prints only when real content follows it.
# G2 section headers (operator ruling 2026-08-05); the library is inlined at
# render time, so no runtime sourcing.
{{ includeTemplate "cli-print-style-lib.sh.tmpl" }}
migrate_output="$(hermes config migrate </dev/null 2>&1 | awk '
  /^[[:space:]]*$/ { if (!skipping) blanks++; next }
  /Checking configuration for updates/ { next }
  /optional API key\(s\) not configured/ { skipping = 1; blanks = 0; next }
  skipping && /^[[:space:]]*•/ { next }
  { skipping = 0; while (blanks > 0) { print ""; blanks-- }; print }
' || true)"
if [[ -n $migrate_output ]]; then
  report_section "hermes config migrate" "config check"
  printf '%s\n' "$migrate_output"
fi
{{ end -}}
