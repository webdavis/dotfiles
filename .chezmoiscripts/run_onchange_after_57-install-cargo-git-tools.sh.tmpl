{{ if eq .chezmoi.os "darwin" -}}
#!/usr/bin/env bash

set -euo pipefail

# .chezmoidata/system_packages_autoinstall.yaml {{ include ".chezmoidata/system_packages_autoinstall.yaml" | sha256sum }}
# retry-marker: {{ $retry := joinPath (env "HOME") ".cache/cargo-git-tools/retry" }}{{ if stat $retry }}{{ (stat $retry).modTime }}{{ else }}settled{{ end }}

{{ includeTemplate "cli-print-style-lib.sh.tmpl" }}
{{ includeTemplate "rust-build-lib.sh.tmpl" }}
{{ includeTemplate "load-launchagent.sh.tmpl" }}
{{ includeTemplate "retire-launchagent.sh.tmpl" }}

readonly installed_crates_record="$HOME/.cargo/.crates2.json"
readonly cargo_git_tools_retry_marker="$HOME/.cache/cargo-git-tools/retry"
readonly uu_binary="$HOME/.cargo/bin/uu"
readonly pns_binary="$HOME/.cargo/bin/pns"
readonly -a retired_pns_launchagent_labels=(com.webdavis.pns-daemon com.webdavis.pns-github-receiver)
readonly retired_pns_log_directory="$HOME/.local/log"

tool_binary_is_installed() {
  local name=$1
  [[ -x "$HOME/.cargo/bin/$name" ]]
}

installed_crates_record_exists() {
  [[ -f $installed_crates_record ]]
}

installed_crates_record_lists_package() {
  local repo=$1 package=$2
  jq -e --arg package "$package " --arg source "(git+https://github.com/${repo}" \
    'any(.installs | keys[]; startswith($package) and contains($source))' \
    "$installed_crates_record" >/dev/null
}

cargo_tracks_the_package() {
  local repo=$1 package=$2
  installed_crates_record_exists && installed_crates_record_lists_package "$repo" "$package"
}

cargo_does_not_track_the_binary() {
  local name=$1 repo=$2 package=$3
  tool_binary_is_installed "$name" && ! cargo_tracks_the_package "$repo" "$package"
}

features_are_declared() {
  local features=$1
  [[ -n $features ]]
}

cargo_install_from_git() {
  local name=$1 repo=$2 package=$3 features=$4
  local install_arguments=()
  if features_are_declared "$features"; then
    install_arguments+=(--features "$features")
  fi
  if cargo_does_not_track_the_binary "$name" "$repo" "$package"; then
    install_arguments+=(--force)
  fi
  "$cargo_bin" install --git "https://github.com/$repo" --locked "${install_arguments[@]}" "$package"
}

installed_short_sha() {
  local repo=$1 package=$2
  jq -r --arg package "$package " --arg source "(git+https://github.com/${repo}#" \
    '.installs | keys[] | select(startswith($package) and contains($source)) | split("#")[1][0:7]' \
    "$installed_crates_record"
}

install_latest_commit() {
  local name=$1 repo=$2 package=$3 features=$4
  if ! cargo_install_from_git "$name" "$repo" "$package" "$features"; then
    report_line "$name: install failed; deferred to the next apply" >&2
    return 1
  fi
  report_line "$name: $(installed_short_sha "$repo" "$package")"
}

install_declared_tools() {
  local install_status=0
{{- range .packages.cargo_git_tools }}
  install_latest_commit {{ .name | quote }} {{ .repo | quote }} {{ .package | quote }} {{ get . "features" | quote }} || install_status=1
{{- end }}
  return "$install_status"
}

uu_is_installed() {
  [[ -x $uu_binary ]]
}

install_uu_daemon() {
  "$uu_binary" daemon install
}

install_the_uu_daemon() {
  report_section 'uu' 'daemon'

  if ! uu_is_installed; then
    report_line "$uu_binary is missing or not executable, so the daemon was left as it is; the install is deferred to the next apply." >&2
    return 0
  fi

  if ! install_uu_daemon; then
    report_line "error[install-failed]: uu daemon install failed; the next apply retries." >&2
    return 1
  fi
}

pns_is_installed() {
  [[ -x $pns_binary ]]
}

retire_the_old_pns_launchagents() {
  local label log
  for label in "${retired_pns_launchagent_labels[@]}"; do
    retire_launchagent "$label" || return 1
  done
  for log in "$retired_pns_log_directory"/pns-daemon.log* "$retired_pns_log_directory"/pns-github-receiver.log*; do
    trash_if_present "$log" || return 1
  done
}

install_pns_gateway() {
  "$pns_binary" gateway install
}

install_the_pns_gateway() {
  report_section 'pns' 'gateway'

  if ! pns_is_installed; then
    report_line "$pns_binary is missing or not executable, so the gateway was left as it is; the install is deferred to the next apply." >&2
    return 0
  fi

  if ! retire_the_old_pns_launchagents; then
    report_line "error[retire-failed]: an old pns LaunchAgent is still loaded or its files were not trashed, so pns gateway install did not run; the next apply retries." >&2
    return 1
  fi

  if ! install_pns_gateway; then
    report_line "error[install-failed]: pns gateway install failed; the next apply retries." >&2
    return 1
  fi
}

main() {
  report_section 'cargo-git-tools' 'CLI tools'

  if ! cargo_is_installed; then
    report_line "cargo not found at $cargo_bin; install deferred to the next apply." >&2
    defer_build_until_next_apply "$cargo_git_tools_retry_marker"
  elif install_declared_tools; then
    settle_retry_marker "$cargo_git_tools_retry_marker"
  else
    defer_build_until_next_apply "$cargo_git_tools_retry_marker"
  fi

  local daemon_status=0
  install_the_pns_gateway || daemon_status=1
  install_the_uu_daemon || daemon_status=1
  return "$daemon_status"
}

main "$@"
{{ end -}}
