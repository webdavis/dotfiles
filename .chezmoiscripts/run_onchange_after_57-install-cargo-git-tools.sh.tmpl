{{ if eq .chezmoi.os "darwin" -}}
#!/usr/bin/env bash

set -euo pipefail

# .chezmoidata/system_packages_autoinstall.yaml {{ include ".chezmoidata/system_packages_autoinstall.yaml" | sha256sum }}
# retry-marker: {{ $retry := joinPath (env "HOME") ".cache/cargo-git-tools/retry" }}{{ if stat $retry }}{{ (stat $retry).modTime }}{{ else }}settled{{ end }}

{{ includeTemplate "cli-print-style-lib.sh.tmpl" }}
{{ includeTemplate "rust-build-lib.sh.tmpl" }}

readonly install_root={{ joinPath .chezmoi.homeDir .rust_tools.install_dir | dir | quote }}
readonly installed_crates_record="$install_root/.crates2.json"
readonly cargo_git_tools_retry_marker="$HOME/.cache/cargo-git-tools/retry"

tool_binary_is_installed() {
  local name=$1
  [[ -x "$install_root/bin/$name" ]]
}

installed_crates_record_exists() {
  [[ -f $installed_crates_record ]]
}

installed_crates_record_lists_package() {
  local repo=$1 package=$2
  jq -e --arg package "$package " --arg source "(git+https://github.com/${repo}" \
    'any(.installs | keys[]; startswith($package) and contains($source))' \
    "$installed_crates_record" >/dev/null
}

cargo_tracks_the_package() {
  local repo=$1 package=$2
  installed_crates_record_exists && installed_crates_record_lists_package "$repo" "$package"
}

binary_was_installed_outside_cargo() {
  local name=$1 repo=$2 package=$3
  tool_binary_is_installed "$name" && ! cargo_tracks_the_package "$repo" "$package"
}

features_are_declared() {
  local features=$1
  [[ -n $features ]]
}

cargo_install_from_git() {
  local name=$1 repo=$2 package=$3 features=$4
  local install_arguments=()
  if features_are_declared "$features"; then
    install_arguments+=(--features "$features")
  fi
  if binary_was_installed_outside_cargo "$name" "$repo" "$package"; then
    install_arguments+=(--force)
  fi
  "$cargo_bin" install --git "https://github.com/$repo" --locked "${install_arguments[@]}" --root "$install_root" "$package"
}

installed_short_sha() {
  local repo=$1 package=$2
  jq -r --arg package "$package " --arg source "(git+https://github.com/${repo}#" \
    '.installs | keys[] | select(startswith($package) and contains($source)) | split("#")[1][0:7]' \
    "$installed_crates_record"
}

install_latest_commit() {
  local name=$1 repo=$2 package=$3 features=$4
  if ! cargo_install_from_git "$name" "$repo" "$package" "$features"; then
    report_line "$name: install failed; deferred to the next apply" >&2
    return 1
  fi
  report_line "$name: $(installed_short_sha "$repo" "$package")"
}

install_declared_tools() {
  local install_status=0
{{- range .packages.cargo_git_tools }}
  install_latest_commit {{ .name | quote }} {{ .repo | quote }} {{ .package | quote }} {{ get . "features" | quote }} || install_status=1
{{- end }}
  return "$install_status"
}

main() {
  report_section 'cargo-git-tools' 'CLI tools'

  if ! cargo_is_installed; then
    report_line "cargo not found at $cargo_bin; install deferred to the next apply." >&2
    defer_build_until_next_apply "$cargo_git_tools_retry_marker"
    exit 0
  fi

  if ! install_declared_tools; then
    defer_build_until_next_apply "$cargo_git_tools_retry_marker"
    exit 0
  fi

  settle_retry_marker "$cargo_git_tools_retry_marker"
}

main "$@"
{{ end -}}
