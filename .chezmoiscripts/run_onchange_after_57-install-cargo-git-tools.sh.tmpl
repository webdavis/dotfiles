{{ if eq .chezmoi.os "darwin" -}}
#!/usr/bin/env bash

set -euo pipefail

{{ range .packages.cargo_git_tools -}}
# {{ .name }}: {{ .repo }} package={{ .package }} ref={{ .ref }}{{ with get . "features" }} features={{ . }}{{ end }}
{{ end -}}
# retry-marker: {{ $retry := joinPath (env "HOME") ".cache/cargo-git-tools/retry" }}{{ if stat $retry }}{{ (stat $retry).modTime }}{{ else }}settled{{ end }}

{{ includeTemplate "cli-print-style-lib.sh.tmpl" }}
{{ includeTemplate "rust-build-lib.sh.tmpl" }}

readonly install_root={{ joinPath .chezmoi.homeDir .rust_tools.install_dir | dir | quote }}
readonly installed_crates_record="$install_root/.crates2.json"
readonly cargo_git_tools_retry_marker="$HOME/.cache/cargo-git-tools/retry"

tool_binary_is_installed() {
  local name=$1
  [[ -x "$install_root/bin/$name" ]]
}

installed_crates_record_exists() {
  [[ -f $installed_crates_record ]]
}

installed_crates_record_lists_revision_with_features() {
  local repo=$1 revision=$2 features=$3
  jq -e --arg source "(git+https://github.com/${repo}?rev=${revision}" --arg features "$features" \
    'any(.installs | to_entries[]; (.key | contains($source)) and (.value.features | join(",")) == $features)' \
    "$installed_crates_record" >/dev/null
}

pinned_revision_is_installed() {
  local repo=$1 revision=$2 name=$3 features=$4
  tool_binary_is_installed "$name" && installed_crates_record_exists && installed_crates_record_lists_revision_with_features "$repo" "$revision" "$features"
}

features_are_declared() {
  local features=$1
  [[ -n $features ]]
}

cargo_install_from_git() {
  local repo=$1 revision=$2 package=$3 features=$4
  local feature_arguments=()
  if features_are_declared "$features"; then
    feature_arguments=(--features "$features")
  fi
  "$cargo_bin" install --git "https://github.com/$repo" --rev "$revision" --locked --force "${feature_arguments[@]}" --root "$install_root" "$package"
}

install_pinned_revision_if_missing() {
  local name=$1 repo=$2 package=$3 revision=$4 features=$5
  if pinned_revision_is_installed "$repo" "$revision" "$name" "$features"; then
    report_line "$name from $repo@$revision already installed, skipping."
    return
  fi
  report_line "installing $name from $repo@$revision..."
  if ! cargo_install_from_git "$repo" "$revision" "$package" "$features"; then
    report_line "install failed (network unreachable, or cargo itself failed); deferred to the next apply." >&2
    return 1
  fi
  report_line "installed $install_root/bin/$name."
}

install_declared_tools() {
  local install_status=0
{{- range .packages.cargo_git_tools }}
  install_pinned_revision_if_missing {{ .name | quote }} {{ .repo | quote }} {{ .package | quote }} {{ .ref | quote }} {{ get . "features" | quote }} || install_status=1
{{- end }}
  return "$install_status"
}

main() {
  report_section 'cargo-git-tools' 'CLI tools pinned to a git revision'

  if ! cargo_is_installed; then
    report_line "cargo not found at $cargo_bin; install deferred to the next apply." >&2
    defer_build_until_next_apply "$cargo_git_tools_retry_marker"
    exit 0
  fi

  if ! install_declared_tools; then
    defer_build_until_next_apply "$cargo_git_tools_retry_marker"
    exit 0
  fi

  settle_retry_marker "$cargo_git_tools_retry_marker"
}

main "$@"
{{ end -}}
