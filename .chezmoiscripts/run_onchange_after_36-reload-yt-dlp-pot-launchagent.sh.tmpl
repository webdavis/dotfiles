{{ if eq .chezmoi.os "darwin" -}}
#!/usr/bin/env bash
# plist hash: {{ include "Library/LaunchAgents/com.webdavis.yt-dlp-pot-provider.plist.tmpl" | sha256sum }}

set -euo pipefail

{{ includeTemplate "cli-print-style-lib.sh.tmpl" }}

{{ includeTemplate "load-launchagent.sh.tmpl" }}

readonly launchagent_label="com.webdavis.yt-dlp-pot-provider"
readonly launchagent_plist="$HOME/Library/LaunchAgents/$launchagent_label.plist"

main() {
  report_section 'yt-dlp' 'PO token provider LaunchAgent'

  if launchagent_is_loaded "$launchagent_label"; then
    report_line "reloading..."
    unload_launchagent "$launchagent_label"
  else
    report_line "loading..."
  fi

  if launchagent_bootstrapped "$launchagent_plist"; then
    report_line "loaded."
  fi
}

main "$@"
{{ end -}}
