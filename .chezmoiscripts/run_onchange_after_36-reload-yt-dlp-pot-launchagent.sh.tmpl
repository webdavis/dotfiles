{{ if eq .chezmoi.os "darwin" -}}
#!/usr/bin/env bash
# plist hash: {{ include "Library/LaunchAgents/com.webdavis.yt-dlp-pot-provider.plist.tmpl" | sha256sum }}

set -euo pipefail

{{ includeTemplate "cli-print-style-lib.sh.tmpl" }}

{{ includeTemplate "load-launchagent.sh.tmpl" }}
{{ includeTemplate "keep-old-logs.sh.tmpl" }}

readonly launchagent_label="com.webdavis.yt-dlp-pot-provider"
readonly launchagent_plist="$HOME/Library/LaunchAgents/$launchagent_label.plist"
readonly launchagent_log_directory="$HOME/.local/state/yt-dlp"
readonly old_launchagent_log_directory="$HOME/.local/log/yt-dlp"
readonly old_launchagent_log="$old_launchagent_log_directory/pot-provider.log"
readonly kept_old_launchagent_log="$launchagent_log_directory/pot-provider.old.log"

main() {
  report_section 'yt-dlp' 'PO token provider LaunchAgent'
  create_launchagent_log_directory "$launchagent_log_directory"

  if launchagent_is_loaded "$launchagent_label"; then
    report_line "reloading..."
    unload_launchagent "$launchagent_label"
  else
    report_line "loading..."
  fi

  if launchagent_bootstrapped "$launchagent_plist"; then
    report_line "loaded."
    keep_old_log "$old_launchagent_log" "$kept_old_launchagent_log"
    trash_old_log_folder_once_empty "$old_launchagent_log_directory"
  fi
}

main "$@"
{{ end -}}
