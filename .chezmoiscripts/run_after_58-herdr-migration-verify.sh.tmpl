{{ if eq .chezmoi.os "darwin" -}}
{{- $skipSystemPackages := eq (env "SKIP_SYSTEM_PACKAGES") "1" -}}
#!/usr/bin/env bash

set -euo pipefail

{{ includeTemplate "cli-print-style-lib.sh.tmpl" }}

{{ includeTemplate "herdr-health-check.sh.tmpl" }}

{{ includeTemplate "brew-bundle-cleanup-guard.sh.tmpl" }}

readonly brew_prefix="${HOMEBREW_PREFIX:-/opt/homebrew}"
readonly brew_bin="$brew_prefix/bin/brew"
readonly legacy_multiplexers=(tmux sesh)
readonly skip_system_packages={{ $skipSystemPackages }}

temporary_brewfile=""

formula_is_installed() {
  local formula=$1
  "$brew_bin" list "$formula" &>/dev/null
}

legacy_multiplexer_is_installed() {
  local multiplexer
  for multiplexer in "${legacy_multiplexers[@]}"; do
    if formula_is_installed "$multiplexer"; then
      return 0
    fi
  done
  return 1
}

system_packages_are_skipped() {
  [[ $skip_system_packages == true ]]
}

create_temporary_brewfile() {
  mktemp 2>/dev/null
}

remove_temporary_brewfile() {
  rm -f "$temporary_brewfile"
}

write_declared_packages_into_brewfile() {
  local brewfile=$1
  cat >"$brewfile" <<EOF
{{ range .packages.macos.homebrew.taps -}}
tap {{ . | quote }}
{{ end -}}
{{ range .packages.macos.homebrew.formulae -}}
brew {{ . | quote }}
{{ end -}}
{{ range .packages.macos.homebrew.casks -}}
cask {{ . | quote }}
{{ end -}}
{{ range .packages.macos.homebrew.mas -}}
mas {{ .name | quote }}, id: {{ .id }}
{{ end -}}
EOF
}

cleanup_was_refused() {
  [[ $BREW_CLEANUP_OUTCOME == refused ]]
}

verify_herdr() {
  report_line "verifying herdr as a multiplexer..."
  local reason
  if ! reason="$(herdr_health_check)"; then
    report_line "error[herdr-unverified]: herdr not yet verified as a multiplexer ($reason); keeping tmux/sesh installed." >&2
    report_line "Plugin registration and the session server need a RUNNING herdr server, which only an interactive terminal starts (a chezmoiscript must not start it). Complete the migration: open an interactive terminal (bashrc auto-attaches and starts the server), then run chezmoi apply again so this script verifies herdr and removes tmux/sesh." >&2
    return 1
  fi
  report_line "verified herdr as a multiplexer."
}

remove_legacy_multiplexers() {
  if ! temporary_brewfile="$(create_temporary_brewfile)"; then
    report_line "error[no-brewfile]: herdr verified but a temporary Brewfile could not be created; cleanup deferred to the next apply." >&2
    return
  fi
  trap remove_temporary_brewfile EXIT
  write_declared_packages_into_brewfile "$temporary_brewfile"

  report_line "removing tmux and sesh with brew bundle cleanup..."
  if ! brew_bundle_cleanup_guarded "$temporary_brewfile"; then
    report_line "error[cleanup-failed]: herdr verified but brew bundle cleanup failed; tmux/sesh may still be installed. Re-run chezmoi apply to retry." >&2
    return
  fi
  if cleanup_was_refused; then
    report_line "error[cleanup-refused]: herdr verified but the forced cleanup was refused by the bulk-removal guard (the rendered manifest would remove more than the safety threshold); tmux/sesh may still be installed. Re-run with HOMEBREW_BUNDLE_ALLOW_BULK_CLEANUP=1 once the manifest is complete." >&2
    return
  fi
  report_line "removed tmux/sesh via brew bundle cleanup (migration complete)."
}

main() {
  report_section 'herdr' 'retire tmux and sesh once herdr is verified'

  if ! legacy_multiplexer_is_installed; then
    report_line "tmux and sesh are not installed, skipping."
    return
  fi

  if ! verify_herdr; then
    return
  fi

  if system_packages_are_skipped; then
    report_line "SKIP_SYSTEM_PACKAGES=1: herdr verified but skipping the deferred tmux/sesh cleanup (secondary-worktree safety); a normal apply completes the migration." >&2
    return
  fi

  remove_legacy_multiplexers
}

main "$@"
{{ end -}}
