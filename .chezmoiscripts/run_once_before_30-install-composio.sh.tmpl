{{ if eq .chezmoi.os "darwin" -}}
#!/usr/bin/env bash

set -euo pipefail

{{ includeTemplate "cli-print-style-lib.sh.tmpl" }}

readonly composio_installer_url="https://composio.dev/install"
readonly composio_executable="${COMPOSIO_INSTALL_DIR:-$HOME/.composio}/composio"

composio_is_installed() {
  [[ -x $composio_executable ]]
}

install_composio() {
  curl --proto '=https' --tlsv1.2 -fsSL "$composio_installer_url" | bash
}

main() {
  report_section 'composio' 'Composio command-line tool'

  if composio_is_installed; then
    report_line "already installed, skipping."
    return
  fi

  report_line "installing..."
  install_composio
  report_line "installed composio."
}

main "$@"
{{ end -}}
