{{ if eq .chezmoi.os "darwin" -}}
{{ if .packages.macos.cargo -}}
#!/usr/bin/env bash

set -euo pipefail

{{ includeTemplate "cli-print-style-lib.sh.tmpl" }}

readonly cargo_bin_directory="$HOME/.cargo/bin"
readonly install_time_limit=10m
readonly exit_status_hung=124

readonly declared_crates=(
{{- range .packages.macos.cargo }}
  {{ printf "%s %s" .name (get . "version" | default "") | trim | quote }}
{{- end }}
)

add_cargo_bin_directory_to_path() {
  export PATH="$cargo_bin_directory:$PATH"
}

command_is_on_path() {
  local command_name=$1
  command -v "$command_name" >/dev/null 2>&1
}

cargo_is_installed() {
  command_is_on_path cargo
}

find_coreutils_timeout() {
  local candidate
  for candidate in timeout gtimeout; do
    if command_is_on_path "$candidate"; then
      printf '%s\n' "$candidate"
      return
    fi
  done
}

timeout_command_was_found() {
  local timeout_command=$1
  [[ -n $timeout_command ]]
}

run_with_time_limit() {
  local timeout_command
  timeout_command="$(find_coreutils_timeout)"
  if timeout_command_was_found "$timeout_command"; then
    "$timeout_command" "$install_time_limit" "$@"
  else
    "$@"
  fi
}

install_crate() {
  local crate=$1 version=$2
  run_with_time_limit cargo install --locked "$crate" ${version:+--version "$version"}
}

install_failed() {
  local exit_status=$1
  ((exit_status != 0))
}

install_hung() {
  local exit_status=$1
  ((exit_status == exit_status_hung))
}

failed_install_message() {
  local crate=$1 exit_status=$2
  if install_hung "$exit_status"; then
    printf 'error[timeout]: %s was still installing after %s.' "$crate" "$install_time_limit"
  else
    printf 'error[failed-install]: %s exited with status %s.' "$crate" "$exit_status"
  fi
}

main() {
  add_cargo_bin_directory_to_path
  report_section 'cargo' 'crate installs' >&2

  if ! cargo_is_installed; then
    report_line 'error[missing-tool]: cargo is not on PATH; no crates were installed.' >&2
    exit 1
  fi

  local entry crate version exit_status
  for entry in "${declared_crates[@]}"; do
    read -r crate version <<<"$entry"
    exit_status=0
    install_crate "$crate" "$version" || exit_status=$?
    if install_failed "$exit_status"; then
      report_line "$(failed_install_message "${crate}${version:+ $version}" "$exit_status")" >&2
      exit 1
    fi
  done
}

main "$@"
{{ end -}}
{{ end -}}
