{{ if eq .chezmoi.os "darwin" -}}
{{ if .packages.macos.cargo -}}
#!/bin/bash

# run_onchange_before_21-cargo-tools.sh.tmpl:
#
# Installs the third-party crates declared in .chezmoidata/system_packages_autoinstall.yaml
# under packages.macos.cargo. An entry with a `version` is pinned to it; an entry without one
# installs the latest release from crates.io.

set -euo pipefail

{{ includeTemplate "cli-print-style-lib.sh.tmpl" }}

export PATH="$HOME/.cargo/bin:$PATH"

report_section 'cargo' 'crate installs' >&2

if ! command -v cargo >/dev/null 2>&1; then
  report_line 'error[missing-tool]: cargo is not on PATH; no crates were installed.' >&2
  exit 1
fi

find_coreutils_timeout() {
  local linux_cmd="timeout"
  local macos_cmd="gtimeout"
  local candidate
  for candidate in "$linux_cmd" "$macos_cmd"; do
    if command -v "$candidate" >/dev/null 2>&1; then
      printf '%s\n' "$candidate"
      return
    fi
  done
}

timeout_bin="$(find_coreutils_timeout)"
install_time_limit=10m
exit_status_hung=124

run_with_time_limit() {
  if [[ -n $timeout_bin ]]; then
    "$timeout_bin" "$install_time_limit" "$@"
  else
    "$@"
  fi
}

install_crate() {
  local crate=$1 version=${2:-}
  run_with_time_limit cargo install --locked "$crate" ${version:+--version "$version"}
}

abort_on_failed_install() {
  local crate=$1 exit_status=$2
  if ((exit_status == exit_status_hung)); then
    report_line "error[timeout]: $crate was still installing after $install_time_limit." >&2
  else
    report_line "error[failed-install]: $crate exited with status $exit_status." >&2
  fi
  exit 1
}

install_crate_or_abort_apply() {
  local crate=$1 version=${2:-} exit_status
  install_crate "$crate" "$version" && return
  exit_status=$?
  abort_on_failed_install "${crate}${version:+ $version}" "$exit_status"
}

{{ range .packages.macos.cargo }}
install_crate_or_abort_apply {{ .name | quote }} {{ get . "version" | quote }}
{{- end }}
{{ end -}}
{{ end -}}
