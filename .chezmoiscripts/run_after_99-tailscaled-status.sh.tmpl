{{ if eq .chezmoi.os "darwin" -}}
#!/usr/bin/env bash

set -euo pipefail

{{ includeTemplate "cli-print-style-lib.sh.tmpl" }}

readonly tailscale_bin="${TAILSCALE_BIN:-/opt/homebrew/bin/tailscale}"
readonly tailscaled_bin="/opt/homebrew/opt/tailscale/bin/tailscaled"

tailscale_is_installed() {
  [[ -x $tailscale_bin ]]
}

jq_is_installed() {
  command -v jq >/dev/null 2>&1
}

read_tailscale_status() {
  "$tailscale_bin" status --json 2>/dev/null
}

backend_state_from() {
  local status_json=$1
  jq -er '.BackendState' <<<"$status_json" 2>/dev/null
}

backend_is_running() {
  local backend_state=$1
  [[ $backend_state == Running ]]
}

report_tailscale_section() {
  report_section 'tailscale' 'headless daemon status'
}

remind_to_install_the_daemon() {
  report_line "tailscaled system daemon is not running. One-time:"
  report_line "  sudo $tailscaled_bin install-system-daemon"
}

report_daemon_is_starting() {
  report_line "tailscaled is starting up (transient) -- no action needed."
}

remind_to_sign_in() {
  report_line "tailscaled is running but NOT authenticated. One-time:"
  report_line "  sudo tailscale up --accept-dns=true"
  report_line "  then flip 'Disable Key Expiry' on this node in the admin console."
}

remind_to_approve_this_machine() {
  report_line "tailscaled is up but this machine awaits tailnet admin approval."
  report_line "  approve it in the admin console (Machines -> this node)."
}

remind_to_start_tailscale() {
  report_line "tailscale is stopped -- run: sudo tailscale up"
}

report_unknown_backend_state() {
  local backend_state=$1
  report_line "tailscaled reported an unknown BackendState: $backend_state"
}

remind_about_backend_state() {
  local backend_state=$1
  case "$backend_state" in
    Starting) report_daemon_is_starting ;;
    NeedsLogin) remind_to_sign_in ;;
    NeedsMachineAuth) remind_to_approve_this_machine ;;
    Stopped) remind_to_start_tailscale ;;
    *) report_unknown_backend_state "$backend_state" ;;
  esac
}

main() {
  if ! tailscale_is_installed; then
    report_tailscale_section
    report_line "tailscale is not installed, skipping."
    return
  fi

  if ! jq_is_installed; then
    report_tailscale_section
    report_line "jq is not installed, skipping."
    return
  fi

  local status_json
  if ! status_json="$(read_tailscale_status)"; then
    report_tailscale_section >&2
    remind_to_install_the_daemon >&2
    return
  fi

  local backend_state
  if ! backend_state="$(backend_state_from "$status_json")"; then
    report_tailscale_section >&2
    remind_to_install_the_daemon >&2
    return
  fi

  if backend_is_running "$backend_state"; then
    return
  fi

  report_tailscale_section >&2
  remind_about_backend_state "$backend_state" >&2
}

main "$@"
{{ end -}}
