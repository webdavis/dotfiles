{{ if eq .chezmoi.os "darwin" -}}
#!/bin/bash
# When brew upgrades moshi-hook in place, the running daemon keeps executing
# its old image. On Unix an open executable survives being unlinked, so the
# daemon runs happily on a version that no longer exists on disk: nothing
# crashes, KeepAlive sees a healthy process, and `moshi-hook --version` reports
# the NEW version while the process bridging to the phone is the old one.
# Observed 2026-07-27 going 0.2.37 -> 0.2.61: pid 3399 was still serving code
# from a Cellar directory brew had already deleted in the same command.
#
# This is the atuin failure again (see run_after_45), and the weekly Homebrew
# upgrade recipe reproduces it unattended, because nothing restarts moshi-hook
# after an upgrade.
#
# STALENESS IS DECIDED BY INODE, NOT BY A VERSION STRING. `moshi-hook probe`
# prints a version, but whether that is the DAEMON's version or the CLI's own
# was never established, and comparing the CLI against itself is a tautology
# that always reports healthy. The inode of the executable the process actually
# holds open is the artifact: if brew replaced the binary, it differs from the
# inode on disk today. That is true whatever any version string says.
set -euo pipefail

readonly SERVICE_LABEL='homebrew.mxcl.moshi-hook'
# Seam, so the test can point this at a fixture. Without it the test silently
# depends on the HOST having moshi-hook installed: on a machine without it the
# script exits at the check below, the bounce path is never reached, and the
# suite passes locally while failing on a clean runner. That is the
# skips-itself-when-absent class this repository has already filed twice.
MOSHI_HOOK_BIN="${MOSHI_HOOK_BIN:-/opt/homebrew/bin/moshi-hook}"

[[ -x $MOSHI_HOOK_BIN ]] || exit 0

# --- the two ways the interposition breaks SILENTLY --------------------------
#
# pns registers itself as the harness hook and forwards to moshi-hook, so the
# phone keeps its approve/deny round trip while pns keeps the presence gate.
# Both halves of that arrangement can be undone without anything failing, which
# is why they are re-asserted here rather than trusted: this script already runs
# after every upgrade, which is when both happen.
#
# Seams, so a test drives this without touching the operator's live files or
# the real binary. Same names the hooks use.
PNS_MOSHI_GATE="${PNS_MOSHI_GATE:-$HOME/.local/libexec/pns/hooks/moshi-gate.sh}"
MOSHI_EXTENSION_ROOT="${MOSHI_EXTENSION_ROOT:-$HOME}"

# 1. THE REPOINT. pi and omp are driven by a TypeScript extension moshi
# GENERATES, hard-coding `const helperBinary = "/opt/homebrew/bin/moshi-hook"`.
# `moshi-hook install` and every upgrade rewrite that file, reverting the one
# line pns owns. Nothing fails when it does; the symptom is unfiltered phone
# pushes while the operator sits at the keyboard, which reads as moshi being
# noisy rather than as a regression.
if [[ -x $PNS_MOSHI_GATE ]]; then
  for extension in \
    "$MOSHI_EXTENSION_ROOT/.pi/agent/extensions/moshi-hooks.ts" \
    "$MOSHI_EXTENSION_ROOT/.omp/agent/extensions/moshi-hooks.ts"; do
    [[ -f $extension ]] || continue
    current="$(sed -n 's/^const helperBinary = "\(.*\)"$/\1/p' "$extension" | head -1)"
    if [[ -z $current ]]; then
      printf 'moshi-hook: WARNING: %s no longer declares a helperBinary line this script recognizes, so pns presence gating is OFF for that harness and its pushes are unfiltered.\n' \
        "$extension" >&2
      continue
    fi
    [[ $current != "$PNS_MOSHI_GATE" ]] || continue
    tmp="$(mktemp "$extension.XXXXXX")" || continue
    # The copy is for the MODE, not the content, which the redirect below
    # replaces: mktemp makes an 0600 file, and the atomic `mv` would hand that
    # mode to a file this repo does not own. A redirect into an existing file
    # leaves its mode alone.
    cp -p "$extension" "$tmp"
    if sed "s|^const helperBinary = \".*\"\$|const helperBinary = \"$PNS_MOSHI_GATE\"|" \
      "$extension" >"$tmp" && grep -q "helperBinary = \"$PNS_MOSHI_GATE\"" "$tmp"; then
      mv "$tmp" "$extension"
      printf 'moshi-hook: repointed %s at the pns presence gate (it pointed at %s).\n' \
        "$extension" "$current"
    else
      rm -f "$tmp"
      printf 'moshi-hook: WARNING: could not repoint %s at the pns presence gate; its pushes are unfiltered.\n' \
        "$extension" >&2
    fi
  done
fi

# 2. THE SUBCOMMAND. The per-harness hook subcommands are UNDOCUMENTED (none of
# them appears in `moshi-hook --help`), so a rename would ship as a silent
# no-op: every forward would return "path does not exist" instead of a
# decision, and approve/deny from the phone would simply stop working with
# nothing to see. moshi's top-level positional is a PATH, which is what makes
# a gone subcommand detectable at all. An empty JSON object carries no
# hook_event_name, so this probe notifies nobody (measured: ~50ms, silent).
#
# It WARNS rather than failing. This is a notification path, and refusing the
# rest of an apply over one is the same mistake as a hook that fails a turn
# because a push did not land.
for subcommand in claude-hook codex-hook pi-hook omp-hook; do
  probe="$(printf '{}' | "$MOSHI_HOOK_BIN" "$subcommand" 2>&1 >/dev/null || true)"
  case "$probe" in
    *'path does not exist'*)
      printf 'moshi-hook: WARNING: the %s subcommand is gone (%s). pns forwards every %s approval to it, so approve and deny from the phone are DEAD for that harness until the name is corrected.\n' \
        "$subcommand" "$probe" "${subcommand%-hook}" >&2
      ;;
  esac
done

# `|| true` because pgrep exits 1 when it matches nothing, and under pipefail
# that status is the whole assignment's, which errexit turns into a failed
# script and chezmoi turns into an ABORTED APPLY. A daemon that is not running
# is the ordinary case this next line already handles, not an error.
pid="$(pgrep -f 'moshi-hook serve' 2>/dev/null | head -1)" || true
[[ -n $pid ]] || exit 0

# The txt entry is the executable image the process is running. Capturing the
# status separately: a failed lsof must not be read as a matching inode.
lsof_status=0
running_inode="$(lsof -p "$pid" 2>/dev/null | awk '$4 == "txt" { print $(NF-1); exit }')" || lsof_status=$?
if [[ $lsof_status -ne 0 || -z $running_inode ]]; then
  printf 'moshi-hook: could not read the running image of pid %s; not bouncing a daemon whose state is unknown.\n' "$pid" >&2
  exit 0
fi

resolved="$(readlink -f "$MOSHI_HOOK_BIN" 2>/dev/null || true)"
[[ -n $resolved && -e $resolved ]] || exit 0

disk_inode="$(stat -f '%i' "$resolved" 2>/dev/null || true)"
[[ -n $disk_inode ]] || exit 0

# Both sides must be plain digits before comparing, so a surprising lsof or
# stat format cannot produce a false match.
case $running_inode in '' | *[!0-9]*) exit 0 ;; esac
case $disk_inode in '' | *[!0-9]*) exit 0 ;; esac

if [[ $running_inode != "$disk_inode" ]]; then
  printf 'moshi-hook daemon is running a replaced binary (image %s, on disk %s); bouncing the LaunchAgent...\n' \
    "$running_inode" "$disk_inode"
  launchctl kickstart -k "gui/$(id -u)/$SERVICE_LABEL"
fi
{{ end -}}
