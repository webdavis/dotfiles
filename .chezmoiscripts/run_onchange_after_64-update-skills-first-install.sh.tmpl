#!/bin/bash
# Bootstrap missing or unhealthy skills through uu after its builder runs.
# The operator stops the retired updater and waits for every publisher before
# the cutover apply. Manual live-reconcile remains separate from uu jobs.
#
# Keep the skills retry marker until bootstrap succeeds. Advancing its digits
# changes this script's rendered content so the next apply retries a failed or
# contended bootstrap without aborting the current apply. A successful removal
# causes one final, harmless settle run.
#
# Never interpolate raw marker bytes. Only leading digits enter this comment;
# an unreadable or absent marker contributes nothing. The runtime bump below
# also bounds the first line and forces decimal arithmetic.
# lock hash: {{ include "dot_agents/custom-skill-lock.json" | sha256sum }}
# build-retry-marker: {{ $rm := joinPath .chezmoi.homeDir ".cache/uu-build/uu.retry" }}{{ if stat $rm }}{{ (stat $rm).modTime }}{{ else }}settled{{ end }}
# pending retry: {{ if stat (joinPath .chezmoi.homeDir ".local/state/skills/first-install-pending") }}{{ (output "sh" "-c" (printf "cat %s 2>/dev/null || true" (joinPath .chezmoi.homeDir ".local/state/skills/first-install-pending" | squote))) | regexFind "^[0-9]+" }}{{ end }}
set -euo pipefail

UPDATER="$HOME/.local/libexec/uu/uu"
MARKER_DIR="$HOME/.local/state/skills"
MARKER="$MARKER_DIR/first-install-pending"
ENGINE="$HOME/.local/libexec/pns/pns"

if [[ ! -x $UPDATER ]]; then
  exit 0
fi

bump_retry_marker() {
  mkdir -p "$MARKER_DIR"
  local count
  count="$(cat "$MARKER" 2>/dev/null || echo 0)"
  count="${count%%$'\n'*}"
  [[ $count =~ ^[0-9]{1,6}$ ]] || count=0
  count=$((10#$count + 1))
  printf '%s\n' "$count" >"$MARKER"
  printf '%s' "$count"
}

rc=0
"$UPDATER" bootstrap skills || rc=$?
if [[ $rc -eq 0 ]]; then
  rm -f "$MARKER"
else
  # uu uses exit 1 for both a failed bootstrap and lock refusal.
  count="$(bump_retry_marker)"
  printf 'uu skills bootstrap failed (attempt %s); it will retry on the next apply\n' "$count" >&2
  if [[ -x $ENGINE ]]; then
    "$ENGINE" --agent update-skills --state first-install-failed --project skills \
      --detail "uu bootstrap skills failed on this machine (attempt $count); it re-fires on the next apply" || true
  fi
fi
