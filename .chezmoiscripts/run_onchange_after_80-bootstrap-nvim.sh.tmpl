#!/usr/bin/env bash

set -euo pipefail

{{ $nvim := joinPath .chezmoi.sourceDir "dot_config/nvim" -}}
# lazy-lock.json {{ include (joinPath $nvim "lazy-lock.json") | sha256sum }}
# lua/plugins/lsp.lua {{ include (joinPath $nvim "lua/plugins/lsp.lua") | sha256sum }}
# lua/plugins/treesitter.lua {{ include (joinPath $nvim "lua/plugins/treesitter.lua") | sha256sum }}

{{ includeTemplate "cli-print-style-lib.sh.tmpl" }}

fnm_node_bin="$HOME/.local/share/fnm/aliases/default/bin"
cargo_bin_dir="$HOME/.cargo/bin"
nix_profile_bin="/nix/var/nix/profiles/default/bin"

prepend_to_path_if_exists() {
  local dir=$1
  if [[ -d $dir ]]; then
    PATH="$dir:$PATH"
  fi
}

add_tool_dirs_to_path() {
  prepend_to_path_if_exists "$fnm_node_bin"
  prepend_to_path_if_exists "$cargo_bin_dir"
  prepend_to_path_if_exists "$nix_profile_bin"
  export PATH
}

nvim_is_installed() {
  command -v nvim >/dev/null 2>&1
}

restore_plugins_to_lockfile() {
  nvim --headless "+Lazy! restore" +qa
}

install_mason_tools() {
  nvim --headless "+MasonToolsInstallSync" +qa
}

main() {
  report_section 'nvim' 'plugins and Mason tools'
  add_tool_dirs_to_path

  if ! nvim_is_installed; then
    report_line "error[missing-tool]: nvim is not on PATH; plugins and Mason tools were not installed." >&2
    exit 1
  fi

  report_line "restoring plugins to the lockfile..."
  restore_plugins_to_lockfile
  report_line "restored plugins."

  report_line "installing Mason tools..."
  install_mason_tools
  report_line "installed Mason tools."
}

main "$@"
