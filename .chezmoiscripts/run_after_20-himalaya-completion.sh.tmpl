#!/usr/bin/env bash

set -euo pipefail

{{ includeTemplate "cli-print-style-lib.sh.tmpl" }}

readonly completion_directory="${XDG_DATA_HOME:-$HOME/.local/share}/bash-completion/completions"
readonly installed_completion="$completion_directory/himalaya"
readonly staging_completion="$completion_directory/.himalaya.staging"
readonly completion_file_name="himalaya.bash"

working_directory=""
section_is_printed=no

report_under_section() {
  local message=$1
  if [[ $section_is_printed == no ]]; then
    report_section 'himalaya' 'bash completion'
    section_is_printed=yes
  fi
  report_line "$message"
}

himalaya_is_installed() {
  command -v himalaya >/dev/null 2>&1
}

remove_working_directory() {
  rm -rf "$working_directory"
}

write_completion_into_directory() {
  local directory=$1
  himalaya completion bash >"$directory/$completion_file_name" 2>/dev/null
}

file_has_content() {
  local file=$1
  [[ -s $file ]]
}

file_defines_the_completion_function() {
  local file=$1
  grep -q '^_himalaya()' "$file"
}

completion_is_installed_unchanged() {
  local generated_completion=$1
  cmp -s "$generated_completion" "$installed_completion"
}

install_completion_with_one_rename() {
  local generated_completion=$1
  mkdir -p "$completion_directory"
  cp -- "$generated_completion" "$staging_completion"
  chmod 0644 "$staging_completion"
  mv -f -- "$staging_completion" "$installed_completion"
}

main() {
  if ! himalaya_is_installed; then
    return
  fi

  working_directory="$(mktemp -d)"
  trap remove_working_directory EXIT

  if ! write_completion_into_directory "$working_directory"; then
    report_under_section "error[subcommand-failed]: the completion subcommand failed; leaving any existing completion alone, and the next apply retries." >&2
    return
  fi

  local generated_completion="$working_directory/$completion_file_name"
  if ! file_has_content "$generated_completion"; then
    report_under_section "error[no-completion-file]: the subcommand produced no completion file; leaving any existing completion alone, and the next apply retries." >&2
    return
  fi
  if ! file_defines_the_completion_function "$generated_completion"; then
    report_under_section "error[not-a-completion]: the generated file does not define _himalaya; refusing to install it, and the next apply retries." >&2
    return
  fi
  if completion_is_installed_unchanged "$generated_completion"; then
    return
  fi

  install_completion_with_one_rename "$generated_completion"
  report_under_section "installed $installed_completion."
}

main "$@"
