{{ if eq .chezmoi.os "darwin" -}}
#!/usr/bin/env bash

set -euo pipefail

{{ range .packages.herdr_linked_plugins -}}
# pinned revision ({{ .id }}) {{ .ref }}
{{ end -}}
# .config/herdr/config.toml {{ include (joinPath .chezmoi.sourceDir "dot_config/herdr/config.toml") | sha256sum }}
# .config/herdr/processes.toml {{ include (joinPath .chezmoi.sourceDir "dot_config/herdr/processes.toml") | sha256sum }}
# .config/herdr/plugins/config/herdr-workspace-jump/config.toml {{ include (joinPath .chezmoi.sourceDir "dot_config/herdr/plugins/config/herdr-workspace-jump/config.toml") | sha256sum }}
{{ range .packages.herdr_linked_plugins -}}
# retry-attempts ({{ .id }}): {{ $retryMarker := printf "%s/.cache/herdr-plugin-build/%s.retry" (env "HOME") .id }}{{ if stat $retryMarker }}{{ (output "cat" $retryMarker) | regexFind "^[0-9]+" }}{{ else }}0{{ end }}
{{ end }}
{{ includeTemplate "cli-print-style-lib.sh.tmpl" }}
{{ includeTemplate "rust-build-lib.sh.tmpl" }}

readonly plugin_checkouts_dir="$HOME/.local/share"
readonly plugin_retry_markers_dir="$HOME/.cache/herdr-plugin-build"
readonly herdr_time_limit_seconds=10
readonly herdr_timed_out_status=124
readonly fields_per_linked_plugin=3
readonly linked_plugins=(
{{- range .packages.herdr_linked_plugins }}
  {{ .id | quote }} "https://github.com/{{ .repo }}.git" {{ .ref | quote }}
{{- end }}
)

defer_plugin_until_next_apply() {
  local retry_marker=$1 reason=$2
  increment_retry_attempts "$retry_marker"
  report_line "$reason" >&2
}

path_exists() {
  local path=$1
  [[ -e $path ]]
}

checkout_is_a_git_repository() {
  local checkout=$1
  [[ -d $checkout/.git ]]
}

path_blocks_the_checkout() {
  local checkout=$1
  path_exists "$checkout" && ! checkout_is_a_git_repository "$checkout"
}

clone_plugin_if_missing() {
  local repo_url=$1 checkout=$2
  if checkout_is_a_git_repository "$checkout"; then
    return 0
  fi
  git clone --quiet "$repo_url" "$checkout"
}

fetch_plugin_tags() {
  local checkout=$1
  git -C "$checkout" fetch --quiet --tags origin
}

check_out_pinned_revision() {
  local checkout=$1 pinned_ref=$2
  git -C "$checkout" checkout --quiet --force --detach "$pinned_ref"
}

build_plugin_release_binary() {
  local checkout=$1
  (cd "$checkout" && "$cargo_bin" build --release --locked)
}

generate_plugin_manifest() {
  local checkout=$1 plugin_id=$2
  (cd "$checkout" && "./target/release/$plugin_id" generate --output .)
}

command_is_on_path() {
  local command_name=$1
  command -v "$command_name" >/dev/null 2>&1
}

find_coreutils_timeout() {
  local candidate
  for candidate in timeout gtimeout; do
    if command_is_on_path "$candidate"; then
      printf '%s\n' "$candidate"
      return
    fi
  done
}

herdr_calls_can_be_time_limited() {
  [[ -n $(find_coreutils_timeout) ]]
}

run_herdr_with_time_limit() {
  local timeout_command
  timeout_command="$(find_coreutils_timeout)"
  "$timeout_command" "$herdr_time_limit_seconds" herdr "$@"
}

list_registered_plugin() {
  local plugin_id=$1
  run_herdr_with_time_limit plugin list --plugin "$plugin_id" --json 2>/dev/null
}

herdr_reported_an_error() {
  local response=$1
  printf '%s' "$response" | jq -e '.error' >/dev/null 2>&1
}

count_plugins_registered_as() {
  local response=$1 plugin_id=$2
  printf '%s' "$response" | jq --arg id "$plugin_id" '[.result.plugins[]? | select(.plugin_id == $id)] | length' 2>/dev/null
}

plugin_is_registered() {
  local plugin_id=$1
  local response registered_count
  response="$(list_registered_plugin "$plugin_id")" || return 1
  if herdr_reported_an_error "$response"; then
    return 1
  fi
  registered_count="$(count_plugins_registered_as "$response" "$plugin_id" || printf '0')"
  [[ $registered_count == 1 ]]
}

link_plugin_checkout() {
  local checkout=$1
  run_herdr_with_time_limit plugin link "$checkout" 2>&1
}

herdr_call_timed_out() {
  local call_status=$1
  ((call_status == herdr_timed_out_status))
}

link_error_message() {
  local link_output=$1
  printf '%s' "$link_output" | jq -e -r '.error.message // empty' 2>/dev/null
}

link_reported_an_error() {
  local link_error=$1
  [[ -n $link_error ]]
}

register_plugin() {
  local plugin_id=$1 checkout=$2
  local link_output link_status=0 link_error
  if ! herdr_calls_can_be_time_limited; then
    report_line "no coreutils timeout binary (timeout/gtimeout absent); cannot bound herdr calls safely, $plugin_id registration deferred (trigger left retryable)." >&2
    return 1
  fi
  link_output="$(link_plugin_checkout "$checkout")" || link_status=$?
  if herdr_call_timed_out "$link_status"; then
    report_line "herdr plugin link timed out for $plugin_id (server wedged?); registration deferred (trigger left retryable)." >&2
    return 1
  fi
  link_error="$(link_error_message "$link_output" || true)"
  if link_reported_an_error "$link_error"; then
    report_line "herdr plugin link $plugin_id returned an error envelope: $link_error" >&2
  fi
  plugin_is_registered "$plugin_id"
}

install_linked_plugin() {
  local plugin_id=$1 repo_url=$2 pinned_ref=$3
  local checkout="$plugin_checkouts_dir/$plugin_id"
  local retry_marker="$plugin_retry_markers_dir/$plugin_id.retry"

  report_section 'herdr plugin' "$plugin_id" >&2

  if ! cargo_is_installed; then
    defer_plugin_until_next_apply "$retry_marker" "cargo not found at $cargo_bin; $plugin_id plugin build deferred (trigger left retryable)."
    report_line 'rustup (run_once_before_20) has not provisioned it yet; the next chezmoi apply retries automatically once cargo exists.' >&2
    return 0
  fi

  report_line "checking out $pinned_ref..."
  if path_blocks_the_checkout "$checkout"; then
    defer_plugin_until_next_apply "$retry_marker" "$checkout exists and is not a git checkout; trash it by hand and the next apply reclones (trigger left retryable)."
    return 0
  fi
  if ! clone_plugin_if_missing "$repo_url" "$checkout"; then
    defer_plugin_until_next_apply "$retry_marker" "git clone $repo_url failed; $plugin_id build deferred (trigger left retryable)."
    return 0
  fi
  if ! fetch_plugin_tags "$checkout"; then
    defer_plugin_until_next_apply "$retry_marker" "git fetch in $checkout failed; $plugin_id build deferred (trigger left retryable)."
    return 0
  fi
  if ! check_out_pinned_revision "$checkout" "$pinned_ref"; then
    defer_plugin_until_next_apply "$retry_marker" "revision $pinned_ref not found in $repo_url; $plugin_id build deferred (trigger left retryable)."
    return 0
  fi
  report_line "checked out $pinned_ref in $checkout."

  report_line "building the release binary..."
  if ! build_plugin_release_binary "$checkout"; then
    report_line "error[build-failed]: cargo build failed for $plugin_id at $pinned_ref." >&2
    return 1
  fi
  report_line "built $checkout/target/release/$plugin_id."

  report_line "generating the plugin manifest..."
  if ! generate_plugin_manifest "$checkout" "$plugin_id"; then
    defer_plugin_until_next_apply "$retry_marker" "herdr plugin $plugin_id built but manifest generation failed; registration skipped (trigger left retryable)."
    return 0
  fi
  report_line "generated the plugin manifest."

  report_line "registering the plugin with herdr..."
  if ! register_plugin "$plugin_id" "$checkout"; then
    defer_plugin_until_next_apply "$retry_marker" "herdr plugin $plugin_id built but registration is unverified (herdr server unreachable?); trigger left retryable, the next apply retries."
    return 0
  fi
  settle_retry_marker "$retry_marker"
  report_line "herdr plugin $plugin_id built at $pinned_ref and registered"
}

main() {
  local plugin_index
  for ((plugin_index = 0; plugin_index < ${#linked_plugins[@]}; plugin_index += fields_per_linked_plugin)); do
    install_linked_plugin "${linked_plugins[plugin_index]}" "${linked_plugins[plugin_index + 1]}" "${linked_plugins[plugin_index + 2]}"
  done
}

main "$@"
{{ end -}}
