#!/usr/bin/env bash

set -euo pipefail

{{ includeTemplate "cli-print-style-lib.sh.tmpl" }}

readonly installer_url="https://raw.githubusercontent.com/backnotprop/plannotator/main/scripts/install.sh"
readonly binary_only_flag="--minimal"

fetch_installer() {
  curl -fsSL "$installer_url"
}

run_installer() {
  local installer=$1
  bash -c "$installer" -- "$binary_only_flag" </dev/null >/dev/null
}

main() {
  report_section 'plannotator' 'binary only; harness configuration stays in chezmoi'

  local installer
  if ! installer="$(fetch_installer)"; then
    report_line "error[download-failed]: could not download the installer from $installer_url; plannotator was not reinstalled." >&2
    exit 1
  fi

  report_line "running the installer..."
  if ! run_installer "$installer"; then
    report_line "error[install-failed]: the installer failed; plannotator was not reinstalled." >&2
    exit 1
  fi
  report_line "installer finished."
}

main "$@"
