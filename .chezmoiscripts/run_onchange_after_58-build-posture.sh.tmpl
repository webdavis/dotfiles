{{ if eq .chezmoi.os "darwin" -}}
{{ $posture := joinPath .chezmoi.sourceDir "posture" -}}
#!/usr/bin/env bash

set -euo pipefail

{{ range $pattern := list "crates/*/src/**/*" "crates/*/tests/**/*" "crates/*/fixtures/**/*" "crates/*/build.rs" -}}
{{ range (glob (joinPath $posture $pattern)) -}}
{{ if not (stat .).isDir -}}
# {{ . }} {{ include . | sha256sum }}
{{ end -}}
{{ end -}}
{{ end -}}
{{ range (glob (joinPath $posture "build.rs")) -}}
# {{ . }} {{ include . | sha256sum }}
{{ end -}}
# Cargo.toml {{ include (joinPath $posture "Cargo.toml") | sha256sum }}
# Cargo.lock {{ include (joinPath $posture "Cargo.lock") | sha256sum }}
# rust-toolchain.toml {{ include (joinPath $posture "rust-toolchain.toml") | sha256sum }}
{{ range (glob (joinPath $posture "crates/*/Cargo.toml")) -}}
# {{ . }} {{ include . | sha256sum }}
{{ end -}}
{{ range (glob (printf "%s/.rustup/toolchains/*/bin/rustc" (env "HOME"))) -}}
# {{ . }} {{ (stat .).modTime }}
{{ end -}}
# retry-marker: {{ $retryMarker := printf "%s/.cache/posture-build/posture.retry" (env "HOME") }}{{ if stat $retryMarker }}{{ (stat $retryMarker).size }}{{ else }}settled{{ end }}

{{ includeTemplate "cli-print-style-lib.sh.tmpl" }}
{{ includeTemplate "rust-build-lib.sh.tmpl" }}
{{ includeTemplate "build-record-lib.sh.tmpl" }}

readonly posture_workspace_dir={{ $posture | quote }}
readonly built_posture="$posture_workspace_dir/target/release/posture"
readonly install_dir={{ joinPath .chezmoi.homeDir .rust_tools.install_dir | quote }}
readonly installed_posture="$install_dir/posture"
readonly posture_build_record="$HOME/.local/state/posture-build-record"
readonly posture_max_artifact_bytes={{ .rust_tools.max_artifact_bytes.posture }}
readonly posture_retry_marker="$HOME/.cache/posture-build/posture.retry"

grow_retry_marker_by_one_byte() {
  mkdir -p "$(dirname "$posture_retry_marker")"
  printf 'x' >>"$posture_retry_marker"
}

make_installed_posture_executable() {
  chmod 755 "$installed_posture"
}

main() {
  make_new_files_private
  report_section 'posture' 'osquery security tools'

  if ! cargo_is_installed; then
    report_line "cargo not found at $cargo_bin; build deferred to the next apply." >&2
    grow_retry_marker_by_one_byte
    exit 0
  fi

  report_line "building the release binary..."
  local build_status=0
  build_release_binary "$posture_workspace_dir" posture || build_status=$?
  if build_failed "$build_status"; then
    report_line "error[build-failed]: posture did not build; see cargo's output above." >&2
    exit "$build_status"
  fi
  report_line "built $built_posture."

  local artifact_bytes
  artifact_bytes="$(artifact_size_in_bytes "$built_posture")"
  if ! artifact_size_is_allowed "$artifact_bytes" "$posture_max_artifact_bytes"; then
    report_line "error[artifact-size]: refusing a posture artifact of $artifact_bytes bytes (allowed 1..$posture_max_artifact_bytes)." >&2
    exit 1
  fi

  local artifact_hash
  artifact_hash="$(artifact_sha256 "$built_posture")"
  if ! is_a_sha256_digest "$artifact_hash"; then
    report_line "error[invalid-digest]: shasum printed no sha256 digest for $built_posture." >&2
    exit 1
  fi

  local compiler
  compiler="$(compiler_version "$posture_workspace_dir")"

  create_install_directory "$install_dir"
  create_temporary_build_records "$posture_build_record"
  write_next_build_record "$artifact_hash" "$artifact_bytes" "$compiler"

  if build_is_already_published "$built_posture" "$installed_posture" "$posture_build_record"; then
    make_installed_posture_executable
    keep_build_record_private "$posture_build_record"
    settle_retry_marker "$posture_retry_marker"
    report_line "already installed from this build, skipping."
    return
  fi

  report_line "refreshing the pipeline manifest..."
  save_previous_build_record "$posture_build_record"
  publish_next_build_record "$posture_build_record"
  if ! refresh_pipeline_manifest; then
    roll_back_build_record "$posture_build_record"
    report_line "error[manifest-refresh-failed]: the pipeline manifest was not refreshed; the installed posture is unchanged." >&2
    exit 1
  fi
  report_line "refreshed the pipeline manifest."

  report_line "installing the release binary..."
  install_release_binary "$built_posture" "$installed_posture"
  report_line "installed $installed_posture."
  settle_retry_marker "$posture_retry_marker"
}

main "$@"
{{ end -}}
