builtin bind -m vi-insert '"\C-xou": "\C-x0__bash_bindings_update_package_manager\r"'
builtin bind -m vi-command '"\C-xou": "i\C-x0__bash_bindings_update_package_manager\r"'

# `brew search `
builtin bind -m vi-insert '"\C-xos": "\C-x0brew search "'
builtin bind -m vi-command '"\C-xos": "i\C-x0brew search "'

# `brew install `
builtin bind -m vi-insert '"\C-xoi": "\C-x0brew install "'
builtin bind -m vi-command '"\C-xoi": "i\C-x0brew install "'

# --- files ---
# Repository files, newest commit first.

builtin bind -m vi-insert '"\C-xl": "\C-x0__bash_bindings_git_ls_files_with_last_modified\r"'
builtin bind -m vi-command '"\C-xl": "i\C-x0__bash_bindings_git_ls_files_with_last_modified\r"'

# --- network ---
# Network diagnostics and discovery.

# Search networking commands and prepare one for execution.
builtin bind -m vi-insert -x '"\C-xn": "__fzf_network_menu"'
builtin bind -m vi-command -x '"\C-xn": "__fzf_network_menu"'
builtin bind -m emacs-standard -x '"\C-xn": "__fzf_network_menu"'

# --- bindings-help ---
# List every binding these files declare.

# Search Bash shortcuts and prepare a command.
builtin bind -m vi-insert -x '"\C-xv": "__bash_bindings_list_bash_bindings"'
builtin bind -m vi-command -x '"\C-xv": "__bash_bindings_list_bash_bindings"'
builtin bind -m emacs-standard -x '"\C-xv": "__bash_bindings_list_bash_bindings"'
