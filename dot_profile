# shellcheck shell=bash

# Load ~/.bashrc only for INTERACTIVE shells. A non-interactive login shell
# (notably herdr's `/bin/sh -lc` wrapper around every keybinding command) would
# otherwise source the full ~/.bashrc, whose interactive half (atuin, starship,
# carapace and friends) costs an order of magnitude more than everything else in
# it, on every keypress. Interactive bash gets ~/.bashrc via ~/.bash_profile, so normal
# terminals are unaffected; this only spares non-interactive login shells.
[[ -n $BASH_VERSION && $- == *i* && -f "${HOME}/.bashrc" ]] && . "${HOME}/.bashrc"

export XDG_CONFIG_HOME="${HOME}/.config"
