# shellcheck shell=bash

# Loads ~/.bashrc in interactive shells only, because herdr runs every keybinding in a login shell
# and the full ~/.bashrc is too slow to load on each keypress.
[[ -n $BASH_VERSION && $- == *i* && -f "${HOME}/.bashrc" ]] && . "${HOME}/.bashrc"

export XDG_CONFIG_HOME="${HOME}/.config"
