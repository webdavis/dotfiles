<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.webdavis.pns-daemon</string>
  <key>ProgramArguments</key>
  <array>
    <string>{{ .chezmoi.homeDir }}/.local/libexec/pns/pns</string>
    <string>daemon</string>
    <string>run</string>
  </array>
  <key>RunAtLoad</key>
  <true/>
  <!-- RESTART ONLY ON A CRASH, unlike the atuin and happy daemons' bare
       KeepAlive true. `[daemon] enabled = false` makes this job exit 0 on
       purpose, and under a bare true that clean exit is relaunched every ten
       seconds forever, which is the atuin restart-loop bug (its own plist
       records ~6000 attempts in production) reproduced deliberately. With
       SuccessfulExit false, an exit 0 stays exited and a crash still restarts.
       RunAtLoad has to be stated above because the implication that comes with
       bare KeepAlive true does not survive the dictionary form. -->
  <key>KeepAlive</key>
  <dict>
    <key>SuccessfulExit</key>
    <false/>
  </dict>
  <!-- STATED AT THE DEFAULT rather than left to it. This is the number that
       decides how fast a crash-looping daemon burns, it is invisible when
       omitted, and a reader of this plist should not have to know the man page
       to see it. -->
  <key>ThrottleInterval</key>
  <integer>10</integer>
  <key>StandardOutPath</key>
  <string>{{ .chezmoi.homeDir }}/.local/log/pns-daemon.log</string>
  <key>StandardErrorPath</key>
  <string>{{ .chezmoi.homeDir }}/.local/log/pns-daemon.log</string>
  <key>EnvironmentVariables</key>
  <dict>
    <key>HOME</key>
    <string>{{ .chezmoi.homeDir }}</string>
    <!-- A bootstrapped job gets PATH=/usr/bin:/bin:/usr/sbin:/sbin and no
         Homebrew, and every job this daemon runs is a re-execution of pns that
         wants to find the same tools its hook-path self finds.

         ~/.local/bin IS FIRST, in the update-skills agent's own shape, because
         herdr lives there and nowhere else: the lights tick reads `herdr
         workspace list` for the working aggregate, and without this the
         reading fails on every tick, the aggregate answers not-working, and
         the loop lamp never breathes at all. -->
    <key>PATH</key>
    <string>{{ .chezmoi.homeDir }}/.local/bin:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
  </dict>
</dict>
</plist>
