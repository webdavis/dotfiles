<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.webdavis.clauth-daemon</string>
  <key>ProgramArguments</key>
  <array>
    <string>{{ .chezmoi.homeDir }}/.cargo/bin/clauth</string>
    <string>daemon</string>
    <!-- --standby waits behind a daemon the TUI started and takes over when it exits. -->
    <string>--standby</string>
  </array>
  <!-- The TUI's own `start daemon` runs it from here too. -->
  <key>WorkingDirectory</key>
  <string>{{ .chezmoi.homeDir }}/.clauth</string>
  <key>RunAtLoad</key>
  <true/>
  <!-- Restart after a crash only, the pairing clauth documents for --standby. -->
  <key>KeepAlive</key>
  <dict>
    <key>SuccessfulExit</key>
    <false/>
  </dict>
  <!-- clauth caps daemon.log in place, which needs launchd's append mode. -->
  <key>StandardOutPath</key>
  <string>{{ .chezmoi.homeDir }}/.clauth/daemon.log</string>
  <key>StandardErrorPath</key>
  <string>{{ .chezmoi.homeDir }}/.clauth/daemon.log</string>
  <key>EnvironmentVariables</key>
  <dict>
    <key>HOME</key>
    <string>{{ .chezmoi.homeDir }}</string>
    <key>PATH</key>
    <string>{{ .chezmoi.homeDir }}/.cargo/bin:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
  </dict>
</dict>
</plist>
