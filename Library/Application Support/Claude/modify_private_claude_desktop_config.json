{{- /* chezmoi:modify-template */ -}}
{{- /*
  Selective field control for Claude Desktop's claude_desktop_config.json.

  Why: workspace-mcp's Google OAuth client secret was leaking into this
  file in plaintext. Vaulting via KeePassXC keeps the secret out of git
  while letting the rest of Claude Desktop's config (preferences, browser
  permissions, etc.) drift freely under the app's own control.

  How: chezmoi modify-template. Reads the current target file from
  .chezmoi.stdin, overlays the mcpServers entries this repo declares with
  their vaulted env, writes the merged JSON back. All other keys pass
  through.
*/ -}}
{{- $stdin := index .chezmoi "stdin" | default "" -}}
{{- $merged := dict -}}
{{- if $stdin -}}
{{-   $merged = fromJson $stdin -}}
{{- end -}}

{{- /* --- stable: workspace-mcp entry --- */ -}}
{{- $googleWorkspace := dict
    "command" "uvx"
    "args" (list "workspace-mcp" "--tool-tier" "complete")
    "env" (dict
      "GOOGLE_OAUTH_CLIENT_ID" ((keepassxc "Google Cloud (webdavis.io) :: OAuth :: google-workspace-mcp").UserName)
      "GOOGLE_OAUTH_CLIENT_SECRET" ((keepassxc "Google Cloud (webdavis.io) :: OAuth :: google-workspace-mcp").Password)
      "OAUTHLIB_INSECURE_TRANSPORT" "1") -}}
{{- $merged = setValueAtPath "mcpServers.google_workspace" $googleWorkspace $merged -}}

{{- /* --- stable: the local YNAB MCP server, WRITES ON.

     Same declaration Claude Code and Codex carry, so the desktop app reaches
     the YNAB account on the same terms: full and complete access by the
     operator's ruling of 2026-09-14, so `YNAB_ALLOW_WRITES` is "1" and the
     server registers its write tools alongside the read ones (measured on
     5.2.0: 62 tools rather than the 38 read tools alone).

     Nine of those tools require a `confirmed: true` field in their own input:
     the two deletes, the two bulk-filter writes, the three category and split
     operations, `undo_operation` and the generic `ynab_write_tool_execute`. It
     is a required SCHEMA field upstream offers no switch for, not a second
     permission gate, so an agent supplies it itself rather than stopping to
     ask per call. The client-side rate limiter keeps its upstream defaults,
     190 requests per hour with a burst of 10, because it protects the token
     from YNAB's hard 200-per-hour lockout rather than rationing the agents.

     The command is the fnm-lane binary rather than `npx -y`, matching what the
     other two declare: `.chezmoidata/system_packages_autoinstall.yaml` installs
     the package, so the version that runs is the declared one instead of
     whatever npm resolves at launch, and the app starts the server with no
     network round trip.

     `YNAB_DISABLE_AGENT_CONFIG_FALLBACK` is "1" so the keys come from this
     declaration alone. Without it the server also reads `~/.codex/config.toml`
     and `~/.claude/settings.json`, which are another harness's files and say
     nothing about how the desktop app should reach the account. --- */ -}}
{{- $ynab := dict
    "command" (printf "%s/.local/share/fnm/aliases/default/bin/mcp-server-for-ynab" .chezmoi.homeDir)
    "env" (dict
      "YNAB_ALLOW_WRITES" "1"
      "YNAB_DISABLE_AGENT_CONFIG_FALLBACK" "1"
      "YNAB_API_TOKEN" ((keepassxc "YNAB :: Personal Access Token").Password)) -}}
{{- $merged = setValueAtPath "mcpServers.ynab" $ynab $merged -}}

{{ $merged | toPrettyJson }}
