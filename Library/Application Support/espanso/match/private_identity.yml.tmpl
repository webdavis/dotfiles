matches:
  - trigger: ",,sad"
    replace: "Stephen A. Davis"

  - trigger: ",,sd"
    replace: "Stephen Davis"

  - trigger: ",,fn"
    replace: "Stephen"

  - trigger: ",,ln"
    replace: "Davis"

  - trigger: ",,ew"
    replace: "stephen@webdavis.io"

  - trigger: ",,epw"
    replace: "stephen+$|$@webdavis.io"

  - trigger: ",,eg"
    replace: "sdstephena@gmail.com"

  - trigger: ",,epg"
    replace: "sdstephena+$|$@gmail.com"

  - trigger: ",,er"
{{- if (env "CI") }}
    replace: "FAKE_READWISE_FEED_EMAIL"
{{- else }}
    replace: {{ keepassxcAttribute "readwise" "feed-email-address" | quote }}
{{- end }}

  - trigger: ",,wa"
    replace: "With Appreciation,\nStephen Davis"

  - trigger: ",,br"
    replace: "Best,\nStephen Davis"

  - trigger: ",,sig"
    replace: "Best,\nStephen Davis\nstephen@webdavis.io"

  - trigger: ",,ma"
{{- if (env "CI") }}
    replace: "FAKE_ADDRESS"
{{- else }}
    replace: {{ (keepassxc "Personal :: Address").Password | quote }}
{{- end }}

  - trigger: ",,pn"
{{- if (env "CI") }}
    replace: "FAKE_PHONE"
{{- else }}
    replace: {{ (keepassxc "Personal :: Phone").Password | quote }}
{{- end }}

  - trigger: ",,pf"
{{- if (env "CI") }}
    replace: "FAKE_PHONE_FORMATTED"
{{- else }}
    replace: {{ (keepassxc "Personal :: Phone").UserName | quote }}
{{- end }}
