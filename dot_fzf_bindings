# shellcheck shell=bash
# vi: set filetype=sh:

__fzf_shell_root=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)
if [[ -d $__fzf_shell_root/dot_config/fzf-pickers/lib/shell ]]; then
  __fzf_shell_root+=/dot_config/fzf-pickers/lib/shell
else
  __fzf_shell_root=$HOME/.config/fzf-pickers/lib/shell
fi
# shellcheck source=dot_config/fzf-pickers/lib/shell/callbacks.sh
source "$__fzf_shell_root/callbacks.sh"
# shellcheck source=dot_config/fzf-pickers/lib/shell/setup.sh
source "$__fzf_shell_root/setup.sh"
[[ ${FZF_PICKERS_TEST-} == 1 ]] || __fzf_setup "$__fzf_shell_root"
unset __fzf_shell_root
