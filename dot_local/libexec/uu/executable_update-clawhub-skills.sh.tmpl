#!/usr/bin/env bash

set -euo pipefail

{{ includeTemplate "skills-store-lib.sh.tmpl" }}

readonly exit_needs_you=100
readonly exit_failed=1
readonly codex_file_ignore_rule='agents/openai.yaml'
readonly clawhub_skills=(
{{- range .agents.skills.from_clawhub }}
  {{ .name | quote }}
{{- end }}
)
readonly on_demand_skills=(
{{- range .agents.skills.from_clawhub }}
{{- if has .name $.agents.skills.on_demand }}
  {{ .name | quote }}
{{- end }}
{{- end }}
)

installed_version() {
  local skill=$1
  local origin="$skills_store/$skill/.clawhub/origin.json"
  if [[ -f $origin ]]; then
    jq -r '.installedVersion // empty' "$origin"
  fi
}

codex_file_is_ignored() {
  local skill=$1
  grep -qxF "$codex_file_ignore_rule" "$skills_store/$skill/.clawhubignore" 2>/dev/null
}

ignore_codex_file() {
  local skill=$1
  printf '%s\n' "$codex_file_ignore_rule" >>"$skills_store/$skill/.clawhubignore"
}

update_skill() {
  local skill=$1
  clawhub --no-input --workdir "$HOME/.agents" --dir skills update "$skill" </dev/null
}

output_mentions() {
  local output=$1 phrase=$2
  grep -qiF "$phrase" <<<"$output"
}

main() {
  if ! skills_folder_lock_is_held; then
    run_holding_skills_folder_lock "$@"
  fi

  local failed=no needs_you=no skill old new output
  for skill in "${clawhub_skills[@]}"; do
    if ! skill_is_installed "$skill"; then
      continue
    fi
    if ! codex_file_is_ignored "$skill"; then
      ignore_codex_file "$skill"
    fi
    old="$(installed_version "$skill")"
    if ! output="$(update_skill "$skill" 2>&1)"; then
      printf 'error[update-failed]: %s could not be updated:\n%s\n' "$skill" "$output" >&2
      failed=yes
    elif output_mentions "$output" 'local changes'; then
      printf 'error[local-changes]: %s has local changes, so ClawHub left it alone:\n%s\n' "$skill" "$output" >&2
      needs_you=yes
    elif output_mentions "$output" 'blocked as malicious'; then
      printf 'error[blocked]: ClawHub blocked %s as malicious:\n%s\n' "$skill" "$output" >&2
      failed=yes
    elif output_mentions "$output" 'not found'; then
      printf 'error[not-found]: ClawHub could not find %s:\n%s\n' "$skill" "$output" >&2
      failed=yes
    else
      new="$(installed_version "$skill")"
      if [[ $old != "$new" ]]; then
        printf '%s: %s → %s\n' "$skill" "$old" "$new"
      fi
    fi
  done

  for skill in "${on_demand_skills[@]}"; do
    if ! mark_codex_file_on_demand "$skill"; then
      printf 'error[codex-setting]: %s could not be set to load only when asked in Codex.\n' "$skill" >&2
      failed=yes
    fi
  done

  if [[ $failed == yes ]]; then
    exit "$exit_failed"
  fi
  if [[ $needs_you == yes ]]; then
    exit "$exit_needs_you"
  fi
}

main "$@"
