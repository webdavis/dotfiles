#!/usr/bin/env bash

set -euo pipefail

readonly declared_tools=(
{{- range .packages.macos.uv }}
  {{ regexReplaceAll "\\[.*\\]$" . "" | quote }}
{{- end }}
)

uv_is_installed() {
  command -v uv >/dev/null 2>&1
}

installed_tool_versions() {
  local listing
  listing="$(uv tool list 2>/dev/null)" || return 1
  awk '/^[^-[:space:]]/ && $2 ~ /^v./ { print $1 "\t" substr($2, 2) }' <<<"$listing"
}

upgrade_all_tools() {
  uv tool upgrade --all 2>&1
}

print_version_changes() {
  local versions_before=$1 versions_after=$2
  awk -F '\t' 'NR == FNR { before[$1] = $2; next } NF && ($1 in before) && before[$1] != $2 { print $1 ": " before[$1] " → " $2 }' \
    <(printf '%s\n' "$versions_before") <(printf '%s\n' "$versions_after")
}

print_undeclared_tools() {
  local versions=$1
  awk -F '\t' 'NR == FNR { declared[$0]; next } NF && !($1 in declared) { print "undeclared: " $1 " " $2 }' \
    <(printf '%s\n' "${declared_tools[@]}") <(printf '%s\n' "$versions")
}

main() {
  if ! uv_is_installed; then
    printf 'error[missing-tool]: uv is not installed.\n' >&2
    exit 1
  fi

  local versions_before
  if ! versions_before="$(installed_tool_versions)"; then
    printf 'error[listing-failed]: uv tool list failed.\n' >&2
    exit 1
  fi

  local upgrade_output upgrade_status=0
  upgrade_output="$(upgrade_all_tools)" || upgrade_status=$?

  local versions_after
  if ! versions_after="$(installed_tool_versions)"; then
    printf 'error[listing-failed]: uv tool list failed.\n' >&2
    exit 1
  fi

  print_version_changes "$versions_before" "$versions_after"
  print_undeclared_tools "$versions_after"

  if ((upgrade_status != 0)); then
    printf '%s\n' "$upgrade_output" >&2
    printf 'error[upgrade-failed]: uv tool upgrade --all failed.\n' >&2
    exit 1
  fi
}

main "$@"
