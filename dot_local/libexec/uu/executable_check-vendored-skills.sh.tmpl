#!/usr/bin/env bash

set -euo pipefail

readonly exit_needs_you=100
readonly exit_failed=1
readonly exit_timed_out=124
readonly git_time_limit_seconds=300
readonly vendored_upstreams=(
{{- range .agents.skills.vendored }}
{{- if hasKey . "upstream" }}
  {{ printf "%s %s %s %s" .name .upstream.url .upstream.path .upstream.last_compared | quote }}
{{- end }}
{{- end }}
)

clean_git() {
  local private_home=$1
  shift
  timeout "$git_time_limit_seconds" env -i \
    PATH=/usr/bin:/bin \
    HOME="$private_home" \
    GIT_CONFIG_GLOBAL=/dev/null \
    GIT_CONFIG_NOSYSTEM=1 \
    GIT_TERMINAL_PROMPT=0 \
    GIT_ASKPASS=/usr/bin/false \
    SSH_ASKPASS=/usr/bin/false \
    /usr/bin/git "$@" </dev/null
}

clone_upstream() {
  local private_home=$1 url=$2 clone=$3
  clean_git "$private_home" clone --quiet --depth 1 --no-checkout -- "$url" "$clone"
}

upstream_tree() {
  local private_home=$1 clone=$2 path=$3
  local revision="HEAD:$path"
  if [[ $path == "." ]]; then
    revision='HEAD^{tree}'
  fi
  clean_git "$private_home" -C "$clone" rev-parse --verify --quiet "$revision"
}

main() {
  local work
  work="$(mktemp -d)"

  local failed=no needs_you=no entry name url path last_compared clone output status current
  for entry in "${vendored_upstreams[@]}"; do
    read -r name url path last_compared <<<"$entry"
    clone="$work/$name"
    status=0
    output="$(clone_upstream "$work" "$url" "$clone" 2>&1)" || status=$?
    if ((status == exit_timed_out)); then
      printf 'error[clone-timed-out]: %s: %s did not answer within %s seconds.\n' "$name" "$url" "$git_time_limit_seconds" >&2
      failed=yes
    elif ((status != 0)); then
      printf 'error[clone-failed]: %s: %s could not be cloned:\n%s\n' "$name" "$url" "$output" >&2
      failed=yes
    elif ! current="$(upstream_tree "$work" "$clone" "$path")"; then
      printf 'error[path-missing]: %s: %s has no %s; point the upstream path at where the skill lives now.\n' "$name" "$url" "$path" >&2
      needs_you=yes
    elif [[ $current != "$last_compared" ]]; then
      printf '%s: %s → %s\n' "$name" "$last_compared" "$current"
      needs_you=yes
    fi
  done

  rm -rf "$work"

  if [[ $failed == yes ]]; then
    exit "$exit_failed"
  fi
  if [[ $needs_you == yes ]]; then
    exit "$exit_needs_you"
  fi
}

main "$@"
