# shellcheck shell=bash

alias ga='git add'
alias gcm='git checkout main'
alias gca='git commit -a --amend -C HEAD --'
alias gcan='git commit --amend --no-edit'
alias gamend='git commit --amend --reuse-message=HEAD'
alias glg='git log --pretty=oneline -n 20 --graph --abbrev-commit'
alias gmm='git merge origin/main'
alias gs='git status -s'
alias gsf='git status'
alias gts='git tag --list --sort=v:refname'
alias gundo='git reset --soft HEAD~1'
alias gunstage='git restore --staged'
alias grecent='git for-each-ref --sort=-committerdate --count=10 --format="%(refname:short)" refs/heads'
alias gwhoami='git config --get user.name'

# zoxide loads later in ~/.bashrc; the alias expands only when used, so the order works.
alias cd='z'
alias ..='cd ..'
alias ...='cd ../..'
alias ....='cd ../../..'

# --icons needs its value after =, or eza reads the next word as the value.
alias ls='eza --icons=auto'
alias ll='eza -la --git --icons=auto'
alias la='eza -a --icons=auto'
alias lt='eza --tree --level=2 --icons=auto --git-ignore'
alias tree='tree -C'

alias bat='bat --color=always'
alias du='dust'
alias ps='procs'
alias grep='grep --color=auto'
alias p='python3'

alias cp='cp -i'
alias mv='mv -i'

# Runs the prefix+ctrl+h chord's action, so its label and folder live in the plugin manifest.
alias h='herdr plugin action invoke herdr-picker.jump_homelab'
alias fman='compgen -c | fzf | xargs man'
alias path='echo $PATH | tr ":" "\n"'
alias pubip='dig +short myip.opendns.com @resolver1.opendns.com'
alias timer='echo "Timer started. Stop with Ctrl-D." && time cat'
alias git-weekly='git diff --name-status "@{7 days ago}" | sort -u | grep -v "Templates" > weekly-review-files.md'
{{- if eq .chezmoi.os "darwin" }}

alias ping='ping --apple-time'
alias bu='brew upgrade --formula'
alias rm='trash-put'
{{- end }}
