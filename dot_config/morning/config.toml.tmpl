# morning: where the day's brief reads each of its answers from.
#
# EVERY PATH IS CONFIG, and nothing here is compiled into the binary: morning
# is installed with `cargo install` and has to work on a machine where this
# repository does not exist. A source left empty is not an error; the page
# prints its section and says the source is not configured.
#
# Every key is shown at its default, and every source is read at the same time
# as the others, so the page costs the slowest source rather than all of them.

# How long any one source gets before it is abandoned and its section says so.
timeout_seconds = 8.0

# How many rows a section prints before it says how many it held back. This is
# what keeps a ledger with seventy open items a page rather than a list.
rows_per_section = 8

# The transcript `just a` writes, which carries the last apply's result and the
# time it finished.
[apply_log]
path = "{{ joinPath .chezmoi.homeDir ".local/state/chezmoi-apply/latest.apply.log" }}"

# The ledger, read as a checklist. An open `- [ ]` item that mentions one of
# these phrases, in the item or in the lines indented under it, is reported in
# the matching section.
[ledger]
path = "{{ joinPath .chezmoi.sourceDir "docs/remaining-work.md" }}"
apply_markers = ["chezmoi apply"]
operator_markers = ["operator"]

# The newest file in this directory is the overnight recap. Empty until
# something writes recaps to a directory of their own.
[recap]
directory = ""
lines = 20

# The open pull requests and their CI state. `gh` is spawned with its own
# credentials; morning never reads a token.
[pull_requests]
command = [
  "gh",
  "pr",
  "list",
  "--repo",
  "webdavis/dotfiles",
  "--json",
  "number,title,statusCheckRollup",
  "--jq",
  '.[] | "#\(.number) \(.title) [\(.statusCheckRollup | map(.conclusion) | if length == 0 then "no checks" elif any(. == "FAILURE") then "failing" elif any(. == null) then "running" else "green" end)]"',
]

# Today's tasks, through the Todoist CLI, which carries its own credentials too.
[tasks]
command = ["td", "--no-spinner", "today"]
