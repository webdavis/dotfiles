[paths]
state = "{{ .chezmoi.homeDir }}/.local/state/uu"

[schedule]
default = "sunday 12:00"
label = "uu.daemon"

[history]
previous_runs_kept = 52

[logs]
rotate = true
max_size = "10 MB"
previous_logs_kept = 3

[tui]
default_screen = "runs"
theme = "catppuccin-macchiato"
mouse = true
runs = 20

[report]
command = ["{{ .chezmoi.homeDir }}/.local/libexec/uu/send-report-to-hermes.sh"]

[alert]
command = ["{{ .chezmoi.homeDir }}/.local/libexec/uu/send-alert-to-pns.sh"]

[lane.app-store]
command = ["{{ .chezmoi.homeDir }}/.local/libexec/uu/update-app-store.sh"]
env = {}
scheduled = true
deadline_secs = 21600
escalate_after_runs = 3

