[paths]
state = "{{ .chezmoi.homeDir }}/.local/state/uu"

[schedule]
default = "sunday 12:00"
label = "uu.daemon"

[history]
previous_runs_kept = 52

[logs]
rotate = true
max_size = "10 MB"
previous_logs_kept = 3

[tui]
default_screen = "runs"
theme = "catppuccin-macchiato"
mouse = true
runs = 20

[report]
command = ["scripts/send-report-to-hermes.sh"]

[alert]
command = ["scripts/send-alert-to-pns.sh"]

[lane.app-store]
command = ["scripts/update-app-store.sh"]
env = {}
scheduled = true
time_limit = "6 hours"
unsuccessful_runs_before_alert = 3

[lane.bgutil-ytdlp-pot-provider]
command = ["scripts/update-bgutil-ytdlp-pot-provider.sh"]
env = {}
scheduled = true
time_limit = "6 hours"
unsuccessful_runs_before_alert = 3

[lane.brew]
command = ["scripts/update-brew.sh"]
env = {}
scheduled = true
time_limit = "6 hours"
unsuccessful_runs_before_alert = 3

[lane.cargo]
builtin = "cargo"
env = {}
scheduled = true
time_limit = "6 hours"
unsuccessful_runs_before_alert = 3

[lane.cargo.settings]
upgrade = false
skip = []

[lane.claude-plugins]
builtin = "claude-plugins"
env = {}
scheduled = true
time_limit = "6 hours"
unsuccessful_runs_before_alert = 3

[lane.claude-plugins.settings]
skip = []

[lane.clawhub-skills]
builtin = "clawhub-skills"
env = {}
scheduled = true
time_limit = "6 hours"
unsuccessful_runs_before_alert = 3

[lane.clawhub-skills.settings]
workdir = "{{ .chezmoi.homeDir }}/.agents"
skills = [
{{- range .agents.skills.from_clawhub }}
  {{ .name | quote }},
{{- end }}
]

[lane.codegraph]
builtin = "codegraph"
env = {}
scheduled = true
time_limit = "6 hours"
unsuccessful_runs_before_alert = 3

[lane.codegraph.settings]

[lane.codex-plugins]
builtin = "codex-plugins"
env = {}
scheduled = true
time_limit = "6 hours"
unsuccessful_runs_before_alert = 3

[lane.codex-plugins.settings]
skip = []

[lane.composio]
builtin = "composio"
env = {}
scheduled = true
time_limit = "6 hours"
unsuccessful_runs_before_alert = 3

[lane.composio.settings]
composio = "{{ .chezmoi.homeDir }}/.composio/composio"

[lane.cua-driver-skills]
builtin = "cua-driver-skills"
env = {}
scheduled = true
time_limit = "6 hours"
unsuccessful_runs_before_alert = 3

[lane.cua-driver-skills.settings]

[lane.herdr]
command = ["scripts/update-herdr-plugins.sh"]
env = {}
scheduled = true
time_limit = "6 hours"
unsuccessful_runs_before_alert = 3

[lane.herdr-binary]
command = ["{{ .chezmoi.homeDir }}/.local/bin/herdr", "update"]
env = {}
scheduled = true
time_limit = "6 hours"
unsuccessful_runs_before_alert = 3

[lane.hermes-plugins]
builtin = "hermes-plugins"
env = {}
scheduled = true
time_limit = "6 hours"
unsuccessful_runs_before_alert = 3

[lane.hermes-plugins.settings]
skip = []

[lane.hermes-skills]
builtin = "hermes-skills"
env = {}
scheduled = true
time_limit = "6 hours"
unsuccessful_runs_before_alert = 3

[lane.hermes-skills.settings]
profiles = [
{{- range $profile, $settings := .agents.hermes.profiles }}
{{- if hasKey $settings "hub_skills" }}
  {{ $profile | quote }},
{{- end }}
{{- end }}
]

[lane.npm]
builtin = "npm"
env = {}
scheduled = true
time_limit = "6 hours"
unsuccessful_runs_before_alert = 3

[lane.npm.settings]
skip = []

[lane.npx-skills]
builtin = "npx-skills"
env = {}
scheduled = true
time_limit = "6 hours"
unsuccessful_runs_before_alert = 3

[lane.npx-skills.settings]
repos = [
{{- range .agents.skills.from_github }}
  {{ printf "%s %s" .repo (join " " .skills) | quote }},
{{- end }}
]
agents = ["codex"]
skills_version = {{ .agents.skills.skills_cli_version | quote }}

[lane.nvim-mason]
builtin = "nvim-mason"
env = {}
scheduled = true
time_limit = "6 hours"
unsuccessful_runs_before_alert = 3

[lane.nvim-mason.settings]
config = "{{ .chezmoi.homeDir }}/.config/nvim"

[lane.nvim-parsers]
builtin = "nvim-parsers"
env = {}
scheduled = true
time_limit = "6 hours"
unsuccessful_runs_before_alert = 3

[lane.nvim-parsers.settings]
config = "{{ .chezmoi.homeDir }}/.config/nvim"

[lane.nvim-plugins]
builtin = "nvim-plugins"
env = {}
scheduled = true
time_limit = "6 hours"
unsuccessful_runs_before_alert = 3

[lane.nvim-plugins.settings]
config = "{{ .chezmoi.homeDir }}/.config/nvim"
mode = "restore"

[lane.plannotator]
builtin = "plannotator"
env = {}
scheduled = true
time_limit = "6 hours"
unsuccessful_runs_before_alert = 3

[lane.plannotator.settings]

[lane.rotate-logs]
builtin = "rotate-logs"
env = {}
scheduled = true
time_limit = "6 hours"
unsuccessful_runs_before_alert = 3

[lane.rotate-logs.settings]
files = [
  "{{ .chezmoi.homeDir }}/.local/log/atuin-daemon.log",
  "{{ .chezmoi.homeDir }}/.local/log/osquery/digest.log",
  "{{ .chezmoi.homeDir }}/.local/log/osquery/firewall-gatekeeper-monitor.log",
  "{{ .chezmoi.homeDir }}/.local/log/osquery/heartbeat.log",
  "{{ .chezmoi.homeDir }}/.local/log/osquery/results-alerter.log",
  "{{ .chezmoi.homeDir }}/.local/log/osquery/tailscale-monitor.log",
  "{{ .chezmoi.homeDir }}/.local/log/osquery/uptime-watchdog.log",
  "{{ .chezmoi.homeDir }}/.local/log/pns-daemon.log",
  "{{ .chezmoi.homeDir }}/.local/log/scalebar/scalebar.log",
  "{{ .chezmoi.homeDir }}/.local/log/yt-dlp/pot-provider.log",
]
max_size = "10 MB"
previous_logs_kept = 5

[lane.rustup]
builtin = "rustup"
env = {}
scheduled = true
time_limit = "6 hours"
unsuccessful_runs_before_alert = 3

[lane.rustup.settings]

[lane.uv]
builtin = "uv"
env = {}
scheduled = true
time_limit = "6 hours"
unsuccessful_runs_before_alert = 3

[lane.uv.settings]
skip = []

[lane.uv-graphify-skill]
command = [
  "/usr/bin/env",
  "CLAUDE_CONFIG_DIR={{ .chezmoi.homeDir }}/.local/share/graphify/claude",
  "{{ .chezmoi.homeDir }}/.local/bin/graphify",
  "install",
  "--platform",
  "claude",
]
env = {}
scheduled = true
time_limit = "1 minute"
unsuccessful_runs_before_alert = 3

[lane.vendored-skills-check]
builtin = "vendored-skills-check"
env = {}
scheduled = true
time_limit = "6 hours"
unsuccessful_runs_before_alert = 3

[lane.vendored-skills-check.settings]
checks = [
{{- range .agents.skills.vendored }}
{{- if hasKey . "upstream" }}
  {{ printf "%s %s %s" .name .upstream.url .upstream.path | quote }},
{{- end }}
{{- end }}
]
skills_dir = "{{ .chezmoi.homeDir }}/.agents/skills"

[lane.yt-dlp]
builtin = "yt-dlp"
env = {}
scheduled = true
time_limit = "6 hours"
unsuccessful_runs_before_alert = 3

[lane.yt-dlp.settings]

[group.skills]
lanes = ["npx-skills", "clawhub-skills", "cua-driver-skills"]
