# uu's lane selection. THE FILE SELECTS: a lane runs only when its
# [lanes.<name>] block exists, records post only when [records] exists, and
# alarms leave the machine only through configured destinations. With no file at all a
# bare `uu run` runs nothing and exits clean; `uu run <lane>` still asks for
# that lane by name and is refused with exit 1.
#
# Unknown keys are refused BY NAME at load, in the same sentence that lists
# what the table does serve, and so is a lane whose `type` this build does not
# serve, or that states none on a name that is not itself a type. A typo
# therefore blocks the whole file rather than quietly switching a lane off,
# which is the trade: the loud half is a refusal on stderr, and the quiet half
# it replaces is a subject that silently stops being updated.
#
# Every default is written out below at its default value, so nothing has to be
# looked up to change it.

# When `uu schedule render` prints a launchd job for. The tracked LaunchAgent
# is what actually schedules this machine; these two keys feed the rendered
# plist and nothing else.
[schedule]
day = "sunday"
time = "12:00"

# The weekly what-happened entry, signed and posted straight to the hermes
# gateway. Every entry states its own gap since the last clean run: launchd
# coalesces missed calendar slots, so a healthy job can produce one entry
# covering three weeks and a missing entry says nothing on its own.
[records]
url = "http://127.0.0.1:8644/webhooks/unattended-upgrades"
key = "{{ (keepassxc "Hermes :: Webhook Secret :: #pns").Password }}"
# Optional second destination for failed, stale, pending and record-lost alarms.
# Signed with the same key. Each configured destination is attempted once;
# a refusal stays retryable for one-shot alarms without changing the run verdict.
# failure_webhook = "http://127.0.0.1:8644/webhooks/unattended-upgrades-failures"

# Where a failed lane is reported. uu is a client here and takes no delivery
# decision: pns owns presence and escalation. An engine that is not there leaves
# the failure logged and the run clean.
[alerts]
binary = "{{ joinPath .chezmoi.homeDir .rust_tools.install_dir "pns" }}"

# herdr and every GitHub-sourced plugin, refreshed weekly. herdr has no
# `plugin update`, so a refresh is an uninstall followed by a fresh install,
# which re-pins at the source's tip; an install that fails is retried once and a
# plugin that still failed is named in the record and stays missing until the
# next apply. Local plugins are built from source at apply time and are not
# listed here.
#
# Lanes run in NAME order, not the order they are written below: `brew` runs
# before `herdr` regardless of where either block sits in this file.
[lanes.herdr]
type = "herdr"
binary = "{{ .chezmoi.homeDir }}/.local/bin/herdr"
deadline_secs = 21600
plugins = [
{{- range .packages.herdr_plugins }}
  { id = {{ .id | quote }}, repo = {{ .repo | quote }} },
{{- end }}
]

# Homebrew formulae and casks, Mac App Store apps, and the two repairs an
# upgrade makes necessary. Every path below is at its default; change one only
# on a machine whose Homebrew prefix or state directory differs.
#
# THE CONVERGE AND THE UPGRADE RECORD HAPPEN INSIDE THIS LANE. The osquery cask
# reinstall wipes our config, packs and flags out of /var/osquery, and this
# lane is the only thing on the machine that upgrades that cask, so the repair
# runs immediately after `brew upgrade` and a converge tool that is not
# deployed is a FAILED step rather than a quiet skip. The upgrade record is the
# tab-separated file the osquery file-integrity page correlates a changed file
# against, by that literal path; leave `upgrade_record` empty and the lane
# still upgrades, while that page reports no recorded upgrade forever.
#
# THE ONE BOUND THAT IS NOT THE LANE'S. `mas outdated`, `mas upgrade` and the
# declaration sync each run under 180 seconds of their own, because the App
# Store hangs indefinitely on a wedged session and `deadline_secs` covers the
# WHOLE lane: an unbounded mas step is a week in which nothing after it ran.
# Nothing else here is bounded per step, so a `brew upgrade` that never returns
# still costs the lane its deadline and every lane after it in name order.
[lanes.brew]
type = "brew"
brew = "/opt/homebrew/bin/brew"
mas = "/opt/homebrew/bin/mas"
tailscaled = "/opt/homebrew/opt/tailscale/bin/tailscaled"
osquery_converge = "{{ .chezmoi.homeDir }}/.local/libexec/osquery/osquery-converge.sh"
mas_manifest = "{{ .chezmoi.homeDir }}/.local/state/homebrew/mas.Brewfile"
upgrade_record = "{{ .chezmoi.homeDir }}/.local/state/homebrew-weekly-upgrade/last-upgrade-changes.tsv"
deadline_secs = 21600

# Every globally installed npm package upgraded, weekly, ON FNM'S NODE. npm is
# an `#!/usr/bin/env node` script, so the node PATH answers with is the node it
# runs on and the prefix it installs into: the lane runs npm with its own
# directory first on PATH, which is why the path below is stated in full and a
# bare `npm` is refused. Nothing in the LaunchAgent's PATH has to say fnm.
# The exit code is the verdict, and a week with nothing to upgrade records one
# ok line; an npm that is not at this path is a FAILURE rather than the quiet
# skip the old weekly job made of it.
[lanes.npm]
type = "npm"
binary = "{{ .chezmoi.homeDir }}/.local/share/fnm/aliases/default/bin/npm"
deadline_secs = 21600

# Every tool uv installed, upgraded in place, weekly: `uv tool upgrade --all`
# is already the whole roster, so there is nothing to list here. uv narrates on
# stderr, which a clean run drops, so a clean week records one ok line and
# nothing else; the exit code is the verdict. A uv that is not installed at the
# path below is a FAILURE rather than the quiet skip the old weekly job made of
# it, because a declared lane that upgrades nothing is the thing worth hearing
# about.
[lanes.uv]
type = "uv"
binary = "/opt/homebrew/bin/uv"
deadline_secs = 21600

# Every crate `cargo install` put on this machine, checked against the registry.
# REPORTS RATHER THAN COMPILES: a `cargo install` builds from source, minutes per
# crate on an unattended run, so a crate that is behind is reported as PENDING
# with the exact command to run. Set `compile = true` to have the lane build them
# instead. A git-installed crate is named and skipped, because crates.io has no
# version of it to compare against.
[lanes.cargo]
type = "cargo"
cargo = "{{ .chezmoi.homeDir }}/.cargo/bin/cargo"
compile = false
deadline_secs = 21600

# A `command` lane is the PRODUCER API: it runs ANY executable under uu's
# locked contract (a JSON run event on stdin, the exit code as the verdict),
# with no core code to touch. Uncomment and rename the block to turn one on;
# the lane's name is your own choice.
#
# `run[0]` is the program, `run[1..]` its arguments, and argv[0] the child
# sees is `run[0]` verbatim. Env and working directory are INHERITED from uu's
# own process; under the tracked LaunchAgent that is the plist's own PATH plus
# HOME, with the working directory at `/`.
#
# `deadline_secs` bounds the WHOLE LANE, not each command it runs, and every
# lane has one whether or not its block says so (six hours by default). The
# child runs in a process group of its own, so a child that leaves something
# behind holding its stdout or stderr open (a backgrounded process, a detached
# daemon) has that group killed at the deadline instead of stalling uu
# forever; the lane then reports the overrun as an ordinary failure. The run
# lock is held across lane execution, which is why the bound matters: a lane
# that never ends is a lock every later run waits on and never gets.
#
# THE WHOLE RUN IS BOUNDED AT 24 HOURS as well, and that is not configurable.
# Lanes run in sequence under one lock, so enough lanes at six hours each
# would outlast the week; a lane starting late gets what is left of the day
# rather than its own full deadline, and says so when it is stopped there.
#
# EXIT 75 MEANS DEFERRED, not failed: nothing was attempted, so try again
# later. This is the exit code the program itself chooses to return, matching
# the two weekly jobs uu's command lane can eventually replace, both of which
# already use 75 for "another run holds the lock". A deferred lane never
# counts as a failure and never advances the last-success marker; the record
# still names it "deferred" so a quiet week reads differently from a week
# nothing needed to happen. What a deferral withholds is specifically uu's OWN
# per-run failure alert, because the lane did not run: it is not a promise of
# silence. The lane's own program may still alert on its own account, a
# record the gateway never received alerts regardless of what any lane did,
# and three straight non-successes (deferred, failed, or a mix) still fire
# uu's own staleness alert below. Exit 100 means pending; every other non-zero
# exit is a real failure.
# THE COLLISION: 75 is also the exit code hermes's own gateway process uses
# to ask its service manager for a planned restart, so a program that IS
# hermes, or that forwards hermes's own exit code unchanged, could exit 75
# for a reason that has nothing to do with deferral; write your own exit
# code rather than passing one through.
#
# EXIT 100 MEANS PENDING: the check succeeded, but updates need operator action.
# It keeps stdout and the stderr reason, counts as neither failure nor deferral,
# and allows the last-success marker to advance after the record is delivered.
# `escalate_after_runs` defaults to 3 for every lane. Consecutive pending runs
# trigger one alarm at that count; any non-pending verdict resets the count.
# A refused alarm stays eligible on the next pending run.
#
# A lane that goes three straight runs without a real success (deferred,
# failed, or both) fires one staleness alert of its own, whatever each
# individual run's own alert did or did not say.
# [lanes.example]
# type = "command"
# run = ["/usr/local/bin/my-updater", "--yes"]
# deadline_secs = 21600
# escalate_after_runs = 3

# Check the committed Neovim plugin pins without changing them. Enabling
# auto_commit also requires clean, matching source, deployed and installed pins.
# Failed auto-commit retains recovery state until those pins are reconciled.
[lanes.nvim-plugins]
type = "nvim-plugins"
nvim = "/opt/homebrew/bin/nvim"
config = "{{ .chezmoi.homeDir }}/.config/nvim"
auto_commit = false
repo = "{{ .chezmoi.sourceDir }}"
escalate_after_runs = 3
deadline_secs = 21600

# Update Mason's configured tools. Language servers remain an operator action in :Mason.
[lanes.nvim-mason]
type = "nvim-mason"
nvim = "/opt/homebrew/bin/nvim"
config = "{{ .chezmoi.homeDir }}/.config/nvim"
deadline_secs = 21600

# Reconcile installed parsers to the revisions pinned by the Treesitter plugin.
[lanes.nvim-parsers]
type = "nvim-parsers"
nvim = "/opt/homebrew/bin/nvim"
config = "{{ .chezmoi.homeDir }}/.config/nvim"
deadline_secs = 21600

# Opt-in: prepare candidate plugins in a private config and data tree, then
# verify startup in a fresh Neovim process. The retained plugin and copied Mason
# trees cost roughly 2.5 gigabytes (2026-09-06 measurement). Health and keymap
# reports stay under cache. Uncomment to enable; trash that cache to reclaim space.
# [lanes.nvim-smoke-test]
# type = "nvim-smoke-test"
# nvim = "/opt/homebrew/bin/nvim"
# config = "{{ .chezmoi.homeDir }}/.config/nvim"
# cache = "{{ .chezmoi.homeDir }}/.cache/uu/nvim-smoke-test"
# deadline_secs = 21600

# Record user-scope Claude Code plugin changes; Claude Code performs the updates itself.
[lanes.claude-plugins]
type = "claude-plugins"
inventory = "{{ .chezmoi.homeDir }}/.claude/plugins/installed_plugins.json"
deadline_secs = 21600

# Refresh the skills store and report required failures and advisory fork drift.
[lanes.skills]
type = "skills"
lock = "{{ .chezmoi.homeDir }}/.agents/custom-skill-lock.json"
agents = "{{ .chezmoi.homeDir }}/.agents"
claude_skills = "{{ .chezmoi.homeDir }}/.claude/skills"
hermes = "{{ .chezmoi.homeDir }}/.hermes"
npx = "{{ .chezmoi.homeDir }}/.local/share/fnm/aliases/default/bin/npx"
skills_cli_version = "1.5.22"
clawhub = "{{ .chezmoi.homeDir }}/.local/share/fnm/aliases/default/bin/clawhub"
hermes_cli = "{{ .chezmoi.homeDir }}/.local/bin/hermes"
cua_driver = "/opt/homebrew/bin/cua-driver"
routing = "{{ .chezmoi.homeDir }}/.local/libexec/unattended-upgrades/agent-skills/assert-hermes-superpowers-routing.sh"
escalate_after_runs = 3
deadline_secs = 21600

# Rotate only these logs, preserving their open descriptors. Weekly rotation keeps
# five generations; a log can grow past the threshold until the next weekly run.
# A path that does not exist yet is skipped, not an error.
[lanes.rotate-logs]
type = "rotate-logs"
rotate_at_bytes = 10485760
archives_kept = 5
compressor = "/usr/bin/gzip"
logs = [
  "{{ .chezmoi.homeDir }}/.local/log/atuin-daemon.log",
  "{{ .chezmoi.homeDir }}/.local/log/graphify/dotfiles-post-commit.log",
  "{{ .chezmoi.homeDir }}/.local/log/happy-daemon.log",
  "{{ .chezmoi.homeDir }}/.local/log/osquery/alert-drainer.log",
  "{{ .chezmoi.homeDir }}/.local/log/osquery/digest.log",
  "{{ .chezmoi.homeDir }}/.local/log/osquery/firewall-gatekeeper-monitor.log",
  "{{ .chezmoi.homeDir }}/.local/log/osquery/heartbeat.log",
  "{{ .chezmoi.homeDir }}/.local/log/osquery/results-alerter.log",
  "{{ .chezmoi.homeDir }}/.local/log/osquery/tailscale-monitor.log",
  "{{ .chezmoi.homeDir }}/.local/log/osquery/uptime-watchdog.log",
  "{{ .chezmoi.homeDir }}/.local/log/pns-daemon.log",
  "{{ .chezmoi.homeDir }}/.local/log/scalebar/scalebar.log",
  "{{ .chezmoi.homeDir }}/.local/log/uu/uu.log",
  "{{ .chezmoi.homeDir }}/.local/log/yt-dlp/pot-provider.log",
]
deadline_secs = 21600
