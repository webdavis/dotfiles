{{- $d := includeTemplate "agent-derived.json.tmpl" . | fromJson -}}
{{- $npxRows := list -}}
{{- $nameRows := list -}}
{{- range $d.npx -}}
{{-   if .on_demand -}}{{- $npxRows = append $npxRows (printf "%s %s" .source (.path | default "-")) -}}{{- end -}}
{{- end -}}
{{- range $d.clawhub -}}
{{-   if .on_demand -}}{{- $nameRows = append $nameRows .name -}}{{- end -}}
{{- end -}}
{{- range $d.linked -}}
{{-   if and (has .kind (list "but" "apps")) (has .match $d.on_demand_codex) -}}{{- $nameRows = append $nameRows .match -}}{{- end -}}
{{- end -}}
#!/usr/bin/env bash
# Marks the on-demand store skills only-when-asked in Codex, by writing
# `policy.allow_implicit_invocation: false` into each one's agents/openai.yaml,
# and gives every other store skill its original file back. The apply runs it
# from .chezmoiscripts/run_onchange_after_64-install-agent-skills.sh.tmpl and
# the uu `skills-on-demand` lane runs it after the weekly updates, since an
# update replaces the folder and the file with it.

set -euo pipefail

readonly skills_folder="$HOME/.agents/skills"
readonly skills_lock="$HOME/.agents/.skill-lock.json"
readonly codex_ask_first_expression='.policy.allow_implicit_invocation = false'
readonly original_file_marker='# uu-original-openai: '
# One row per on-demand npx entry: <owner/repo> <path inside it, or ->. The
# skill names come from the skills CLI's lock file at run time, so a skill the
# repository adds between applies is marked too.
readonly on_demand_npx_rows={{ join "\n" $npxRows | squote }}
# One row per on-demand clawhub, but or apps skill: its store name.
readonly on_demand_names={{ join "\n" $nameRows | squote }}

print_error() {
  local kind=$1 message=$2
  printf 'error[%s]: %s\n' "$kind" "$message" >&2
}

tool_is_installed() {
  local tool=$1
  command -v "$tool" >/dev/null 2>&1
}

non_blank_lines_of() {
  local text=$1
  sed '/^[[:space:]]*$/d' <<<"$text"
}

skill_is_installed() {
  local skill=$1
  [[ -f $skills_folder/$skill/SKILL.md ]]
}

lock_skill_names_of() {
  local source=$1 path=$2
  [[ -f $skills_lock ]] || return 0
  [[ $path == - ]] && path=""
  jq -r --arg source "$source" --arg path "$path" '
    .skills // {} | to_entries[]
    | select(.value.source == $source and ($path == "" or ((.value.skillPath // "") | startswith($path + "/"))))
    | .key' "$skills_lock"
}

on_demand_skills() {
  local source path
  while read -r source path; do
    lock_skill_names_of "$source" "$path"
  done < <(non_blank_lines_of "$on_demand_npx_rows")
  non_blank_lines_of "$on_demand_names"
}

codex_file_of() {
  local skill=$1
  printf '%s\n' "$skills_folder/$skill/agents/openai.yaml"
}

yaml_asks_first() {
  local yaml=$1
  [[ $(yq '.policy.allow_implicit_invocation' - <<<"$yaml" 2>/dev/null) == false ]]
}

codex_file_asks_first() {
  local codex_file=$1
  [[ -f $codex_file ]] && yaml_asks_first "$(<"$codex_file")"
}

codex_file_keeps_original() {
  local codex_file=$1
  [[ -f $codex_file && $(tail -n 1 "$codex_file") == "$original_file_marker"* ]]
}

saved_original_in() {
  local codex_file=$1
  local last_line
  last_line="$(tail -n 1 "$codex_file")"
  printf '%s\n' "${last_line#"$original_file_marker"}"
}

original_as_json() {
  local codex_file=$1
  if codex_file_keeps_original "$codex_file"; then
    saved_original_in "$codex_file"
  elif [[ -f $codex_file ]]; then
    jq -Rs . <"$codex_file"
  else
    printf 'null\n'
  fi
}

original_text_of() {
  local original_json=$1
  jq -e -j 'strings' <<<"$original_json"
}

render_ask_first_codex_file() {
  local original_json=$1
  local rendered
  if [[ $original_json == null ]]; then
    rendered="$(yq -n "$codex_ask_first_expression")" || return 1
  else
    rendered="$(original_text_of "$original_json" | yq "$codex_ask_first_expression" -)" || return 1
  fi
  yaml_asks_first "$rendered" || return 1
  printf '%s\n%s%s\n' "$rendered" "$original_file_marker" "$original_json"
}

write_ask_first_codex_file() {
  local skill=$1
  local codex_file original_json content
  codex_file="$(codex_file_of "$skill")"
  if ! skill_is_installed "$skill" || codex_file_asks_first "$codex_file"; then
    return 0
  fi
  if original_json="$(original_as_json "$codex_file")" &&
    content="$(render_ask_first_codex_file "$original_json")" &&
    mkdir -p "$(dirname "$codex_file")" &&
    printf '%s\n' "$content" >"$codex_file"; then
    printf '%s: marked only-when-asked\n' "$skill"
  else
    print_error codex-file-failed "could not mark $skill only-when-asked in Codex; check $codex_file is valid YAML"
    return 1
  fi
}

restore_codex_file_from() {
  local codex_file=$1 original_json=$2
  local original_text
  if [[ $original_json == null ]]; then
    rm -f "$codex_file"
    return
  fi
  original_text="$(original_text_of "$original_json" && printf x)" &&
    printf '%s' "${original_text%x}" >"$codex_file"
}

restore_original_codex_file() {
  local skill=$1
  local codex_file
  codex_file="$(codex_file_of "$skill")"
  if ! codex_file_keeps_original "$codex_file"; then
    return 0
  fi
  if restore_codex_file_from "$codex_file" "$(saved_original_in "$codex_file")"; then
    printf '%s: restored\n' "$skill"
  else
    print_error codex-file-failed "could not restore the original Codex file of $skill from $codex_file"
    return 1
  fi
}

# Every store skill carrying the marker that is no longer on demand gets its
# original file back; the marker is what says this script wrote the file.
marked_skills_not_on_demand() {
  local wanted=$1 codex_file skill
  for codex_file in "$skills_folder"/*/agents/openai.yaml; do
    [[ -f $codex_file ]] || continue
    codex_file_keeps_original "$codex_file" || continue
    skill="$(basename "$(dirname "$(dirname "$codex_file")")")"
    grep -qxF -- "$skill" <<<"$wanted" || printf '%s\n' "$skill"
  done
}

main() {
  local skill wanted failed=no
  if ! tool_is_installed yq || ! tool_is_installed jq; then
    print_error missing-tool "yq or jq is not installed, so no Codex file was changed"
    exit 1
  fi
  wanted="$(on_demand_skills | sort -u)"
  while read -r skill; do
    [[ -n $skill ]] && { write_ask_first_codex_file "$skill" || failed=yes; }
  done <<<"$wanted"
  while read -r skill; do
    [[ -n $skill ]] && { restore_original_codex_file "$skill" || failed=yes; }
  done < <(marked_skills_not_on_demand "$wanted")
  if [[ $failed == yes ]]; then
    exit 1
  fi
}

main "$@"
