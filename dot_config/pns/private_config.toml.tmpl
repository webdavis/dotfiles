{{- if eq .chezmoi.os "darwin" }}
[routes]
default = "pns-events"
urgent = "priority"

[plugins.phone]
enabled = true
type = "moshi"
device_token = {{ includeTemplate "secret.tmpl" (list "moshi_hook_device_token" "Password") | toToml }}
card_while_watching = false
ack_deadline = "5s"
marker_file = "~/.local/state/pns/phone-attention.marker"

[plugins.log]
enabled = true
type = "discord"
bot_token = {{ includeTemplate "secret.tmpl" (list "discord_bot_token_pns" "Password") | toToml }}

[plugins.log.keys]
pns-events = {{ includeTemplate "secret.tmpl" (list "hermes_webhook_pns_events" "Password") | toToml }}
posture-pages = {{ includeTemplate "secret.tmpl" (list "hermes_webhook_posture_pages" "Password") | toToml }}
priority = {{ includeTemplate "secret.tmpl" (list "hermes_webhook_priority" "Password") | toToml }}

[plugins.log.channels]
default = {{ includeTemplate "secret.tmpl" (list "discord_channel_github_notifications" "Password") | toToml }}
casually-concerned = {{ includeTemplate "secret.tmpl" (list "discord_channel_casually_concerned_dev" "Password") | toToml }}
dotfiles = {{ includeTemplate "secret.tmpl" (list "discord_channel_dotfiles_dev" "Password") | toToml }}
essential-feed-case-study = {{ includeTemplate "secret.tmpl" (list "discord_channel_essential_feed_case_study_dev" "Password") | toToml }}
homelab = {{ includeTemplate "secret.tmpl" (list "discord_channel_homelab_dev" "Password") | toToml }}
justdavis-ansible = {{ includeTemplate "secret.tmpl" (list "discord_channel_justdavis_ansible_dev" "Password") | toToml }}
netpulse = {{ includeTemplate "secret.tmpl" (list "discord_channel_netpulse_dev" "Password") | toToml }}
plantpulse = {{ includeTemplate "secret.tmpl" (list "discord_channel_plantpulse_dev" "Password") | toToml }}
pns = {{ includeTemplate "secret.tmpl" (list "discord_channel_pns_dev" "Password") | toToml }}
pns-events = {{ includeTemplate "secret.tmpl" (list "discord_channel_pns_events" "Password") | toToml }}
posture = {{ includeTemplate "secret.tmpl" (list "discord_channel_posture_dev" "Password") | toToml }}
posture-pages = {{ includeTemplate "secret.tmpl" (list "discord_channel_posture_pages" "Password") | toToml }}
priority = {{ includeTemplate "secret.tmpl" (list "discord_channel_priority" "Password") | toToml }}
scalebar = {{ includeTemplate "secret.tmpl" (list "discord_channel_scalebar_dev" "Password") | toToml }}
uu = {{ includeTemplate "secret.tmpl" (list "discord_channel_uu_dev" "Password") | toToml }}

[plugins.banner]
enabled = true
type = "macos"

[plugins.lights]
enabled = true
type = "hue"
bridge_host = {{ includeTemplate "secret.tmpl" (list "openhue_api_key" "UserName") | toToml }}
api_key = {{ includeTemplate "secret.tmpl" (list "openhue_api_key" "Password") | toToml }}
certificate = {{ includeTemplate "secret.tmpl" (list "openhue_api_key" "certificate_pin") | toToml }}
rooms = ["3F - Studio", "2F - Kitchen"]

[plugins.github]
enabled = true
personal_access_token = {{ includeTemplate "secret.tmpl" (list "github_pat_pns_notifications" "Password") | toToml }}
poll_interval = "60s"
webhook_port = 8648

[plugins.presence]
enabled = true
type = "hue"
rooms = ["3F - Studio", "2F - Kitchen", "3F - MBedroom"]
excluded_rooms = []
desk_room = "3F - Studio"
desk_input_max_age = "2m"
poll_interval = "5s"
reading_max_age = "15s"

[plugins.home_presence]
enabled = true
type = "unifi"
url = "https://192.168.1.1"
certificate = {{ includeTemplate "secret.tmpl" (list "unifi_udr_tls_fingerprint" "Password") | toToml }}
device_hostname = "mister"
api_key = {{ includeTemplate "secret.tmpl" (list (printf "unifi_udr_api_key_%s" .chezmoi.hostname) "Password") | toToml }}

[gateway]
enabled = true
service = "pns.gateway"

[delivery]
event_max_age = "168h"
max_retries = 20
remote_deadline = 5
retry_step = "1m"

[delivery_class.default]
route = ""
bypass_mute = false

[delivery_class.health]
route = "priority"
bypass_mute = false

[delivery_class.security]
route = ""
bypass_mute = true

[recap]
replay_card = true
post_window_recap = true
minimum_events = 8
minimum_away = "20m"
nightshift = ["22:00", "06:00"]
morning = ["06:00", "12:00"]
afternoon = ["12:00", "17:00"]
evening = ["17:00", "22:00"]
week_starts_on = "monday"
rows_per_section = 8
pregenerate = []
retain = "720h"

[recap.summarizer]
type = "codex"
command = []
model = "gpt-6-luna"
effort = "low"
deadline = "4m"
transcripts = false
transcript_bytes_per_session = 8192
transcript_bytes_total = 65536
prompt = ""
prompt_file = ""

[recap.sources]
pull_requests = [
  "bash",
  "-c",
  '[[ "$1" == "{"* ]] || gh api graphql -f q="author:@me is:pr is:merged merged:$1..$2" -f query="$3" --jq "$4"',
  "_",
  "{since}",
  "{until}",
  "query($q: String!) { search(query: $q, type: ISSUE, first: 100) { nodes { ... on PullRequest { number title headRefName repository { name } } } } }",
  '.data.search.nodes[] | "#\(.number) \(.repository.name) \(.headRefName) \(.title)"',
]
tasks = [
  "bash",
  "-c",
  'td --no-spinner today --ndjson | jq -r "$1"',
  "_",
  '"p\(5 - .priority) " + (.content | split("\n")[0])',
]
applies = [
  "bash",
  "-c",
  'grep -E "^(head|branch|result|exit_code):" "$HOME/.local/state/chezmoi-apply/latest.apply.log" 2>/dev/null || true',
]

[focus]
enabled = false
modes = []

[quiet]

[quiet.calendar]
enabled = false
type = "command"
command = []
calendars = ["primary"]
poll_interval = "2m"
deadline = "20s"

[profiles]
location_poll = "30s"

[profiles.default]
quiet = false
banner = "all"
discord = "all"
phone = "all"
lights = "all"

[profiles.night]
quiet = true
banner = "none"
discord = "priority"
phone = "priority"
lights = "none"

[profiles.work]
quiet = true
banner = "all"
discord = "priority"
phone = "priority"
lights = "none"

[[profiles.rules]]
profile = "night"
hours = "22:00-06:00"

[[profiles.rules]]
profile = "work"
days = ["Mon", "Tue", "Wed", "Thu", "Fri"]
hours = "09:00-17:00"

[remind]
delay = "5m"

[producer]

[producer.shell]
ignored_commands = ["vim", "nvim", "less", "man", "top", "htop", "btop", "ssh", "fzf", "claude", "clauth", "hermes", "codex", "omp", "pi", "sbs", "sbe", "scm", "start-broccoli-session", "start-claude-with-media-tools", "rustnet", "trip"]
notify_after = "30s"

[waiting]
notify_overdue = true
overdue_after = "1h"

[paths]

[storage]
busy_deadline = "5s"

[failures]
page_enabled = true
page_port = 8646

[lights]
arm_interval = "12s"
dim_window = "22:00-07:00"

[lights.done]
duration = "4s"
brightness_percent = 100

[lights.failed]
duration = "4s"
brightness_percent = 100

[lights.waiting]
duration = "2s"
high_percent = 100
low_percent = 30
lease_expiry = "16h"

[lights.unseen]
duration = "4s"
high_percent = 60
low_percent = 10
arm_after = "5m"

[lights.checks]
duration = "4s"
brightness_percent = 100
pass_color = [0.2725, 0.1283]
fail_color = [0.5562, 0.4084]

[lights.loop]
duration = "4s"
high_percent = 80
low_percent = 10
flare_percent = 100
flare_duration = "200ms"
arm_after = "6m"
lease_expiry = "65m"

[lights.dim]
duration = "3s"
high_percent = 7
low_percent = 1

[lights.lamp."1F - Front door - HCL1"]
behaviours = ["loop", "waiting", "unseen"]
dim_behaviours = ["waiting", "unseen", "loop"]

[lights.lamp."2F - Kitchen - HCD5"]
behaviours = ["checks"]

[lights.lamp."2F - Kitchen - HCD6"]
behaviours = ["loop", "waiting", "unseen"]

[lights.lamp."3F - MBedroom - HCL2"]
behaviours = ["checks"]

[lights.lamp."3F - MBedroom - HCL3"]
behaviours = ["loop", "waiting", "unseen"]

[lights.lamp."3f-studio-cs1"]
behaviours = ["loop", "waiting", "unseen"]

[lights.lamp."3f-studio-cs2"]
behaviours = ["checks"]

[lights.room."2F - Kitchen"]
behaviours = ["done", "failed"]
dim_behaviours = ["waiting", "unseen", "loop", "checks"]

[lights.room."3F - MBedroom"]
behaviours = ["done", "failed"]
dim_behaviours = []

[lights.room."3F - Studio"]
behaviours = ["done", "failed"]
dim_behaviours = ["waiting", "unseen", "loop", "checks"]
{{- end }}
