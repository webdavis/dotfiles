# GENERATED FILE: this is `render`'s own text over the committed
# `dot_config/pns/config-values.toml`, produced by `just pns-config-render`.
# EDIT THE VALUES FILE AND REGENERATE; a hand edit here fails this test.
{{- if eq .chezmoi.os "darwin" }}

# The pns engine's plugin selection, as `pns setup` first wrote it. A
# plugin runs only when its table here says enabled = true, and a key this
# schema does not serve is refused by name at load, which blocks the whole
# file until it is fixed: pns falls back to its built-in roster, every
# secret in here goes unread, and the refusal on stderr names the key.
#
# EVERY SWITCH IS WRITTEN OUT AT ITS OWN DEFAULT, which for a plugin is
# off: a table is on because a line here says so and never because the
# table exists. The banner and the phone card are the core two, and this
# machine arms them. Three of the plugins below are OPT-INS you arm with
# a credential first: hue needs a bridge and key, hermes needs a signed
# route, and the home probe needs a router API key, so arming one
# without its credential would deliver nothing and report a failure.
# Focus, the reminder and the lamp map are separate opt-ins below
# `[plugins]` and need no credential at all. A commented-out block
# below is a feature nothing is set up for yet: fill its values in and
# uncomment it. A plugin names its backend with `type`, and the key is
# required: nothing guesses which implementation a table meant.

# The two routes pns picks for itself, by the name your gateway serves them
# under. Every OTHER route is named by the producer that raised the event,
# and exists for this machine as soon as it has a key below.
[routes]
# Where an event whose producer named no route lands, the return recap
# included. It is also the last path segment of the gateway URL pns
# posts to unless [plugins.log] url names one outright.
default = "pns-events"
# The route reserved for what needs a human now: a machine-health event
# (`pns send --delivery-class health`) whose --state is one somebody has
# to answer, and the stale-block escalation, both take it, whatever it is
# called.
urgent = "priority"

[plugins.phone]
enabled = true
# Which compiled-in backend carries the card. "moshi" is the only one
# today, and a table naming none, or naming one nothing answers, is
# refused out loud rather than read as this one.
type = "moshi"
# Pair with moshi and put the webhook secret it issues here: that pairing
# is what completes the phone card.
device_token = {{ (keepassxc "moshi-hook :: Device Token").Password | toToml }}
# Whether a long command's card still fires while you are watching that
# pane on the phone. OFF: a card describing the pane already filling the
# screen is noise, and the light pulse alone marks the command finishing;
# set true to be carded anyway.
card_while_watching = false
# Where the card is pushed. Left out it is moshi's own webhook endpoint,
# which is what a paired phone answers at; name one to point this
# install at a gateway of your own.
# url = "https://api.getmoshi.app/api/webhook"
# How long pns waits for moshi to acknowledge a submitted permission
# prompt. The harness draws the prompt only once the hook returns, so
# this is time the question is off your screen. On expiry the
# submission is killed and its pending card dies with it, and nothing
# is said either way. There is no off switch: "0s", anything under a
# second and anything past "1h" are refused by name.
ack_deadline = "5s"
# Where `pns tap` writes the phone's attention marker and the presence
# reader looks for it: an absolute path or a ~/ path. Read whether or
# not the card is switched on, and missing config uses this default
# too. Setup guide: pns tap install.
marker_file = "~/.local/state/pns/phone-attention.marker"

# Which card types carry an IMAGE of the whole message, keyed by card type
# and off for every one of them until you name it here. A card type is the
# state word the event carried: `missed` is the card a return raises,
# `failed` a turn that died, `done` one that finished.
#
# WHAT AN IMAGE BUYS: the card's text is cut at 260 characters, and the
# image shows the message whole, wrapped at 60 columns.
#
# WHAT IT COSTS: a moshi card's `data` carries ONE type, so a card with an
# image cannot also carry the deep link that focuses the herdr pane the
# event came from. Turning a card type on trades that link away for every
# card of that type WHICH HAS A PANE. The return card (`missed`) has no
# pane and so no link to lose, which is why it is the example below.
#
# Uploads are capped at 10 an hour by moshi and the links expire after a
# day; a refused upload, a refused card and a message with nothing to draw
# all fall back to the ordinary text card with its link.
#
# THE LINK NEEDS NO CREDENTIAL: anyone who has it can read the whole
# message for that day, so arm a card type only where that is acceptable.
[plugins.phone.image_cards]
# missed = false

# The durable paper trail: every event written where it can be read back
# later. ONE TABLE, so two of them cannot be declared: `type` names the
# transport that carries it, and the credentials for the other one can sit
# here ready so the cutover is that single line.
[plugins.log]
enabled = true
# Which compiled-in transport carries the log. "hermes" posts one signed
# request per event to a hermes route; "discord" posts straight to a
# channel with pns's own bot and no gateway in between. Anything
# else, and a table naming none, is refused out loud at load.
type = "hermes"
# HERMES ONLY: the gateway endpoint. Left out, each route posts to the
# shipped address with that route as its last path segment, so renaming
# a route moves the path and not the gateway. NAMED, this one address
# carries EVERY route verbatim, which is why it is a whole-install
# override rather than the usual way to point at your own gateway.
# url = "http://127.0.0.1:8644/webhooks/pns-events"
# DISCORD ONLY: the bot token, from the Discord application's Bot page.
# Every call carries it as `Authorization: Bot <token>`, and a discord
# log with none posts nothing and says which key is missing.
bot_token = {{ (keepassxc "Discord (Uriel) :: Bot Token (pns)").Password | toToml }}

# HERMES ONLY: one signing key per route, keyed by the route name and each
# prepared in ~/.hermes/config.yaml under that same name. These keys are
# the whole roster: a route named here is a route this machine will post
# to, and one with no key posts nothing and says which key is missing.
[plugins.log.keys]
pns-events = {{ (keepassxc "Hermes :: Webhook Secret (#pns-events)").Password | toToml }}
posture-pages = {{ (keepassxc "Hermes :: Webhook Secret (#posture-pages)").Password | toToml }}
priority = {{ (keepassxc "Hermes :: Webhook Secret (#priority)").Password | toToml }}

# DISCORD ONLY: where a post goes, looked up in this order, first hit wins:
# the route the event named (the urgent route carries anything critical,
# whatever the project), then its repository as `owner/name`, then the
# bare project name, then the default route for an event with no project
# at all, then `default`. The last two are deliberately different
# channels: an unmapped project and no project are two failures, in two
# places to look. `default` is REQUIRED and an armed discord log without
# it is refused at load. A channel id is the number Discord copies from a
# channel's Copy Channel ID, and it is a secret like every other id
# here.
[plugins.log.channels]
default = {{ (keepassxc "Discord (Uriel) :: Channel ID (#github-notifications)").Password | toToml }}
casually-concerned = {{ (keepassxc "Discord (Uriel) :: Channel ID (#casually-concerned-dev)").Password | toToml }}
dotfiles = {{ (keepassxc "Discord (Uriel) :: Channel ID (#dotfiles-dev)").Password | toToml }}
essential-feed-case-study = {{ (keepassxc "Discord (Uriel) :: Channel ID (#essential-feed-case-study-dev)").Password | toToml }}
homelab = {{ (keepassxc "Discord (Uriel) :: Channel ID (#homelab-dev)").Password | toToml }}
justdavis-ansible = {{ (keepassxc "Discord (Uriel) :: Channel ID (#justdavis-ansible-dev)").Password | toToml }}
netpulse = {{ (keepassxc "Discord (Uriel) :: Channel ID (#netpulse-dev)").Password | toToml }}
plantpulse = {{ (keepassxc "Discord (Uriel) :: Channel ID (#plantpulse-dev)").Password | toToml }}
pns = {{ (keepassxc "Discord (Uriel) :: Channel ID (#pns-dev)").Password | toToml }}
pns-events = {{ (keepassxc "Discord (Uriel) :: Channel ID (#pns-events)").Password | toToml }}
posture = {{ (keepassxc "Discord (Uriel) :: Channel ID (#posture-dev)").Password | toToml }}
posture-pages = {{ (keepassxc "Discord (Uriel) :: Channel ID (#posture-pages)").Password | toToml }}
priority = {{ (keepassxc "Discord (Uriel) :: Channel ID (#priority)").Password | toToml }}
scalebar = {{ (keepassxc "Discord (Uriel) :: Channel ID (#scalebar-dev)").Password | toToml }}
uu = {{ (keepassxc "Discord (Uriel) :: Channel ID (#uu-dev)").Password | toToml }}

# The macOS banner, which is what a machine you are sitting at says.
[plugins.banner]
enabled = true
# Which compiled-in surface raises the banner. "macos" is the only one
# today, and a table naming one nothing answers is refused out loud.
type = "macos"
# The terminal a banner click returns to, as a bundle id. Left out, the
# one this process was started from is used, which is right on a machine
# with one terminal; name it where a hook runs under launchd and
# inherits none.
# terminal_bundle_id = "com.mitchellh.ghostty"
# What a click on a DELIVERY FAILURE banner opens: "herdr" splits a pane
# in the running session, "window" opens a new terminal window, and
# "command" runs `click_command` below. Left unset it is inferred: the
# pane when herdr is on PATH, a window when it is not. A click on an
# ordinary banner still focuses the pane its own event came from.
# click_type = "herdr"
# The command `click_type = "command"` runs, with `{id}` replaced by the
# failure's id. A click runs in a bare launchd context with no PATH, so
# every program here needs an absolute path, and the string is split on
# whitespace rather than handed to a shell.
# click_command = ""

# The light pulse: the TRANSPORT alone, which needs the bridge's address,
# a key it issued and the certificate it presents. WHICH lamp shows what,
# and when it runs dimmed, is the `[lights]` policy below.
[plugins.lights]
enabled = true
# Which compiled-in bridge answers. "hue" is the only one today, and a
# table naming one nothing answers is refused out loud.
type = "hue"
bridge_host = {{ (keepassxc "OpenHue :: API Key (hue-bridge-pro)").UserName | toToml }}
api_key = {{ (keepassxc "OpenHue :: API Key (hue-bridge-pro)").Password | toToml }}
# The one certificate the bridge may present, as `sha256:<64 hex>`.
# REQUIRED, and a table with none refuses to pulse rather than
# trusting whatever answers the address: the bridge's certificate
# carries no name any verifier can check, so its own fingerprint is
# the whole of what makes this address the device you meant. Get the
# value from `pns lights enroll`, which prints this line ready to
# paste; it changes only when the bridge hardware does.
certificate = {{ keepassxcAttribute "OpenHue :: API Key (hue-bridge-pro)" "certificate-pin" | toToml }}

# GitHub, polled: which workflow runs, reviews, mentions, releases and
# security alerts finished, read off the notifications API once per
# interval. A SENSOR rather than a destination, so no event routes to
# it; what it finds is submitted through the ordinary producer path and
# lands in the channel [plugins.log.channels] maps the repository
# to, or in its `default` catch-all.
[plugins.github]
enabled = true
# A CLASSIC personal access token with the `notifications` scope and
# nothing else. A fine-grained token cannot call these endpoints at
# all: the documentation states they "only support authentication
# using a personal access token (classic)". `repo` also works and is
# write access to every repository you can reach, which a
# notification source has no business holding. Not your `gh` login:
# pns never reads that, and a daemon whose credentials change when
# you re-authorize a CLI is a daemon nobody decided about.
personal_access_token = {{ (keepassxc "GitHub (Webdavis) :: Personal Access Token (pns notifications)").Password | toToml }}
# How often the poll runs BEFORE the first answer, bounded "60s" to "1h".
# From then on the server's own X-Poll-Interval decides, which the
# documentation asks for by name, so this is only ever the starting
# figure. The floor is 60 because that is what the header says today
# and anything under it is a request to be rate-limited; the knob is
# for polling SLOWER. Each request sends the stored Last-Modified, so
# a quiet minute answers 304 and costs no rate limit at all.
poll_interval = "60s"
# The secret the GitHub App's webhook was created with, which is what
# arms `pns github receive`: the push transport. Naming one here turns
# a delivery into an immediate poll instead of waiting for the next
# tick; naming none leaves the receiver exited and the poll is the
# source either way. It is a SEPARATE value from the token above and
# gets its own vault entry, because the receiver verifies deliveries
# with it and reads no notification of its own. The LaunchAgent only
# reloads when its plist changes, so arming or rotating this value
# needs `launchctl kickstart -k gui/$(id -u)/com.webdavis.pns-github-receiver`.
# webhook_secret = ""
# The loopback port the receiver binds, bounded 1024 to 65535, which
# the Cloudflare tunnel's ingress for the webhook hostname points at.
# LOOPBACK ONLY: the tunnel is the only way in, and a delivery that
# did not arrive through it is refused by its signature anyway.
webhook_port = 8648

# Which room you are in, read off the bridge's per-room motion roll-up so
# the lamp that signals is the one beside you. A SENSOR, not a
# destination: no event routes to it. It reads the bridge through
# [plugins.lights] above, so switching this on with that one off is refused
# by name.
[plugins.presence]
enabled = true
# Which compiled-in backend answers. "hue" is the only one today, and a
# table naming none, or naming one nothing answers, is refused out loud.
type = "hue"
# The rooms a reading may name, spelled the way the bridge spells them. A
# room with no motion sensor or MotionAware area never reports, and an
# empty list watches nothing at all.
rooms = ["3F - Studio", "2F - Kitchen", "3F - MBedroom"]
# Rooms subtracted from the list above: a reading naming one is
# discarded even though rooms names it. A room you pass through, or
# one you never want lit.
excluded_rooms = []
# The room the desk is in, spelled the way the bridge spells it, listed
# in rooms above and not in excluded_rooms. While the keyboard still
# speaks for where you are, this is the room the lamps narrow to, and
# motion in it agrees. Newer motion in ANOTHER room is two live
# readings that cannot both be you, and nothing narrows for as long
# as both stand: a keystroke ends it here, the motion going quiet
# ends it there. Unset, the keyboard names no room and motion answers
# alone, exactly as it does once the desk goes stale.
desk_room = "3F - Studio"
# How long the desk keeps speaking for where you ARE after the last
# keystroke, bounded "1s" to "1h". Inside it a warm desk beats motion
# of the same age, so a cat crossing the kitchen cannot move the lamps
# off a keyboard being typed at; past it a keyboard nobody has touched
# says nothing about which room you are standing in, and fresher
# motion wins. The hour ceiling is what keeps a mistyped digit from
# parking the lamps in desk_room for good.
desk_input_max_age = "2m"
# How often the bridge is read, bounded "2s" to "1m".
poll_interval = "5s"
# How old that read may be before there is no reading at all. A BRIDGE
# THAT STOPPED ANSWERING IS UNKNOWN, never "present" and never "away":
# presence only ever narrows which lamp signals, so not knowing costs
# the narrowing and nothing else. It may not be under poll_interval,
# or every reading would age out before the next read replaced it.
reading_max_age = "15s"

# The home probe: whether the phone is on the home wifi, answered by the
# router's own client list. A SENSOR rather than a destination, so no
# event ever routes to it; `pns doctor` is how it is read.
[plugins.home_presence]
enabled = true
# Which compiled-in backend answers. "unifi" is the only one today, and
# a table naming none, or naming one nothing answers, is refused out loud.
type = "unifi"
url = "https://192.168.1.1"
# The device is named by device_mac, device_hostname or device_ipv4, at
# least one of them; any one matching a client reads home, and on
# disagreement the strongest, in that order, names the match. A phone is
# matched by NAME, because iOS rotates its wifi address; device_mac is
# for a device whose address stays put.
device_hostname = "mister"
# device_mac = ""
# device_ipv4 = ""
api_key = {{ (keepassxc "UniFi :: API Key (dresden-udr)").Password | toToml }}
# The hermes route a stale-identifier alert posts to. UNSET IS THE
# WORKING SETTING: the alert posts to the default route. Naming another
# needs that hermes route prepared first, with the pns signing secret
# and a pns-shaped prompt, or the POST is rejected and the leg is silent.
# alert_route = "priority"

# The clock: what runs BETWEEN events, for the two things that are not
# reactions to one, saying something when nothing happened and keeping a
# lamp alive while an agent loop is. It holds no state of its own, so a
# restart loses nothing and a stopped daemon costs those ambient features
# and never a card. ON UNLESS YOU SAY OTHERWISE, because it delivers
# nothing by itself; deleting the table is the same statement, and
# `pns doctor` says which state it is in.
[gateway]
enabled = true
# The launchd label this machine's clock runs under, which `pns gateway
# start|stop|restart|status` starts, stops, restarts and reports on. NO
# DEFAULT: pns compiles in no label of its own, since it does not know what
# your installation calls its own plist, and every gateway verb refuses
# while this is unset.
service = "com.webdavis.pns-daemon"

# How a delivery that did not land is retried. Exhausted delivery
# retries remain available for operator review.
[delivery]
# Stop retrying once the ORIGINAL EVENT is older than this. An event with no
# recorded creation epoch, or one in the future, never expires.
event_max_age = "168h"
# Retries allowed after the initial send, including interrupted ones. Zero
# permits no retry at all.
max_retries = 20
# How long ONE remote call may take, in seconds, before the caller stops
# waiting on it. Short because a hook or a shell prompt is blocked on it.
# Zero is no deadline at all, which is your instruction rather than a
# default: a wedged gateway then holds that caller for as long as it
# takes.
remote_deadline = 5
# Queued retries wait this step times their retry count. The wait is exact:
# there is no random spread, because one local daemon draining one queue has
# no herd to spread.
retry_step = "1m"

# What each delivery class DOES, one table per class, named by the word
# a producer sends as `--delivery-class` or JSON `delivery_class`.
# `route` is where a message of that class goes when its producer
# named no route of its own, and it is taken only while somebody is
# waiting on the event, so a weekly upgrade that went fine stays on
# the routine route; empty is the routine route at every state.
# `bypass_mute` lets it pass your timed mute and named Focus modes
# for banners and phone cards, and presence and delivery scope still
# decide which surface receives it; muted lights stay off and hermes
# is unchanged. A message naming NO class reads [delivery_class.default],
# and a class no table here defines is refused rather than delivered
# somewhere you did not intend.
[delivery_class.default]
route = ""
bypass_mute = false

# uu sends this on its weekly upgrade run, and pns's own stale-block escalation
# carries it.
[delivery_class.health]
route = "priority"
bypass_mute = false

# posture sends this on a security finding. It names its own route, so this
# table adds the one thing posture cannot: crossing a mute.
[delivery_class.security]
route = ""
bypass_mute = true

# The return recap: what you missed while you were away. THE UNCOMMENTED
# LINES ARE THE DEFAULTS, written out so they can be seen; each switch
# gates only its own delivery, and deleting the whole table gets exactly
# the same behaviour.
[recap]
# The catch-up card: the misses queued while you were away, put in front
# of you on the first event you are present for. Off never cards from
# the journal; the misses stay recorded whatever this says, so switching
# the card back on has something to deliver.
replay_card = true
# The recap of the whole window posted to hermes, rendered and posted
# by a second process that nothing waits for. Off records the window
# just the same; only the posting stops.
post_window_recap = true
# How many events a window needs before it is worth a recap rather than
# the catch-up card alone. Every recap's header prints the window's real
# count, which is how the number gets settled. One is the floor and
# means any activity at all; zero is refused.
minimum_events = 8
# The command that turns the window into the night-in-order lines:
# ARGV, NEVER A SHELL STRING, handed the timeline on stdin and answering
# on stdout. UNSET IS A WORKING SETTING and posts the plain mechanical
# list, and so does a summarizer that fails, is missing, says nothing
# or runs long, which the list's own heading says. THE THREE OLLAMA
# FLAGS ARE NOT OPTIONAL: without them `ollama run` interleaves terminal
# control bytes and a preamble into its output, posted verbatim.
# summarizer = ["ollama", "run", "qwen3.5:4b", "--think=false", "--hidethinking", "--nowordwrap"]
# How long that command may take before it is killed and the plain list
# is posted instead. It is the whole recap's budget rather than each
# question's, and AN HOUR IS THE CEILING: a longer one is refused by
# name. It also bounds the turn summarizer that writes each
# notification's sentence, which takes at most thirty seconds of it
# because a Stop hook is waiting on that one.
summarizer_deadline = "4m"
# The repositories whose merged pull requests become the recap's "what
# it does now" section. UNSET IS THE WORKING SETTING and it is a fence:
# with no repo named, no `gh` process is started at all. Named, the recap
# runs one read-only `gh pr list` per repo, bounded in count and in time,
# over the window alone; it never touches a token, and `gh`'s own login is
# what authorizes it. Each line carries the pull request number it came
# from, and a line that cannot be traced back to one pns actually fetched
# is dropped rather than posted. A `gh` that is missing, refuses or runs
# long costs this section and nothing else. `gh` IS FOUND ON PATH, and the
# PATH is the one the event that started the recap was handed: a hook
# environment without /opt/homebrew/bin reads `gh` as permanently
# unavailable, and the section says so on every window until the harness's
# own PATH carries it.
# repositories = ["owner/name"]
# The review notes whose findings become the recap's "caught by review"
# section: ONE directory, named in full, and a file name that may hold
# one `*`. A relative path and a `*` in a directory are both refused,
# because this pattern is the whole of what pns is allowed to open. Only
# files whose own clock falls inside the window are read, so a note you
# had already seen before you left is not news. UNSET IS THE WORKING
# SETTING and, as with `repositories`, unset means the directory is never
# opened. Twenty-five notes is what one recap considers, NEWEST FIRST,
# and a window holding more says "at least" in its own count rather than
# printing a total it cannot back; a matched note that will not open is
# named as one that could not be read rather than left out.
# review_notes_glob = "/absolute/path/notes-*.md"
# How long pns keeps one row of the activity store, the durable table of
# harness hook events the recap reads. The gateway prunes anything older
# on its own tick, so a shorter value takes effect without a restart.
# THIRTY DAYS, SPELLED IN HOURS because a duration is <count><ms|s|m|h>
# and a day is not one of the units. An hour is the floor and a year the
# ceiling; zero is refused by name, because this store has no off switch
# and a retention of nothing would empty it on the next tick.
retain = "720h"

# The macOS Focus modes that pns reads as your own instruction not to be
# interrupted. While one of them is active, banners, cards and light
# pulses are held back and handed over when it ends. Approvals and the
# durable log are unchanged. [delivery] classes can exempt banners and
# phone cards. A Focus name matches however you capitalised
# it, a mode's raw modeIdentifier works too, and an empty entry is refused
# by name. An unreadable Focus store reads as no Focus, never as silence.
# NAMING NO MODE SILENCES NOTHING, which is the same statement as no
# table at all; `enabled = false` keeps the list and stops it being read.
# [focus]
# enabled = true
# modes = ["Sleep"]

# The mute, `pns mute <duration>`, and what else may switch it.
[quiet]

# Quiet that follows your calendar: while an event marked busy is on, the
# mute is on, and it ends when the event does. WHAT YOU TYPE ALWAYS WINS:
# a mute you set by hand is never shortened or cleared by this, and quiet
# you switch off during a meeting stays off for the rest of it.
# `type` PICKS THE READER. Under "command" the calendar is whatever
# `command` reads: it is run read-only on the interval below, handed no
# input, and must answer on stdout with
# {"events": [{"start": <epoch>, "end": <epoch>, "busy": <true|false>}]},
# every event in the next hour or so, busy or not: pns picks the busy ones.
# Under "google" pns asks Google Calendar for the next hour of busy
# intervals itself, over the calendars named below, with the three
# credentials below. A poll that fails, answers something else or runs
# long changes nothing at all, and a mute already set stands until its
# own expiry.
[quiet.calendar]
enabled = false
# Which reader answers: "command" or "google".
type = "command"
# `type = "command"` only. ARGV, NEVER A SHELL STRING. It is your own
# command: pns names no calendar and holds no credential of one.
command = ["/Users/stephen/.local/libexec/pns/calendar-busy-window.sh"]
# `type = "google"` only. The calendar ids read, as one union.
calendars = ["primary"]
# `type = "google"` only, and all three are required together: the
# OAuth client and the refresh token minted for it. They travel into
# a request body and never into a log line.
# client_id = "<oauth client id>"
# client_secret = "<oauth client secret>"
# refresh_token = "<oauth refresh token>"
# How often it is asked, bounded "30s" to "30m".
poll_interval = "2m"
# How long one run may take before it is killed and the poll leaves
# everything as it was, bounded "1s" to "30s".
deadline = "20s"

# The reminder: one more card when an approval has been sitting unanswered.
# IT IS A STATEMENT AND NEVER A SECOND PROMPT, so the card raised when the
# prompt appeared is still the one carrying Allow and Deny. It needs the
# daemon running and the PostToolBatch hook entry that tells pns an
# approval was dealt with; without that entry the only clearing signal
# is the end of the turn. It respects every mute the first card respects,
# a `pns mute`, a Focus, the quiet window, and a reminder held back is
# LOST rather than queued. Several approvals waiting are one card rather
# than several, each approval is reminded about at most once, and a card
# counts every approval outstanding at that moment, so a fresh one can be
# named early and is then done. The signal is the tool batch RESOLVING
# rather than your answer, so a tool approved at once that then runs
# longer than this is reminded about anyway; if that bites, raise the
# number. THIRTY SECONDS IS THE FLOOR AND AN HOUR THE CEILING, anything
# outside is refused by name, "0s" included: leaving the key out is the
# one way to say the reminder is off.
[remind]
delay = "5m"

# What one producer asked for, one table per producer, keyed by the name it
# sends (`--producer`, or PNS_PRODUCER). Replace <name> with that name.
# THE REMINDER IS SWITCHED ON BY THE CALL, NEVER BY THE NAME: a harness
# that sends an answered signal passes `--remind` on its own approval hook,
# and that flag beats whatever this table says. This is here for a producer
# you cannot pass a flag to. It needs `[remind] delay` above; with no delay
# set, `remind = true` is still the reminder off.
# [producer.<name>]
# remind = true

# The OTHER end of the same wait: how long a session stays blocked before
# ONE page about it goes out, to the route reserved for things that need
# a human. It fires once per block and then says nothing until that block
# resolves, and only when you could act on it: nothing is sent while you
# are away from both the desk and the phone, or while the screen has been
# locked for the whole window, because a page nobody can answer is how
# the route reserved for the ones you must answer stops being read. A
# screen locked for PART of the window still pages, which is the case
# this exists for: you were here, you stepped away, and a session is
# stuck. It needs the daemon running. A MINUTE IS THE FLOOR AND A DAY THE
# CEILING, anything outside is refused by name, "0s" included: the window
# is not the switch, `enabled` is.
[stale]
enabled = true
escalate_after = "1h"
# Where that page goes. Unset sends it to `[routes] urgent`, which is
# what every other page pns raises for itself takes.
# route = "priority"

# Where this install keeps its own files. Left out, state lives under
# ~/.local/state/pns and the native channels are used directly. Each is
# an absolute path or a ~/ path.
# [paths]
# The ledger, the markers and the spooled jobs. Moving it leaves
# whatever is in the old directory where it is.
# state_dir = "~/.local/state/pns"
# A directory of channel executables. NAMING IT AT ALL FORCES every
# channel through an executable of its own name in here instead of the
# compiled-in one, which is what makes it a testing seam rather than a
# place to point at the usual location.
# channels_dir = "~/.local/libexec/pns/channels"

# The state database. One number: how long a write waits for the lock
# another writer holds before the write is refused. It bounds a WEDGED
# writer and measures nothing else: every transaction pns makes is a
# handful of short statements with no network and no sleep in it, and a
# writer that dies drops its lock with its process, so a wait that
# expires is a machine in trouble rather than a busy one. A hook you are
# waiting on pays this bound per lock it takes, which is why the ceiling
# is a minute; ten milliseconds is the floor, anything outside is refused
# by name, and "0s" refuses a contended write the instant it is
# contended instead of waiting at all.
[storage]
busy_deadline = "5s"

# The failure page: the same record `pns failures` prints, served over
# loopback so moshi's browser preview can read it from your phone. The
# listener binds 127.0.0.1 only, because the per-session SSH forward is
# the trust boundary and nothing needs to be reachable from anywhere
# else. moshi-hook finds it by probing local ports and remembering the
# ones that answer, so nothing registers itself; an operator with a
# narrowed scan-ports list adds this number to it. Two limits pns cannot
# detect and does not pretend to: browser preview needs a moshi Pro
# subscription, and the tunnel exists only while a terminal session is
# open. page_enabled = false is the fallback for either, and it costs nothing
# else: the notification stands alone, Discord still carries the full
# form whenever the hermes leg worked, and `pns failures` is unchanged.
[failures]
page_enabled = true
page_port = 8646

# The lamp map: WHICH LAMP says what. A declaration names a place at one
# of three levels, `[lights.lamp."<name>"]`, `[lights.room."<name>"]` or
# `[lights.zone."<name>"]`, spelled as the bridge spells it, and says
# which of the six behaviours it carries: `done`, `failed` and `checks`
# blink, and `blocked`, `unseen` and `loop` breathe while their condition
# lasts. The most specific declaration naming a lamp wins, lamp over room
# over zone, and levels never merge; each question resolves on its own,
# so a lamp can state its behaviours and still inherit its room's dim
# window. On one lamp the held states rank blocked, loop, then unseen,
# and a held state preempts a blink on the lamp holding it. `unseen` is
# one word carrying two colours, one for a run that finished and red for
# one that died; a lamp carries both or neither, and `checks` is the
# second such word (see `[lights.checks]` below). An unknown key at any
# level, and a behaviour word outside the six, are refused by name.
#
# `[lights]` IS INERT UNLESS `[plugins.lights] enabled` IS TRUE: hue is the
# transport and this is the policy. WITH NO TABLE AT ALL the pulse reaches
# the plugin's own default rooms and nothing else; uncommenting `[lights]`
# with no declaration replaces that pulse with an empty lamp map, so name a
# place before you do. Switching hue off while a lamp is held leaves that lamp
# to the wall switch, since putting it out takes a bridge.
[lights]
# How often the daemon re-arms the lamps, bounded "10s" to "30s". It is
# also the breath budget: a breathing lamp is faded by the tick itself,
# seamlessly, across the whole interval, so this decides how many fades
# fit between two ticks. The floor is one bridge call, so a tick cannot
# start while the last one is still dialling; the ceiling is what the
# daemon derives a tick's own lifetime from, and an interval past it
# would be a breath cut off part way through.
arm_interval = "12s"
# THE HOUSE DIM WINDOW, and the only one in the vocabulary: local wall
# clock, the start inclusive and the end exclusive, and it may wrap
# midnight. Every place below that states no `dim_window` of its own
# runs this one, and a place that states one overrides it for that
# place alone. A bare `pns lights mute <place>` mutes until this
# window ends and is refused when none is set.
dim_window = "22:00-07:00"

# The five behaviour shapes. Every number below was set on a real lamp;
# only the knobs that APPLY to a behaviour exist, so a blink has a
# duration and one brightness and a breath has a duration and two ends.
# A `duration` is a fade, bounded "200ms" to "5s"; a `_percent` key is 1
# to 100.
[lights.done]
duration = "4s"
brightness_percent = 100

[lights.failed]
duration = "4s"
brightness_percent = 100

[lights.blocked]
duration = "2s"
high_percent = 100
low_percent = 30
# How long an unanswered wait may hold the lamp before the daemon gives
# up on an abandoned session. This is a BACKSTOP: the locked behaviour
# is the blocked lamp breathing, continuous until you answer, and the
# ordinary end is your session's next event, whatever the hour. "16h"
# outlasts a long day away and still gives the lamp back before the next
# one starts. It is bounded "1m" to "168h" (a week), since an abandoned
# wait can span a weekend away.
lease_expiry = "16h"

[lights.unseen]
duration = "4s"
high_percent = 60
low_percent = 10
# How old a FINISHED run must be before its lamp arms, bounded "0s" to
# "24h". A run that DIED has no such delay and no knob. "0s" arms at
# once.
arm_after = "5m"

# The one behaviour that carries its own COLOURS: a GitHub event, purple
# for a pass and orange for a failure, as CIE xy `[x, y]` pairs (which is
# what the bridge takes; a hex colour would be clamped into its gamut and
# desaturated). One brightness for both, as `unseen` has.
#
# THE PAIR IS CHOSEN FOR A LAMP OF ITS OWN. Give `checks` a lamp whose
# `behaviours` names nothing else: the purple sits close enough to the blocked
# magenta, and the orange close enough to the unseen daylight, that a lamp
# carrying either alongside it cannot be told apart across a room.
[lights.checks]
duration = "4s"
brightness_percent = 100
pass_color = [0.2725, 0.1283]
fail_color = [0.5562, 0.4084]

# A live pane lease keeps the summarizer's guessed waits from arming
# blocked; real hook waits still take priority.
[lights.loop]
duration = "4s"
high_percent = 80
low_percent = 10
# The accent at the peak, which is the one shape that has one: the lamp
# rises to `high_percent`, flashes to `flare_percent` for
# `flare_duration`, then falls back to `low_percent`. The flash must be
# brighter than `high_percent` and briefer than `duration`.
flare_percent = 100
flare_duration = "200ms"
# How long work must run continuously before the lamp arms itself, bounded
# "1s" to "24h". Both an agent herdr calls working and a tracked shell
# command count.
arm_after = "6m"
# How long a lease taken by `pns loop begin` survives with nothing
# renewing it, bounded "1m" to "24h". The pane's own hook traffic
# renews it.
lease_expiry = "65m"

# The DIM FORM: one shape, shared by every behaviour that runs dimmed, at
# the faintest levels the hardware has. A dimmed BLINK fires at
# `low_percent`, since a blink has no low end to fade to.
[lights.dim]
duration = "3s"
high_percent = 7
low_percent = 1

# The routing. `dim_window` is local wall clock, the start inclusive and
# the end exclusive, and it may wrap midnight; `dim_behaviours` names
# which behaviours run their dim form inside it, and everything else that
# place carries is SUPPRESSED there. A window with an empty list therefore
# takes every behaviour away for the night and needs no mode of its own.
# A place that states neither key runs `[lights] dim_window` above with
# nothing dimmed; one that states `dim_behaviours` alone runs them inside
# that same window.
[lights.lamp."1F - Front door - HCL1"]
behaviours = ["loop", "blocked", "unseen"]
dim_behaviours = ["blocked", "unseen", "loop"]

[lights.lamp."2F - Kitchen - HCD5"]
behaviours = ["checks"]

[lights.lamp."2F - Kitchen - HCD6"]
behaviours = ["loop", "blocked", "unseen"]

[lights.lamp."3F - MBedroom - HCL2"]
behaviours = ["checks"]

[lights.lamp."3F - MBedroom - HCL3"]
behaviours = ["loop", "blocked", "unseen"]

[lights.lamp."3F - Studio - HCL2"]
behaviours = ["checks"]

[lights.lamp."3F - Studio - HCL3"]
behaviours = ["loop", "blocked", "unseen"]

[lights.room."2F - Kitchen"]
behaviours = ["done", "failed"]
dim_behaviours = ["blocked", "unseen", "loop", "checks"]

[lights.room."3F - MBedroom"]
behaviours = ["done", "failed"]
dim_behaviours = []

[lights.room."3F - Studio"]
behaviours = ["done", "failed"]
dim_behaviours = ["blocked", "unseen", "loop", "checks"]

# ONE MORE MUTE, TYPED RATHER THAN CONFIGURED, and it is LIGHTS ONLY:
#
#   pns lights mute "3F - Studio" 2h   mute that place's lamps for two hours
#   pns lights mute "3F - Studio"      mute them until the dim window ends
#   pns lights mute "3F - Studio" off  loud again
#   pns lights mute                    what is muted right now
#
# It silences EVERY behaviour on the target and reaches the lamps of one
# lamp, room or zone and nothing else: cards, banners and the durable log
# carry on, and `pns mute`, which mutes all of them, is a different
# command with a different file that neither reads. A bare mute reads
# `[lights] dim_window` as the schedule and is refused when none is set;
# an explicit duration is the same 1s to 24h `pns mute` takes. A state file
# nobody can parse mutes EVERY lamp and says so: dark is the fail direction
# on a lamp path. THE NAMES IT TAKES ARE EVERY LAMP, ROOM AND ZONE, whether
# a declaration above writes it or the bridge merely holds it, and a name
# neither knows is refused with the list of the ones that work.
{{- end }}
