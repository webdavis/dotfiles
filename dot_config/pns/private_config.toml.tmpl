# The pns engine's plugin selection. THE FILE SELECTS: a plugin runs only
# when its table here says enabled = true, and this file existing is what
# moves the light pulse from the retired bash channel to `pns pulse`.
{{- if eq .chezmoi.os "darwin" }}

[plugins.moshi]
enabled = true
# Whether a long command's card still fires while you are watching that pane
# on the phone. OFF by operator ruling 2026-08-12: a card describing the pane
# already filling the screen is noise, and the light pulse alone marks the
# command finishing. Uncomment to be carded anyway.
# mobile_watch_card = false

[plugins.hermes]
enabled = true

[plugins.macos-banner]
enabled = true

[plugins.hue]
enabled = true
bridge = "{{ (keepassxc "OpenHue :: API Key (hue-bridge-pro)").UserName }}"
key = "{{ (keepassxc "OpenHue :: API Key (hue-bridge-pro)").Password }}"
rooms = ["3F - Studio", "2F - Kitchen"]
{{- end }}
