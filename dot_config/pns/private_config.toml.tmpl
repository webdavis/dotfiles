# The pns engine's plugin selection. THE FILE SELECTS: a plugin runs only
# when its table here says enabled = true, and this file existing is what
# moves the light pulse from the retired bash channel to `pns pulse`.
{{- if eq .chezmoi.os "darwin" }}

# The return recap's three delivery switches, each gating only its own
# delivery. ABSENT IS ALL ON, so a machine with this block left commented
# behaves exactly as it did before the table existed; a misspelled key or a
# non-boolean value is refused by name rather than half-read. NOT A PLUGIN, so
# it sits at the top level beside `[plugins]` rather than under it.
# [recap]
# The catch-up card: the misses queued while you were away, put in front of you
# on the first event you are present for. Off never cards from the journal; the
# misses stay recorded whatever this says, the newest 25 of them, so switching
# the card back on has something to deliver.
# replay_card = true
# The recap of the whole window posted to Discord: the header, what still needs
# you, the night in order, and where the full text lives. It is rendered and
# posted by a SECOND pns process the return event starts and never waits for, so
# nothing it does can slow the prompt you are standing at. Off records the window
# just the same; only the posting stops.
# digest = true
# Whether that recap posts to the `pns-recap` route rather than to the default
# one. THE ROUTE MUST EXIST IN HERMES FIRST, prepared with the pns signing secret
# (`[plugins.hermes] key` below) and a prompt of bare `{detail}`, so the recap's
# own header stays the message's first line. Two shapes work and the difference
# is only where the thread comes from: point the route's chat_id at a Discord
# FORUM channel and every window opens its own thread, auto-titled from that
# first line ("While you were away, 23:04-06:15 · 37 events"); or give the route
# a static thread_id inside #pns and every window lands in one long-lived thread
# there. The forum gives a title per window, the static thread keeps everything
# in #pns; pns posts the same message either way. A route that refuses the post
# is not silent: the recap goes to the default route instead, carrying one line
# saying why it landed there.
# digest_as_thread = true
# How many events a window needs before it is worth a recap rather than the
# catch-up card alone. THE CALIBRATION KNOB: eight is a starting guess, every
# recap's header prints the window's real count, and a week of them settles the
# number without a rebuild. The window runs from the last event you were present
# for to now, so a continuous stretch at the desk never reaches this. One is the
# floor and means "any activity at all"; zero is refused, because it would recap
# every single event, including one over a window where nothing happened.
# min_events = 8

[plugins.moshi]
enabled = true
token = "{{ (keepassxc "Moshi :: Webhook Secret").Password }}"
# Whether a long command's card still fires while you are watching that pane
# on the phone. OFF by operator ruling 2026-08-12: a card describing the pane
# already filling the screen is noise, and the light pulse alone marks the
# command finishing. Uncomment to be carded anyway.
# mobile_watch_card = false

[plugins.hermes]
enabled = true
key = "{{ (keepassxc "Hermes :: Webhook Secret :: #pns").Password }}"

[plugins.macos-banner]
enabled = true

[plugins.hue]
enabled = true
bridge = "{{ (keepassxc "OpenHue :: API Key (hue-bridge-pro)").UserName }}"
key = "{{ (keepassxc "OpenHue :: API Key (hue-bridge-pro)").Password }}"
rooms = ["3F - Studio", "2F - Kitchen"]
# The hours the rooms stay dark: local wall clock, the start inclusive and the
# end exclusive, and it may wrap midnight. ONLY the lights are quieted; cards,
# banners and the log still fire at every hour, and a hand-run `pns pulse` is
# exempt so a bridge and key can be checked while the window is on.
# quiet_hours = "22:00-07:00"

# The home probe: is the phone on the home wifi, answered by the UDR's client
# list. A SENSOR rather than a channel, so it is selected here like any plugin
# and no event can ever route to it; `pns home` is how it is read and drilled,
# and the catch-up and quiet-window slices are what will spend the reading.
# THE DEVICE is named by up to three keys, `device_mac`, `device_hostname` and
# `device_ipv4`; at least one is required, any one of them matching a client
# reads home, and on disagreement the strongest (that order) names the match.
# The phone is matched by NAME because iOS private wifi addresses make its MAC
# rotate per network; `device_mac` is the key for a device whose MAC is stable.
# `brand` names which compiled-in backend answers; "unifi" is the only one
# today, and an unknown brand is refused out loud.
[plugins.router]
enabled = true
brand = "unifi"
router_url = "https://192.168.1.1"
device_hostname = "mister"
api_key = "{{ (keepassxc "UniFi :: API Key (dresden-udr)").Password }}"
# The hermes route a stale-identifier alert posts to. UNSET IS THE WORKING
# SETTING: the alert posts to the default route (`/webhooks/pns`), which is the
# one route that both verifies against the key pns signs with (`[plugins.hermes]
# key`) and renders the body pns sends (`{agent} · {state} · {project}` over
# `{detail}`). Naming another route needs that hermes route prepared first, with
# the pns signing secret and a pns-shaped prompt, or the POST is rejected and the
# leg is silent, so nothing says the alert never landed. That is an operator
# decision, not a default.
# stale_alert_channel = "priority"
{{- end }}
