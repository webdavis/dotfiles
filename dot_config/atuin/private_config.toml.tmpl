search_mode = "fuzzy"
filter_mode = "host"
filter_mode_shell_up_key_binding = "session"
style = "compact"
enter_accept = true
secrets_filter = true

history_filter = [
  {{ (keepassxc "Dotfiles (bashrc) :: HISTIGNORE Regex").Password | quote }},
]

[sync]
auto_sync = false
records = true

[ai]
# When on, every new shell asks for an Atuin Hub login.
enabled = false

[daemon]
enabled = true
# A LaunchAgent starts the daemon, so shell startup leaves it alone.
autostart = false
