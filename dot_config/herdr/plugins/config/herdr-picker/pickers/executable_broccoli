#!/usr/bin/env python3
import json
import sys
from pathlib import Path

sys.dont_write_bytecode = True
sys.path.insert(0, str(Path(__file__).resolve().parent / "lib"))

from broccoli.access import NotConfigured
from broccoli.steps import STEPS
from rows import notice


def main():
    name, *arguments = sys.argv[1:] or ["menu"]
    try:
        for made in STEPS[name](*arguments):
            print(json.dumps(made, ensure_ascii=False), flush=True)
    except NotConfigured as unset:
        for made in unset.rows:
            print(json.dumps(made, ensure_ascii=False), flush=True)
    except Exception as failure:  # noqa: BLE001
        notice(str(failure) or type(failure).__name__)


main()
