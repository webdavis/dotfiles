# Loads the first Bash on PATH as Ghostty's default shell. For this to work,
# a newer Bash must come earlier on PATH than the system one.
command = "/usr/bin/env bash -i"

font-family   = Menlo
font-size     = 13
font-thicken  = true
font-feature  = -liga

# One theme keeps the quick terminal dark while macOS is in Dark mode.
theme             = "GitHub Dark Dimmed"
link-url          = true
link-previews     = true
cursor-style      = block
window-colorspace = "display-p3"

# Keeps the quick terminal hotkey working with no windows open.
quit-after-last-window-closed = false

quick-terminal-position = top
quick-terminal-size = 55%,85%
quick-terminal-animation-duration = 0.05

# Karabiner sends Cmd+Ctrl+F19 for Hyper+comma, which macOS keeps for sysdiagnose.
# F19 keeps espanso from seeing commas that would fire its `,,` triggers.
keybind = global:ctrl+super+f19=toggle_quick_terminal

clipboard-read = ask
clipboard-paste-protection = true
shell-integration-features = cursor,sudo,title
window-padding-x = 4
window-padding-y = 2
