# ┏━━━━━━━━━━━━━━━━━━━━━━━━━━━━━┓
# ┃    Ghostty Configuration    ┃
# ┗━━━━━━━━━━━━━━━━━━━━━━━━━━━━━┛

# Config Paths
# =============
#
#  → System Config: ~/Library/Application Support/com.mitchellh.ghostty/config
#  ----------------------------------------------------------------------------
#
#  → User Config:   $XDG_CONFIG_HOME/.config/ghostty/config (a.k.a. ~/.config/ghostty/config)
#  -------------------------------------------------------------------------------------------

# ⚠ Note
# =============
# The System Config always overrides the User Config. To use your User Config, delete
# the System Config with the following command:
#
#   $ rm ~/Library/Application\ Support/com.mitchellh.ghostty/config
#   -----------------------------------------------------------------

# Launch Bash via /usr/bin/env to ensure:
# 1. Ghostty picks the first `bash` in the PATH (so Homebrew Bash is used if present).
# 2. Ghostty's environment variables, like GHOSTTY_RESOURCES_DIR, are preserved.
# 3. The -i flag runs Bash interactively, sourcing ~/.bashrc for PATH changes,
#    aliases, completions, and shell integration.
#
# We use /usr/bin/env instead of a direct path to ensure Ghostty's shell integration
# works correctly. Ghostty sets environment variables (e.g., GHOSTTY_RESOURCES_DIR)
# that must exist before Bash starts. This approach preserves those variables and
# is recommended in the discussion below.
# Discussion: https://github.com/ghostty-org/ghostty/discussions/7931#discussioncomment-13746978
# Ghostty `command` ref: https://ghostty.org/docs/config/reference#command
command = "/usr/bin/env bash -i"

# Font
# =============
font-family   = Menlo
font-size     = 13
font-thicken  = true
font-feature  = -liga

# Appearance
# =============
theme             = "dark:GitHub Dark Dimmed,light:GitHub Light Default"
link-url          = true
link-previews     = true
cursor-style      = block
window-colorspace = "display-p3"
# window-padding-x = 2 # Optional padding (uncomment to enable)

# Behavior
# =============
# Stay running with no windows so the quick terminal hotkey keeps working.
# Cmd+Q still quits.
quit-after-last-window-closed = false

# Quick terminal: drops from the top, 40% tall. A fixed width is about 40%
# of the LG (3008 wide) and 70% of the MacBook (1710 wide).
quick-terminal-position = top
quick-terminal-size = 40%,1200px

# Keybindings
# =============
# Hyper+comma: Karabiner turns it into Cmd+Ctrl+comma, because macOS reserves
# Hyper+comma for its sysdiagnose viewer.
keybind = global:ctrl+super+comma=toggle_quick_terminal
# Cmd+1..9 reach herdr, which switches its own tabs with them.
keybind = super+physical:one=unbind
keybind = super+physical:two=unbind
keybind = super+physical:three=unbind
keybind = super+physical:four=unbind
keybind = super+physical:five=unbind
keybind = super+physical:six=unbind
keybind = super+physical:seven=unbind
keybind = super+physical:eight=unbind
keybind = super+physical:nine=unbind

# Security & UX (v2)
# =============
clipboard-read = ask
clipboard-paste-protection = true
shell-integration-features = cursor,sudo,title
window-padding-x = 4
window-padding-y = 2
