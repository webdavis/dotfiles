# posture's notify choice: how one security page reaches the operator.
#
# posture knows nothing about any particular notification engine. It either
# signs the page itself and posts it to a hermes webhook route, or it hands the
# page to a command on that command's standard input and reads the answer back,
# or nothing leaves the machine and the page is raised on the local banner
# alone. The second mode is the producer API: one JSON request in, one JSON
# result plus an exit code out. Any program may serve it.
#
# Every key is written out below at its default, so nothing has to be looked up
# to change it, and switching modes is a one-word edit to `mode`.
#
# An unknown key, an unknown table or an unknown mode is refused BY NAME at
# load. A typo therefore blocks the whole file rather than quietly switching
# notification off, which is the trade: the loud half is a named refusal plus a
# local banner per page, and the quiet half it replaces is a security pipeline
# that silently stops paging.

[notify]
# THIS MACHINE'S OWN CHOICE, not a requirement of the tool: posture signs each
# page with the key for the route that page is going to, and posts it itself.
#
# The three modes are `hermes`, `command` and `off`. `command` is NOT what this
# machine uses. pns commits its ledger before it tries any destination, so a
# critical page bound for `priority` that the gateway refuses comes back to
# posture as an acceptance: the cursor advances and the finding is gone from
# both channels. Posting the page here is what makes posture read the gateway's
# own answer. Switch to `mode = "command"` once the engine named below reports
# the destination's answer rather than its own ledger.
#
# `off` turns off DELIVERY, not the page: nothing leaves the machine and every
# finding is raised on the local banner instead. It is the mode for a machine
# with no gateway and no engine, never a way to stop being told.
mode = "hermes"

# The command a page is handed to, and its arguments, passed verbatim. The
# contract says nothing about the arguments: an engine spells its own submit
# path however it likes.
[notify.command]
path = "{{ joinPath .chezmoi.homeDir .rust_tools.install_dir "pns" }}"
arguments = ["submit", "--json"]

# The mode selected above. `url` is the gateway's webhook base, one path
# segment above the route: a page for the `posture-pages` route is posted to
# `<url>/posture-pages`. A route the gateway does not serve answers 404, which
# is a failed delivery and a local banner, never a page reported as delivered.
[notify.hermes]
url = "http://127.0.0.1:8644/webhooks"

# ONE KEY PER ROUTE. The gateway reads each route's secret as a literal, so a
# page signed with another route's key answers 401 and vanishes. A route this
# file holds no key for refuses the page and raises the local banner rather
# than reporting a delivery that never happened.
#
# `posture-pages` carries every page below critical; `priority` carries a
# critical security finding, which is what the operator reserved that channel
# for (machine health and security only, 2026-09-14).
[notify.hermes.keys]
posture-pages = {{ (keepassxc "Hermes :: Webhook Secret (#posture-pages)").Password | toToml }}
priority = {{ (keepassxc "Hermes :: Webhook Secret (#priority)").Password | toToml }}
