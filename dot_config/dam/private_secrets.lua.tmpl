return {
  schema = 1,
  remote = {
    todoist = { api_token = {{ includeTemplate "secret.tmpl" (list "todoist_api_token" "Password") | quote }} },
  },
  token = {
    vpt = {
      value = {{ includeTemplate "secret.tmpl" (list "damnit_token_vpt" "Password") | quote }},
      grant = {
        { allow = { "task:create", "task:change", "task:read" }, own = true },
      },
    },
  },
}
