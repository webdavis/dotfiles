schema = 1

[remote.todoist]
url = "todoist::"
credentials = ["api_token"]
api_token = {{ (keepassxc "todoist-api-token").Password | quote }}
stale = "15m"
deadline = "60s"

[token.vpt]
value = {{ (keepassxc "damnit-token-vpt").Password | quote }}

[[token.vpt.grant]]
allow = ["task:create", "task:change", "task:read"]
own = true
